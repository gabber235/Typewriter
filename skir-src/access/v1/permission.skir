import { Duration } from "kernel/v1/duration.skir";
import { RecordId } from "kernel/v1/record_id.skir";

// Access policy boundary for NATS identities. The auth callout validates the presented JWT, then
// delegates entity specific publish and subscribe policy to the permission service. That service
// owns the policy and returns the result for inclusion in signed NATS user claims.
enum EntityPermissionQualifier {
  user: struct {
    organization_id: RecordId?;
    connection_session: string;
  };
  service: struct {};
}

struct Permission {
  allow: [string];
  deny: [string];
}

struct ResponsePermission {
  max_messages: int32?;
  ttl: Duration?;
}

// Policy output owned by the permission service. The auth callout converts this result into NATS
// permissions and preserves its tags when it signs the authenticated identity.
struct Permissions {
  publish: Permission;
  subscribe: Permission;
  response: ResponsePermission?;
}

// Internal authenticated resolution between the auth callout and the permission service. The
// callout invokes it after JWT validation and supplies serialized claims plus an entity qualifier;
// the permission service resolves user and service policy, including dependent organization or
// service data, and returns permissions and tags. Resolution errors propagate instead of becoming
// an authorization grant.
method GetEntityPermission(
  struct {
    qualifier: EntityPermissionQualifier;
    jwt_claims: bytes;
  }
): struct {
  permissions: Permissions;
  tags: [string];
} = 209684;
