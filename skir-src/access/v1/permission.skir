import { Duration } from "kernel/v1/duration.skir";

// Who is asking for permission?
enum EntityPermissionQualifier {
  user: struct {
    organization_id: string?;
  };
  service: struct {};
}

struct Permission {
  allow: [string];
  deny: [string];
}

struct ResponsePermission {
  max_messages: int32?;
  ttl: Duration?;
}

struct Permissions {
  publish: Permission;
  subscribe: Permission;
  response: ResponsePermission?;
}

// Internal method between the auth-callout and the permission service to determine
// the permissions of a entity.
method GetEntityPermission(
  struct {
    qualifier: EntityPermissionQualifier;
    jwt_claims: bytes;
  }
): struct {
  permissions: Permissions;
  tags: [string];
} = 209684;
