import { InternalError } from "kernel/v1/errors.skir";

// Public unauthenticated query used to bootstrap NATS auth callout.
// These credentials identify the sentinel user and carry no publish/subscribe permissions.
method GetSentinelCredentials(
  struct {}
): enum {
  internal_error: InternalError;

  success: struct {
    jwt: string;
    seed: string;
  };
} = 403062;
