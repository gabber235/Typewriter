// Presentation is the declarative editor surface shared by catalog producers and
// panel renderers. A PresentationDefinition exposes reusable inputs and a root
// PresentationNode. The node tree composes layout, content, data projection,
// editing controls, and actions without embedding renderer specific state.
//
// PresentationNode is the recursive boundary. Properties gate and constrain the
// node, an optional header adds node chrome, and its optional PresentationElement
// supplies behavior when present. Elements fall into five cooperating families: layout
// arranges nodes, content displays values, data projects or scopes values, input
// edits bound values, and interaction invokes editor actions. Connections are a
// layout overlay, while search providers supply data to search inputs.
//
// BindingRef identifies the value or scope an element consumes. ExpressionNode
// supplies derived display, condition, and control values. ExpressionBindingId identifies
// inputs introduced by a definition or temporary collection scope. These are
// evaluation context, not presentation owned mutable state.

import { EditorAction } from "editor/v1/action.skir";
import { BindingRef } from "editor/v1/binding.skir";
import { ExpressionNode } from "editor/v1/expression.skir";
import {
  CapabilityId,
  ConversionId,
  DataValue,
  ExpressionBindingId,
  NamedTypeTemplate,
  PresentationId,
  RelativeFieldPattern,
  TypeDefinitionId,
  TypeTemplate,
  TypeUse,
  ValuePath,
} from "editor/v1/type_catalog.skir";

