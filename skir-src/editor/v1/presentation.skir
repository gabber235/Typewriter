struct PresentationContextInput(84140236) {
  binding: BindingDeclaration = 0;
  source: PresentationContextSource = 1;
}

/// An explicitly reusable inspector part, identified by its declaring contract.
struct PresentationPartId(84140237) {
  owner: TypeDefinitionId = 0;
  name: string = 1;
}

/// A body declares an atomic part. Without a body, this requests an inherited part.
struct PresentationPartElement(84140238) {
  key: PresentationPartId = 0;
  body: PresentationNode? = 1;
}

/// Places members on a graph by their placement field, with edges from the relations among them.
struct GraphResourcesLayout(84140239) {
  direction: GraphDirection = 0;
  appearance: ResourceGraphAppearance? = 1;
}

/// Places members on a timeline by their timeline placement.
struct TimelineResourcesLayout(84140240) {
  appearance: ResourceTimelineAppearance? = 0;
}

/// Shows members as cards of a fixed maximum extent and aspect ratio.
struct GridResourcesLayout(84140241) {
  item_extent: ExpressionNode = 0;
  aspect_ratio: ExpressionNode = 1;
  spacing: ExpressionNode = 2;
}

/// Groups members by the hierarchy path at [path], relative to each member. [group] renders
/// each group header with [group_binding] bound to a HierarchyGroup value. Dropping a member
/// onto a group rewrites its path field.
struct TreeResourcesLayout(84140242) {
  path: ValuePath = 0;
  group: PresentationNode? = 1;
  group_binding: BindingDeclaration = 2;
  connectors: HierarchySequenceLayout? = 3;
  initially_expanded: bool = 4;
}

/// A number that may change with interaction state, in the unit of the field holding it.
enum PresentationNumber(84140243) {
  value: ExpressionNode = 1;
  states: PresentationStateNumber = 2;
}

/// The first rule matching the current interaction state wins; otherwise [fallback] applies.
struct PresentationStateNumber(84140244) {
  rules: [PresentationStateNumberRule] = 0;
  fallback: ExpressionNode = 1;
}

struct PresentationStateNumberRule(84140245) {
  match: PresentationStateMatch = 0;
  value: ExpressionNode = 1;
}

/// How an animated change progresses over its duration.
enum PresentationCurve(84140246) {
  linear = 1;
  ease_in_out = 2;
  ease_out = 3;
  /// Quick start and long settle, for movement that should feel deliberate.
  emphasized = 4;
  /// Springs past the target and settles. The value is the overshoot period, in curve
  /// progress units (Flutter ElasticOutCurve.period).
  elastic_out: float64 = 5;
}

struct PresentationTransition(84140247) {
  milliseconds: int32 = 0;
  curve: PresentationCurve = 1;
}

/// Chooses the transition for a change by the state being entered: the first rule matching
/// the new interaction state animates the change; otherwise [fallback] does.
struct PresentationTransitionPolicy(84140248) {
  rules: [PresentationStateTransitionRule] = 0;
  fallback: PresentationTransition = 1;
}

struct PresentationStateTransitionRule(84140249) {
  match: PresentationStateMatch = 0;
  transition: PresentationTransition = 1;
}

/// Blur, spread and offsets in logical pixels.
struct PresentationShadow(84140250) {
  color: PresentationColor = 0;
  blur: float64 = 1;
  spread: float64 = 2;
  offset_x: float64 = 3;
  offset_y: float64 = 4;
}

/// Moves [source] in OkLch. Both adjustments range from minus one to one: negative lightness moves toward
/// black and positive toward white; negative chroma desaturates and positive saturates.
struct PresentationAdjustedColor(84140251) {
  source: PresentationColor = 0;
  lightness: float64 = 1;
  chroma: float64 = 2;
}

/// Picks a color by the brightness of the editor theme.
struct PresentationBrightnessColor(84140252) {
  light: PresentationColor = 0;
  dark: PresentationColor = 1;
}

enum StackChild(84140253) {
  /// Sized and aligned by the stack.
  flow: PresentationNode = 1;
  positioned: PositionedStackChild = 2;
}

/// Insets and sizes in logical pixels relative to the stack. At most two of [start], [end]
/// and [width] apply horizontally, and at most two of [top], [bottom] and [height] vertically.
struct PositionedStackChild(84140254) {
  child: PresentationNode = 0;
  top: PresentationNumber? = 1;
  start: PresentationNumber? = 2;
  end: PresentationNumber? = 3;
  bottom: PresentationNumber? = 4;
  width: PresentationNumber? = 5;
  height: PresentationNumber? = 6;
  /// Animates changes of the insets and sizes; they apply at once when absent.
  transition: PresentationTransitionPolicy? = 7;
}

/// Constrains [child] in logical pixels. An exact width or height overrides its bounds.
struct SizeLayout(84140255) {
  child: PresentationNode = 0;
  width: ExpressionNode? = 1;
  height: ExpressionNode? = 2;
  minimum_width: ExpressionNode? = 3;
  maximum_width: ExpressionNode? = 4;
  minimum_height: ExpressionNode? = 5;
  maximum_height: ExpressionNode? = 6;
}

/// Paints [child] transformed around [origin]. Paint only: layout and the host hit region keep
/// the untransformed bounds. Rotations are in turns, translations in logical pixels, and
/// [perspective] is the Matrix4 entry (3, 2); zero keeps the transform flat.
struct TransformLayout(84140256) {
  child: PresentationNode = 0;
  origin: PresentationAlignment = 1;
  perspective: float64 = 2;
  scale: PresentationNumber? = 3;
  rotate_x: PresentationNumber? = 4;
  rotate_y: PresentationNumber? = 5;
  rotate_z: PresentationNumber? = 6;
  translate_x: PresentationNumber? = 7;
  translate_y: PresentationNumber? = 8;
  /// Animates changes of the transform; they apply at once when absent.
  transition: PresentationTransitionPolicy? = 9;
}
