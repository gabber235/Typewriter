  layout: WrapChildrenLayout = 1;
}

struct GridChildrenElement(84140027) {
  children: [PresentationNode] = 0;
  layout: GridChildrenLayout = 1;
}

/// Children painted over each other. Flow children size the stack; positioned children are
/// placed by insets and sizes relative to it, and paint in declaration order.
struct StackChildrenElement(84140028) {
  children: [StackChild] = 0;
  /// Where flow children sit; top start when absent.
  alignment: PresentationAlignment? = 1;
}

enum ChildrenElement(84140029) {
  column: AxisChildrenElement = 1;
  row: AxisChildrenElement = 2;
  wrap: WrapChildrenElement = 3;
  grid: GridChildrenElement = 4;
  stack: StackChildrenElement = 5;
}

