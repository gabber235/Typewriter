  title: PresentationHeaderTitle? = 1;
  description: ExpressionNode? = 2;
  initially_expanded: bool? = 3;
  items: [HeaderItem] = 4;
  header_padding: PresentationInsets? = 5;
  content_padding: PresentationInsets? = 6;
}

/// One authored layout node. node_id scopes diagnostics and reusable inspector membership.
/// Read only and enabled properties constrain interaction without granting persistence access.
struct PresentationNode(84140017) {
  node_id: string = 0;
  properties: PresentationProperties = 1;
  element: PresentationElement? = 2;
  header: PresentationHeader? = 3;
}

