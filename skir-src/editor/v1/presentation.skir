  horizontal_spacing: float64 = 1;
  vertical_spacing: float64 = 2;
}

// Repeated sequences own their item nodes separately and use this value only
// for placement. Direct child containers use the exclusive ChildrenElement.
enum ChildrenLayout(84140024) {
  column: AxisChildrenLayout = 1;
  row: AxisChildrenLayout = 2;
  wrap: WrapChildrenLayout = 3;
  grid: GridChildrenLayout = 4;
  stack = 5;
}

struct AxisChildrenElement(84140025) {
  children: [AxisChild] = 0;
  layout: AxisChildrenLayout = 1;
}

struct WrapChildrenElement(84140026) {
