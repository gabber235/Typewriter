import {
  PreparedCreation,
  ResourceDefinitionId,
} from "editor/v1/catalog.skir";
import {
  FindingSet,
  FindingsToken,
  InputIdentity,
  InputObservation,
} from "editor/v1/checking.skir";
import {
  DeclarationDiagnostic,
  Diagnostic,
  ValueProblem,
} from "editor/v1/diagnostic.skir";
import { RealmSearchQuery } from "editor/v1/search.skir";
import {
  AuthoringRecord,
  BatchId,
  CatalogGeneration,
  DataValue,
  EndpointId,
  InputToken,
  ItemId,
  LinkTarget,
  ListItem,
  NamedTypeUse,
  RelationFamilyId,
  RelationId,
  ResourceId,
  SnapshotId,
  TypeDefinitionId,
  TypeSelection,
  ValueLocation,
  ValuePath,
} from "editor/v1/type_catalog.skir";
import { PortableValue } from "editor/v1/typed_value.skir";
import { BoundedTransferChunk } from "kernel/v1/bounded_transfer.skir";
import { InternalError } from "kernel/v1/errors.skir";

struct AuthoringResource(812200001) {
  id: ResourceId = 0;
  definition: ResourceDefinitionId = 1;
  content: AuthoringRecord = 2;
}

struct LinkOccurrenceId(812200002) {
  endpoint: EndpointId = 0;
  location: ValueLocation = 1;
}

struct LinkOccurrence(812200003) {
  id: LinkOccurrenceId = 0;
  source: ResourceId = 1;
  target: LinkTarget = 2;
}

struct LinkProjection(812200004) {
  contract: RelationId = 0;
  first: ResourceId = 1;
  second: ResourceId = 2;
  first_location: ValuePath? = 3;
  second_location: ValuePath? = 4;
}

struct RelationProjectionDelta(812200005) {
  removals: [LinkProjection] = 0;
  created: [LinkProjection] = 1;
  metadata_changed: [LinkProjection] = 2;
}

enum TraversalDirection(812200006) {
  forward = 1;
  reverse = 2;
  both = 3;
}

struct FamilyRelationSelection(812200007) {
  id: RelationFamilyId = 0;
  direction: TraversalDirection = 1;
}

struct ContractRelationSelection(812200008) {
  ids: [RelationId] = 0;
  direction: TraversalDirection = 1;
}

struct AllRelationSelection(812200009) {
  direction: TraversalDirection = 0;
}

enum RelationSelection(812200010) {
  family: FamilyRelationSelection = 1;
  contracts: ContractRelationSelection = 2;
  all: AllRelationSelection = 3;
}

struct TraversalBudget(812200011) {
  max_resources: int64 = 0;
  max_links: int64 = 1;
  max_routes: int64 = 2;
  max_steps: int64 = 3;
}

struct GraphEndpoint(812200012) {
  resource: ResourceId = 0;
  endpoint: EndpointId = 1;
  path: ValuePath? = 2;
}

struct GraphStep(812200013) {
  relation: RelationId = 0;
  from: GraphEndpoint = 1;
  to: GraphEndpoint = 2;
}

enum UnresolvedLink(812200014) {
  unfilled: LinkOccurrenceId = 1;
  unavailable_target: LinkOccurrenceId = 2;
}

struct PresentationSubject(812200015) {
  resource: ResourceId = 0;
  definition: ResourceDefinitionId = 1;
  content: AuthoringRecord = 2;
  descriptor: DataValue = 3;
}

enum PresentationSubjectChange(812200016) {
  upsert: struct {
    resource: ResourceId = 0;
    subject: PresentationSubject = 1;
  } = 1;
  remove: ResourceId = 2;
}

struct AuthoringDiagnostic(812200017) {
  code: string = 0;
  message: string = 1;
  resource: ResourceId? = 2;
  path: ValuePath? = 3;
}

struct AuthoringInvalid(812200018) {
  diagnostics: [AuthoringDiagnostic] = 0;
}

struct CatalogChanged(812200019) {
  actual_generation: CatalogGeneration = 0;
}

struct AuthoringSnapshot(812200020) {
  snapshot: SnapshotId = 0;
  generation: CatalogGeneration = 1;
  resources: [AuthoringResource] = 2;
  links: [LinkProjection] = 3;
  findings: [FindingSet] = 4;
  observations: [InputObservation] = 5;
  absent_input_token: InputToken = 6;
  findings_token: FindingsToken = 7;
}

struct SetValueIntent(812200021) {
  at: ValueLocation = 0;
  value: DataValue = 1;
}

struct InsertIntent(812200022) {
  at: ValueLocation = 0;
  after: ItemId? = 1;
  item: ListItem = 2;
}

struct RemoveIntent(812200023) {
  at: ValueLocation = 0;
  item: ItemId = 1;
}

struct MoveIntent(812200024) {
  at: ValueLocation = 0;
  item: ItemId = 1;
  after: ItemId? = 2;
}

struct CreateResourceIntent(812200025) {
  id: ResourceId = 0;
  record: AuthoringRecord = 1;
}

struct DeleteResourceIntent(812200026) {
  id: ResourceId = 0;
}

struct NewCounterpartChoice(812200027) {
  containing: ValueLocation = 0;
  prepared: PreparedCreation = 1;
}

enum CounterpartChoice(812200028) {
  existing: LinkOccurrence = 1;
  new: NewCounterpartChoice = 2;
}

struct ConnectIntent(812200029) {
  source: LinkOccurrence = 0;
  target: ResourceId = 1;
  counterpart: CounterpartChoice? = 2;
}

struct RetagIntent(812200030) {
  at: ValueLocation = 0;
  type: NamedTypeUse = 1;
}

struct ResourceConfigurationIntent(812200031) {
  resource: ResourceId = 0;
  configuration: TypeSelection = 1;
}

enum EditIntent(812200032) {
  create_resource: CreateResourceIntent = 1;
  delete_resource: DeleteResourceIntent = 2;
  set_value: SetValueIntent = 3;
  insert: InsertIntent = 4;
  remove: RemoveIntent = 5;
  move: MoveIntent = 6;
  connect_relation: ConnectIntent = 7;
  disconnect_relation: LinkOccurrenceId = 8;
  retag: RetagIntent = 9;
  configure_resource: ResourceConfigurationIntent = 10;
}

struct PreparedEdit(812200033) {
  id: BatchId = 0;
  catalog: CatalogGeneration = 1;
  snapshot: SnapshotId = 2;
  observations: [InputObservation] = 3;
  intents: [EditIntent] = 4;
}

struct PreparedEditReady(812200034) {
  snapshot: SnapshotId = 0;
  edit: PreparedEdit = 1;
}

enum PreparedEditResult(812200035) {
  prepared: PreparedEditReady = 1;
  needs_input: [ValueLocation] = 2;
  rejected: [ValueProblem] = 3;
}

struct InputConflict(812200036) {
  input: InputIdentity = 0;
  expected: InputToken = 1;
  actual: InputToken? = 2;
}

struct CommitSuccess(812200037) {
  snapshot: SnapshotId = 0;
  changed: [InputIdentity] = 1;
}

enum CommitResult(812200038) {
  committed: CommitSuccess = 1;
  conflict: [InputConflict] = 2;
  rejected: [ValueProblem] = 3;
  catalog_changed: CatalogGeneration = 4;
}

enum AuthoringOperation(812200039) {
  commit_prepared: PreparedEdit = 1;
}

enum AuthoringResourceChange(812200040) {
  upsert: AuthoringResource = 1;
  remove: ResourceId = 2;
}

struct AuthoringChanged(812200041) {
  previous_snapshot: SnapshotId = 0;
  snapshot: SnapshotId = 1;
  generation: CatalogGeneration = 2;
  batch: BatchId = 3;
  resources: [AuthoringResourceChange] = 4;
  relations: RelationProjectionDelta = 5;
  previous_findings: FindingsToken = 6;
  findings_token: FindingsToken = 7;
  findings: AuthoringFindingsReplacement? = 8;
  changed_observations: [InputObservation] = 9;
}

enum TypeRepairIntent(812200042) {
  retag: RetagIntent = 1;
  clear: ValueLocation = 2;
  configure_resource: ResourceConfigurationIntent = 3;
}

enum LinkRepairIntent(812200043) {
  clear: LinkOccurrenceId = 1;
  remove: LinkOccurrenceId = 2;
}

struct TypeArgumentChangePreview(812200044) {
  catalog: CatalogGeneration = 0;
  source_snapshot: SnapshotId = 1;
  resource: ResourceId = 2;
  next: TypeSelection = 3;
  observations: [InputObservation] = 4;
  intents: [TypeRepairIntent] = 5;
  link_repairs: [LinkRepairIntent] = 6;
  cleared_locations: [ValueLocation] = 7;
}

struct ArgumentLocation(812200045) {
  index: int32 = 0;
}

enum TypePreviewResult(812200046) {
  ready: TypeArgumentChangePreview = 1;
  invalid_arguments: [DeclarationDiagnostic] = 2;
  incomplete: [ArgumentLocation] = 3;
  rejected: [ValueProblem] = 4;
}

struct SearchFacetId(812200047) {
  value: string = 0;
}

struct SearchFacetRequest(812200048) {
  facet_id: SearchFacetId = 0;
  partial: string? = 1;
  validate: [string] = 2;
}

struct SearchFacetResult(812200049) {
  facet_id: SearchFacetId = 0;
  suggestions: [string] = 1;
  accepted: [string] = 2;
  rejected: [string] = 3;
}

struct AuthoringSearchHit(812200050) {
  resource: ResourceId = 0;
  definition: ResourceDefinitionId = 1;
  subject: PresentationSubject = 2;
  context: PortableValue = 3;
}

struct AuthoringSearchSnapshot(812200051) {
  snapshot: SnapshotId = 0;
  generation: CatalogGeneration = 1;
  hits: [AuthoringSearchHit] = 2;
  facets: [SearchFacetResult] = 3;
  diagnostics: [Diagnostic] = 4;
}

enum CollectionProjectionSource(812200052) {
  resource_id = 1;
  content: ValuePath = 2;
  literal: DataValue = 3;
}

struct CollectionProjectionField(812200053) {
  target: ValuePath = 0;
  source: CollectionProjectionSource = 1;
}

struct CollectionProjectionDefinition(812200054) {
  source_id: string = 0;
  root: TypeDefinitionId = 1;
  row_type: NamedTypeUse = 2;
  fields: [CollectionProjectionField] = 3;
}

struct AuthoringSnapshotTransferChunk(812200055) {
  generation: CatalogGeneration = 0;
  snapshot: SnapshotId = 1;
  transfer: BoundedTransferChunk = 2;
}

enum AuthoringTransferUnavailableReason(812200056) {
  encoded_size_limit = 1;
}

struct AuthoringTransferUnavailable(812200057) {
  generation: CatalogGeneration = 0;
  snapshot: SnapshotId = 1;
  reason: AuthoringTransferUnavailableReason = 2;
  encoded_size: int64 = 3;
  max_encoded_size: int64 = 4;
}

struct AuthoringChangedTransferChunk(812200058) {
  generation: CatalogGeneration = 0;
  previous_snapshot: SnapshotId = 1;
  snapshot: SnapshotId = 2;
  previous_findings: FindingsToken = 3;
  findings_token: FindingsToken = 4;
  transfer: BoundedTransferChunk = 5;
}

enum AuthoringChangedTransferResult(812200059) {
  chunk: AuthoringChangedTransferChunk = 1;
  unavailable: AuthoringTransferUnavailable = 2;
}

struct AuthoringFindingsReplacement(812200060) {
  findings: [FindingSet] = 0;
}

method QueryAuthoringSnapshot(
  struct {
    generation: CatalogGeneration = 0;
    snapshot: SnapshotId? = 1;
    transfer_id: string = 2;
  }
): enum {
  chunk: AuthoringSnapshotTransferChunk = 1;
  catalog_changed: CatalogChanged = 2;
  unavailable: AuthoringTransferUnavailable = 3;
  internal_error: InternalError = 4;
} = 920010;

method SearchAuthoring(
  struct {
    generation: CatalogGeneration = 0;
    snapshot: SnapshotId = 1;
    query: RealmSearchQuery = 2;
    roots: [TypeDefinitionId] = 3;
    contexts: [ResourceId] = 4;
    target: NamedTypeUse? = 5;
    facets: [SearchFacetRequest] = 6;
  }
): enum {
  success: AuthoringSearchSnapshot = 1;
  invalid: AuthoringInvalid = 2;
  catalog_changed: CatalogChanged = 3;
  internal_error: InternalError = 4;
} = 920011;

method CommitPreparedEdit(
  PreparedEdit
): enum {
  result: CommitResult = 1;
  internal_error: InternalError = 2;
} = 920012;

method PreviewTypeArgumentChange(
  struct {
    resource: ResourceId = 0;
    requested: TypeSelection = 1;
    snapshot: SnapshotId = 2;
    catalog: CatalogGeneration = 3;
  }
): enum {
  result: TypePreviewResult = 1;
  internal_error: InternalError = 2;
} = 920013;

method CommitTypeArgumentChange(
  TypeArgumentChangePreview
): enum {
  result: CommitResult = 1;
  internal_error: InternalError = 2;
} = 920014;
