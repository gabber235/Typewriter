// Saved authoring resources are the Realm canonical editable state. Clients capture one
// AuthoringState, stage local intent, and submit a PreparedEdit with the original facts
// it relied on. Realm admission compares those facts and validates the resulting graph
// before saving. Checking and publication follow their own lifecycles after a commit.

import {
  EditExpectation,
  ExpectationConflict,
  LinkProjection,
} from "editor/v1/authoring_facts.skir";
import { PreparedValue } from "editor/v1/catalog.skir";
import { FindingSet } from "editor/v1/checking.skir";
import {
  DeclarationDiagnostic,
  Diagnostic,
  ValueProblem,
} from "editor/v1/diagnostic.skir";
import {
  AuthoringRecord,
  CatalogGeneration,
  DataValue,
  EndpointId,
  ItemId,
  LinkTarget,
  ListItem,
  NamedTypeUse,
  ResourceId,
  TypeDefinitionId,
  TypeSelection,
  ValueLocation,
  ValuePath,
} from "editor/v1/type_catalog.skir";
import { PortableValue } from "editor/v1/typed_value.skir";
import { InternalError } from "kernel/v1/errors.skir";

struct AuthoringResource(812200001) {
  id: ResourceId = 0;
  content: AuthoringRecord = 1;
}

/// Identifies an authored reference by endpoint and exact value location, including collection item identity.
struct LinkOccurrenceId(812200002) {
  endpoint: EndpointId = 0;
  location: ValueLocation = 1;
}

struct LinkOccurrence(812200003) {
  id: LinkOccurrenceId = 0;
  source: ResourceId = 1;
  target: LinkTarget = 2;
}

/// Describes changes to graph edges derived from authored references; edge rows are not independent edit intent.
struct RelationProjectionDelta(812200004) {
  removals: [LinkProjection] = 0;
  created: [LinkProjection] = 1;
  metadata_changed: [LinkProjection] = 2;
}

/// Supplies a resource identity and authored content to portable resource presentations.
/// Catalog choices use CatalogPresentationSubject instead because they have no resource instance.
struct PresentationSubject(812200005) {
  resource: ResourceId = 0;
  content: AuthoringRecord = 1;
}

struct AuthoringDiagnostic(812200006) {
  code: string = 0;
  message: string = 1;
  resource: ResourceId? = 2;
  path: ValuePath? = 3;
}

struct AuthoringInvalid(812200007) {
  diagnostics: [AuthoringDiagnostic] = 0;
}

struct CatalogChanged(812200008) {
  actual_generation: CatalogGeneration = 0;
}

/// Captures one saved resource graph and its catalog for editor synchronization.
/// Findings retain their own execution evidence and freshness. The state describes one confirmed
/// observation, which resource operations must echo before supplying a working overlay.
struct AuthoringState(812200009) {
  generation: CatalogGeneration = 0;
  resources: [AuthoringResource] = 1;
  links: [LinkProjection] = 2;
  findings: [FindingSet] = 3;
  confirmed_observation: AuthoringObservationId = 4;
}

struct SetValueIntent(812200010) {
  at: ValueLocation = 0;
  value: DataValue = 1;
}

struct InsertIntent(812200011) {
  at: ValueLocation = 0;
  after: ItemId? = 1;
  item: ListItem = 2;
}

struct RemoveIntent(812200012) {
  at: ValueLocation = 0;
  item: ItemId = 1;
}

struct MoveIntent(812200013) {
  at: ValueLocation = 0;
  item: ItemId = 1;
  after: ItemId? = 2;
}

struct CreateResourceIntent(812200014) {
  id: ResourceId = 0;
  record: AuthoringRecord = 1;
}

struct DeleteResourceIntent(812200015) {
  id: ResourceId = 0;
}

struct NewCounterpartChoice(812200016) {
  containing: ValueLocation = 0;
  prepared: PreparedValue = 1;
}

enum CounterpartChoice(812200017) {
  existing: LinkOccurrence = 1;
  new: NewCounterpartChoice = 2;
}

struct ConnectIntent(812200018) {
  source: LinkOccurrence = 0;
  target: ResourceId = 1;
  counterpart: CounterpartChoice? = 2;
}

struct RetagIntent(812200019) {
  at: ValueLocation = 0;
  type: NamedTypeUse = 1;
}

struct ResourceConfigurationIntent(812200020) {
  resource: ResourceId = 0;
  configuration: TypeSelection = 1;
}

/// Ordered proposed mutations. Relation intent names exact authored occurrences so admission can
/// synchronize inverses and validate the resulting graph before persistence.
enum EditIntent(812200021) {
  create_resource: CreateResourceIntent = 1;
  delete_resource: DeleteResourceIntent = 2;
  set_value: SetValueIntent = 3;
  insert: InsertIntent = 4;
  remove: RemoveIntent = 5;
  move: MoveIntent = 6;
  connect_relation: ConnectIntent = 7;
  disconnect_relation: LinkOccurrenceId = 8;
  retag: RetagIntent = 9;
  configure_resource: ResourceConfigurationIntent = 10;
}

/// Carries a proposed edit and the original saved facts that justify replaying it.
/// Matching supplied facts alone is insufficient: Realm admission independently requires guards for
/// the affected values and relations. Preparation grants no persistence or publication authority.
struct PreparedEdit(812200022) {
  catalog: CatalogGeneration = 0;
  expectations: [EditExpectation] = 1;
  intents: [EditIntent] = 2;
}

struct PreparedEditReady(812200023) {
  edit: PreparedEdit = 0;
}

enum AuthoringOperation(812200024) {
  commit_prepared: PreparedEdit = 1;
}

/// Hints that clients should query saved authoring state or findings. This is not an edit log or revision counter.
struct AuthoringChanged(812200025) {
  generation: CatalogGeneration = 0;
}

enum LinkRepairIntent(812200026) {
  clear: LinkOccurrenceId = 1;
  remove: LinkOccurrenceId = 2;
}

/// Proposes a fixed definition type configuration change together with all value and link repairs.
/// Preparation rechecks expectations and regenerates repairs before yielding a committable edit.
struct TypeArgumentChangePreview(812200027) {
  resource: ResourceId = 0;
  next: TypeSelection = 1;
  edit: PreparedEdit = 2;
  link_repairs: [LinkRepairIntent] = 3;
  cleared_locations: [ValueLocation] = 4;
}

struct ArgumentLocation(812200028) {
  index: int32 = 0;
}

struct AuthoringSearchHit(812200029) {
  resource: ResourceId = 0;
  subject: PresentationSubject = 1;
  context: PortableValue = 2;
}

struct AuthoringSearchResult(812200030) {
  generation: CatalogGeneration = 0;
  hits: [AuthoringSearchHit] = 1;
  diagnostics: [Diagnostic] = 2;
}

/// Identifies one saved authoring observation without ordering resource changes.
/// A local operation overlay echoes this identity while carrying separate proposed values; a
/// changed saved view requires refreshing the baseline.
struct AuthoringObservationId(812200031) {
  value: string = 0;
}

/// Returns the retained saved snapshot for one catalog generation.
method QueryAuthoringState(
  struct {
    generation: CatalogGeneration = 0;
  }
): enum {
  state: AuthoringState = 1;
  catalog_changed_error: CatalogChanged = 2;
  internal_error: InternalError = 3;
} = 920010;

method SearchAuthoring(
  struct {
    generation: CatalogGeneration = 0;
    query: string = 1;
    roots: [TypeDefinitionId] = 2;
    contexts: [ResourceId] = 3;
    target: NamedTypeUse? = 4;
  }
): enum {
  success: AuthoringSearchResult = 1;
  invalid_error: AuthoringInvalid = 2;
  catalog_changed_error: CatalogChanged = 3;
  internal_error: InternalError = 4;
} = 920011;

/// committed confirms installation of saved authoring state. It does not confirm check completion,
/// compilation, publication selection, or engine application. conflict_error requires refreshing
/// original facts; rejected_error reports invalid intent or missing guards; catalog_changed_error
/// requires a new catalog.
method CommitPreparedEdit(
  PreparedEdit
): enum {
  committed = 1;
  conflict_error: [ExpectationConflict] = 2;
  rejected_error: [ValueProblem] = 3;
  catalog_changed_error: CatalogGeneration = 4;
  internal_error: InternalError = 5;
} = 920012;

method PreviewTypeArgumentChange(
  struct {
    resource: ResourceId = 0;
    requested: TypeSelection = 1;
    catalog: CatalogGeneration = 2;
  }
): enum {
  ready: TypeArgumentChangePreview = 1;
  invalid_arguments_error: [DeclarationDiagnostic] = 2;
  incomplete: [ArgumentLocation] = 3;
  rejected_error: [ValueProblem] = 4;
  internal_error: InternalError = 5;
} = 920013;

/// Revalidates a preview and returns proposed intent. CommitPreparedEdit performs the separate saved write.
method PrepareTypeArgumentChange(
  TypeArgumentChangePreview
): enum {
  prepared: PreparedEditReady = 1;
  needs_input: [ValueLocation] = 2;
  rejected_error: [ValueProblem] = 3;
  internal_error: InternalError = 4;
} = 920014;
