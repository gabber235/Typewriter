method QueryAuthoringGraph(
  struct {
    generation: CatalogGeneration = 0;
    selections: [GraphSelection] = 1;
  }
): enum {
  success: AuthoringGraphSnapshot = 1;
  invalid: AuthoringInvalid = 2;
  catalog_changed: CatalogChanged = 3;
  internal_error: InternalError = 4;
} = 920010;

method SearchAuthoringGraph(
  struct {
    generation: CatalogGeneration = 0;
    query: RealmSearchQuery = 1;
    resources: ResourceFilter = 2;
    scope: GraphSelection? = 3;
    reference_target: TypeExpression? = 4;
    facets: [SearchFacetRequest] = 5;
  }
): enum {
  success: AuthoringSearchSnapshot = 1;
  invalid: AuthoringInvalid = 2;
  catalog_changed: CatalogChanged = 3;
  internal_error: InternalError = 4;
} = 920011;

method ApplyAuthoringBatch(
  struct {
    batch_id: string = 0;
    generation: CatalogGeneration = 1;
    operations: [AuthoringOperation] = 2;
  }
): enum {
  applied: AuthoringChanged = 1;
  conflict: AuthoringConflict = 2;
  invalid: AuthoringInvalid = 3;
  catalog_changed: CatalogChanged = 4;
  internal_error: InternalError = 5;
} = 920012;

method PreviewAuthoringBatch(
  struct {
    generation: CatalogGeneration = 0;
    operations: [AuthoringOperation] = 1;
  }
): enum {
  valid: AuthoringPreview = 1;
  conflict: AuthoringConflict = 2;
  invalid: AuthoringInvalid = 3;
