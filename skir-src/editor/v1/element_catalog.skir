import { CatalogPresentationSubject } from "editor/v1/catalog_presentation.skir";
import {
  DeclaredTypeId,
  ResolvedTypeRef,
} from "editor/v1/type_catalog.skir";
import { Color } from "kernel/v1/color.skir";
import { Icon } from "kernel/v1/icon.skir";

struct ContentTypeId(811100001) {
  value: DeclaredTypeId = 0;
}

struct AvailabilityFact(811100002) {
  key: string = 0;
  expected: string = 1;
}

struct AvailabilityAll(811100003) {
  expressions: [AvailabilityExpression] = 0;
}

struct AvailabilityAny(811100004) {
  expressions: [AvailabilityExpression] = 0;
}

struct AvailabilityNot(811100005) {
  expression: AvailabilityExpression = 0;
}

enum AvailabilityExpression(811100006) {
  always: struct {} = 1;
  fact: AvailabilityFact = 2;
  all: AvailabilityAll = 3;
  any: AvailabilityAny = 4;
  not: AvailabilityNot = 5;
}

enum ContentSearchMode(811100007) {
  summary: struct {} = 1;
  body: struct {} = 2;
  keyword: struct {} = 3;
  none: struct {} = 4;
}

enum ContentSearchPolicy(811100008) {
  ordinary_text: struct {} = 1;
}

struct ContentSearchPropertyOverride(811100009) {
  owner_type: ResolvedTypeRef = 0;
  field: string = 1;
  mode: ContentSearchMode = 2;
}

struct ContentSearchDefinition(811100010) {
  policy: ContentSearchPolicy = 0;
  property_overrides: [ContentSearchPropertyOverride] = 1;
  revision_fingerprint_inputs: [ResolvedTypeRef] = 2;
}

enum ContentRole(811100015) {
  element: struct {} = 1;
  cue: struct {} = 2;
}

struct ContentDescriptor(811100011) {
  content_type_id: ContentTypeId = 0;
  type: ResolvedTypeRef = 1;
  name: string = 2;
  description: string = 3;
  icon: Icon = 4;
  color: Color = 5;
  availability: AvailabilityExpression = 6;
  search_definition: ContentSearchDefinition? = 7;
  role: ContentRole = 8;
}

struct ContentIneligibility(811100012) {
  reasons: [string] = 0;
}

enum ContentEligibility(811100013) {
  eligible: struct {} = 1;
  ineligible: ContentIneligibility = 2;
}

struct ContentCatalogEntry(811100014) {
  origin_artifact_id: string = 0;
  source_part: string = 1;
  descriptor: ContentDescriptor = 2;
  presentation_subject: CatalogPresentationSubject = 3;
  eligibility: ContentEligibility = 4;
  available: bool = 5;
}
