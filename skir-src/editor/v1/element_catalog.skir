import {
  CatalogGeneration,
  DeclaredTypeId,
  ResolvedTypeRef,
} from "editor/v1/type_catalog.skir";
import { TypedValueEnvelope } from "editor/v1/typed_value.skir";
import { Color } from "kernel/v1/color.skir";
import { Icon } from "kernel/v1/icon.skir";

struct ElementTypeId(811100001) {
  value: DeclaredTypeId = 0;
}

struct ElementInstanceId(811100002) {
  value: string = 0;
}

struct AvailabilityFact(811100003) {
  key: string = 0;
  expected: string = 1;
}

struct AvailabilityAll(811100004) {
  expressions: [AvailabilityExpression] = 0;
}

struct AvailabilityAny(811100005) {
  expressions: [AvailabilityExpression] = 0;
}

struct AvailabilityNot(811100006) {
  expression: AvailabilityExpression = 0;
}

enum AvailabilityExpression(811100007) {
  always: struct {} = 1;
  fact: AvailabilityFact = 2;
  all: AvailabilityAll = 3;
  any: AvailabilityAny = 4;
  not: AvailabilityNot = 5;
}

enum ElementKind(811100008) {
  entry = 1;
  cue = 2;
}

struct ElementDescriptor(811100009) {
  element_type_id: ElementTypeId = 0;
  kind: ElementKind = 1;
  type: ResolvedTypeRef = 2;
  name: string = 3;
  description: string = 4;
  icon: Icon = 5;
  color: Color = 6;
  availability: AvailabilityExpression = 7;
}

struct ElementIneligibility(811100010) {
  reasons: [string] = 0;
}

enum ElementEligibility(811100011) {
  eligible: struct {} = 1;
  ineligible: ElementIneligibility = 2;
}

struct ElementCatalogEntry(811100012) {
  origin_artifact_id: string = 0;
  source_part: string = 1;
  descriptor: ElementDescriptor = 2;
  eligibility: ElementEligibility = 3;
  available: bool = 4;
}

struct ElementCatalogRequest(811100013) {
  expected_generation: CatalogGeneration? = 0;
}

struct ElementCatalogSuccess(811100014) {
  generation: CatalogGeneration = 0;
  entries: [ElementCatalogEntry] = 1;
}

enum ElementCatalogResult(811100015) {
  success: ElementCatalogSuccess = 1;
  generation_mismatch: CatalogGeneration = 2;
  unavailable: [string] = 3;
}

struct StoredElementEnvelope(811100016) {
  id: ElementInstanceId = 0;
  element_type: ElementTypeId = 1;
  schema_revision: int32 = 2;
  value: TypedValueEnvelope = 3;
}

method FetchElementCatalog(
  ElementCatalogRequest
): ElementCatalogResult = 910004;
