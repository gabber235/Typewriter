// Diagnostics distinguish invalid declarations, invalid authored structure, unfinished
// values, and failures during initialization or evaluation. Location and rule identity
// retain the source context needed by editors; presentation severity does not itself
// establish saved state, check freshness, or publication admission.

import {
  CheckedType,
  DataValue,
  DeclarationOwner,
  DiagnosticId,
  FieldOwner,
  RelativeFieldPattern,
  RuleOrigin,
  TypeDefinitionId,
  ValueLocation,
  ValuePath,
} from "editor/v1/type_catalog.skir";

enum DiagnosticSeverity(84110001) {
  information = 1;
  warning = 2;
  error = 3;
}

struct DeclarationOrigin(84110002) {
  owner: DeclarationOwner = 0;
}

struct DeclarationDiagnostic(84110003) {
  affected: TypeDefinitionId = 0;
  code: string = 1;
  origins: [DeclarationOrigin] = 2;
  field: RelativeFieldPattern? = 3;
}

struct DiagnosticTemplate(84110004) {
  code: string = 0;
  message: string = 1;
  severity: DiagnosticSeverity = 2;
  // Patterns are relative to the owning configuration occurrence.
  // For a portable rule, a target equal to its recipe path denotes the current
  // matched subject, including when that path contains collection wildcards.
  // Empty targets fall back to that subject.
  targets: [RelativeFieldPattern] = 3;
}

struct Diagnostic(84110005) {
  id: DiagnosticId = 0;
  origin: RuleOrigin = 1;
  code: string = 2;
  message: string = 3;
  severity: DiagnosticSeverity = 4;
  primary: ValueLocation? = 5;
  related: [ValueLocation] = 6;
}

struct ValueProblem(84110006) {
  location: ValueLocation = 0;
  code: string = 1;
}

struct InitializationDiagnostic(84110007) {
  field: FieldOwner? = 0;
  code: string = 1;
  message: string = 2;
  relative_path: ValuePath? = 3;
}

struct CompleteValue(84110008) {
  schema: CheckedType = 0;
  value: DataValue = 1;
}

/// Reports whether authored shape is valid under its schema, independently of unfinished input.
enum StructuralResult(84110009) {
  valid = 1;
  invalid: [ValueProblem] = 2;
}

/// Distinguishes a value ready for native decoding from unfinished locations and invalid shape.
/// Schema resolution alone does not prove this value specific result.
enum CompletenessResult(84110010) {
  complete: CompleteValue = 1;
  unfinished: [ValueLocation] = 2;
  invalid: [ValueProblem] = 3;
}
