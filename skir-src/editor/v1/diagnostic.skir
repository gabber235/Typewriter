import {
  CheckedType,
  DataValue,
  DeclarationOwner,
  DiagnosticId,
  FieldOwner,
  RelativeFieldPattern,
  RuleOrigin,
  TypeDefinitionId,
  ValueLocation,
  ValuePath,
} from "editor/v1/type_catalog.skir";

enum DiagnosticSeverity(810300001) {
  information = 1;
  warning = 2;
  error = 3;
}

struct DeclarationOrigin(810300002) {
  owner: DeclarationOwner = 0;
}

struct DeclarationDiagnostic(810300003) {
  affected: TypeDefinitionId = 0;
  code: string = 1;
  origins: [DeclarationOrigin] = 2;
  field: RelativeFieldPattern? = 3;
}

struct DiagnosticTemplate(810300004) {
  code: string = 0;
  message: string = 1;
  severity: DiagnosticSeverity = 2;
  targets: [RelativeFieldPattern] = 3;
}

struct Diagnostic(810300005) {
  id: DiagnosticId = 0;
  origin: RuleOrigin = 1;
  code: string = 2;
  message: string = 3;
  severity: DiagnosticSeverity = 4;
  primary: ValueLocation? = 5;
  related: [ValueLocation] = 6;
}

struct ValueProblem(810300006) {
  location: ValueLocation = 0;
  code: string = 1;
}

struct InitializationDiagnostic(810300007) {
  field: FieldOwner? = 0;
  code: string = 1;
  message: string = 2;
  relative_path: ValuePath? = 3;
}

struct CompleteValue(810300008) {
  schema: CheckedType = 0;
  value: DataValue = 1;
}

enum StructuralResult(810300009) {
  valid = 1;
  invalid: [ValueProblem] = 2;
}

enum CompletenessResult(810300010) {
  complete: CompleteValue = 1;
  unfinished: [ValueLocation] = 2;
  invalid: [ValueProblem] = 3;
}
