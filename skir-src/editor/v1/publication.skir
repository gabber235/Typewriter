import { CompilationRoot } from "editor/v1/compilation_root.skir";
import { BoundedTransferChunk } from "kernel/v1/bounded_transfer.skir";
import { EditExpectation } from "editor/v1/authoring_facts.skir";
import { CheckInstanceId, FindingSet } from "editor/v1/checking.skir";
import { Diagnostic } from "editor/v1/diagnostic.skir";
import {
  CatalogGeneration,
  DeclarationOwner,
  DiagnosticId,
  RuleOrigin,
  ValueLocation,
  InputToken,
  NamedTypeUse,
  NativeBindingId,
  PublicationId,
  RuntimeMemberId,
  ScriptCapabilityId,
  TypeDefinition,
  TypeDefinitionId,
  TypeTemplate,
  TypeUse,
} from "editor/v1/type_catalog.skir";
import { InternalError } from "kernel/v1/errors.skir";

struct OwnedPortableTypes(811600001) {
  owner: DeclarationOwner = 0;
  definitions: [TypeDefinition] = 1;
}

struct RuntimeMemberTemplate(811600002) {
  id: RuntimeMemberId = 0;
  receiver: TypeTemplate? = 1;
  arguments: [TypeTemplate] = 2;
  result: TypeTemplate = 3;
  required_capabilities: [ScriptCapabilityId] = 4;
}

struct RuntimeMemberSignature(811600003) {
  id: RuntimeMemberId = 0;
  receiver: TypeUse? = 1;
  parameters: [TypeUse] = 2;
  result: TypeUse = 3;
  required_capabilities: [ScriptCapabilityId] = 4;
}

struct ScriptContextDescriptor(811600004) {
  types: [TypeDefinitionId] = 0;
  members: [RuntimeMemberId] = 1;
  capabilities: [ScriptCapabilityId] = 2;
}

struct NativeBindingRequirement(811600005) {
  actual: NamedTypeUse = 0;
  provider: NativeBindingId = 1;
  signature: string = 2;
}

struct EngineImplementationInputs(811600006) {
  signatures: [RuntimeMemberSignature] = 0;
  token: InputToken = 1;
}

enum PublicationState(811600007) {
  checking = 1;
  compiling = 2;
  activating = 3;
  complete = 4;
  blocked: [Diagnostic] = 5;
  interrupted = 6;
}

struct PublicationAttempt(811600008) {
  id: PublicationId = 0;
  catalog: CatalogGeneration = 1;
  engine_inputs: EngineImplementationInputs = 2;
  state: PublicationState = 3;
}

struct CheckCoverage(811600009) {
  required: [CheckInstanceId] = 0;
  completed: [CheckInstanceId] = 1;
}

struct AcceptedAuthoring(811600010) {
  catalog: CatalogGeneration = 0;
  required_coverage: CheckCoverage = 1;
  evidence: [EditExpectation] = 2;
  binding_requirements: [NativeBindingRequirement] = 3;
}

enum PublicationResult(811600011) {
  publishing = 1;
  activated: struct {
    publication: PublicationId = 0;
  } = 2;
  blocked: PublicationBlockers = 3;
  interrupted: PublicationId = 4;
  no_changes = 5;
  candidate_changed: PublicationViewChanged = 6;
}


struct PublicationReport(811600012) {
  id: PublicationId = 0;
  state: PublicationState = 1;
  findings: [Diagnostic] = 2;
}


struct PublicationCandidateId(811600013) { value: string = 0; }
struct PublicationViewId(811600014) { value: string = 0; }

enum PublicationBaseline(811600015) {
  initial = 1;
  selected: PublicationId = 2;
}

struct PublicationDiagnosticDetails(811600016) {
  id: DiagnosticId = 0;
  origin: RuleOrigin = 1;
  code: string = 2;
  message: string = 3;
  primary: ValueLocation? = 4;
  related: [ValueLocation] = 5;
}

// Severity is determined by the variant, not another independent field.
enum PublicationNotice(811600017) {
  information: PublicationDiagnosticDetails = 1;
  warning: PublicationDiagnosticDetails = 2;
}
struct PublicationBlocker(811600018) {
  details: PublicationDiagnosticDetails = 0;
}

enum PublicationChange(811600019) {
  root_added: CompilationRoot = 1;
  root_updated: CompilationRoot = 2;
  root_removed: CompilationRoot = 3;
  requirements_changed = 4;
}
struct PublicationDelta(811600020) {
  first: PublicationChange = 0;
  additional: [PublicationChange] = 1;
}
struct PublicationBlockers(811600021) {
  first: PublicationBlocker = 0;
  additional: [PublicationBlocker] = 1;
}

enum PublicationActivationPhase(811600022) {
  storing = 1;
  activating = 2;
}

// Later saved work can be reviewed during activation without authorizing it.
struct PublicationPendingReview(811600023) {
  findings: [FindingSet] = 0;
  confirmed_changes: [PublicationChange] = 1;
  pending_roots: [CompilationRoot] = 2;
  blockers: [PublicationBlocker] = 3;
  notices: [PublicationNotice] = 4;
}

enum PublicationFailure(811600024) {
  evaluation_interrupted: string = 1;
  implementation_unavailable: string = 2;
  publication_interrupted: PublicationId = 3;
}

enum PublicationStatus(811600025) {
  empty: struct { notices: [PublicationNotice] = 0; } = 1;
  current: struct {
    selected: PublicationId = 0;
    notices: [PublicationNotice] = 1;
  } = 2;
  ready: struct {
    candidate: PublicationCandidateId = 0;
    baseline: PublicationBaseline = 1;
    changes: PublicationDelta = 2;
    notices: [PublicationNotice] = 3;
  } = 3;
  blocked: struct {
    baseline: PublicationBaseline = 0;
    blockers: PublicationBlockers = 1;
    notices: [PublicationNotice] = 2;
    confirmed_changes: [PublicationChange] = 3;
    pending_roots: [CompilationRoot] = 4;
  } = 4;
  checking: struct {
    baseline: PublicationBaseline = 0;
    findings: [FindingSet] = 1;
  } = 5;
  publishing: struct {
    publication: PublicationId = 0;
    phase: PublicationActivationPhase = 1;
    releasing: PublicationDelta = 2;
    next: PublicationPendingReview = 3;
  } = 6;
  unavailable: struct {
    baseline: PublicationBaseline = 0;
    failure: PublicationFailure = 1;
    findings: [FindingSet] = 2;
  } = 7;
}
struct PublicationView(811600026) {
  id: PublicationViewId = 0;
  status: PublicationStatus = 1;
}
struct PublicationViewChanged(811600027) {
  current: PublicationViewId = 0;
}
struct PublicationViewChunk(811600028) {
  view: PublicationViewId = 0;
  transfer: BoundedTransferChunk = 1;
}
struct PublicationTransferUnavailable(811600029) {
  view: PublicationViewId = 0;
  encoded_size: int64 = 1;
  max_encoded_size: int64 = 2;
}

method PublishAuthoring(
  struct { candidate: PublicationCandidateId = 0; }
): enum {
  result: PublicationResult = 1;
  internal_error: InternalError = 2;
} = 920020;
method WatchPublication(struct {}): PublicationViewChanged = 920021;

method QueryPublicationView(
  struct {
    expected: PublicationViewId = 0;
    transfer_id: string = 1;
  }
): enum {
  chunk: PublicationViewChunk = 1;
  changed: PublicationViewChanged = 2;
  unavailable: PublicationTransferUnavailable = 3;
  internal_error: InternalError = 4;
} = 920022;
