import { CatalogPresentationSubject } from "editor/v1/catalog_presentation.skir";
import { ResolvedTypeRef } from "editor/v1/type_catalog.skir";
import { Color } from "kernel/v1/color.skir";
import { Icon } from "kernel/v1/icon.skir";

// Page catalog metadata tells the panel which concrete Page types exist and which editor owns each type.
// Accepted definitions and diagnostics travel together so invalid declarations remain explainable without becoming
// selectable Page types.

enum GraphDirection(811300001) {
  left_to_right = 1;
  right_to_left = 2;
  top_to_bottom = 3;
  bottom_to_top = 4;
}

struct GraphPageEditorDefinition(811300002) {
  direction: GraphDirection = 0;
}

struct TimelinePageEditorDefinition(811300003) {}

enum PageEditorDefinition(811300004) {
  graph: GraphPageEditorDefinition = 1;
  timeline: TimelinePageEditorDefinition = 2;
}

struct PageDescriptor(811300005) {
  type: ResolvedTypeRef = 0;
  name: string = 1;
  description: string? = 2;
  icon: Icon = 3;
  color: Color = 4;
  editor: PageEditorDefinition = 5;
}

struct PageCatalogEntry(811300006) {
  origin_artifact_id: string = 0;
  source_part: string = 1;
  descriptor: PageDescriptor = 2;
  presentation_subject: CatalogPresentationSubject = 3;
}

struct PageDiagnostic(811300007) {
  code: string = 0;
  message: string = 1;
  origin_artifact_id: string? = 2;
  source_part: string? = 3;
  declaration_name: string? = 4;
  type: ResolvedTypeRef? = 5;
}
