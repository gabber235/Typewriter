import {
  BindingId,
  BindingRef,
} from "editor/v1/binding.skir";
import {
  ConversionId,
  TypeExpression,
  TypedValue,
} from "editor/v1/type_catalog.skir";

enum ComparisonOperator(810700001) {
  equal = 1;
  not_equal = 2;
  less_than = 3;
  less_than_or_equal = 4;
  greater_than = 5;
  greater_than_or_equal = 6;
}

enum BooleanOperator(810700002) {
  and = 1;
  or = 2;
  not = 3;
}

enum ArithmeticOperator(810700003) {
  add = 1;
  subtract = 2;
  multiply = 3;
  divide = 4;
  remainder = 5;
  negate = 6;
}

struct FieldAccessExpression(810700004) {
  target: TypedExpression = 0;
  field_name: string = 1;
}

enum InterpolationPart(810700005) {
  text: string = 1;
  expression: TypedExpression = 2;
}

struct InterpolationExpression(810700006) {
  parts: [InterpolationPart] = 0;
}

struct ComparisonExpression(810700007) {
  operator: ComparisonOperator = 0;
  left: TypedExpression = 1;
  right: TypedExpression = 2;
}

struct BooleanExpression(810700008) {
  operator: BooleanOperator = 0;
  operands: [TypedExpression] = 1;
}

struct ArithmeticExpression(810700009) {
  operator: ArithmeticOperator = 0;
  operands: [TypedExpression] = 1;
}

struct ConditionalExpression(810700010) {
  condition: TypedExpression = 0;
  when_true: TypedExpression = 1;
  when_false: TypedExpression = 2;
}

struct CollectionProjectionExpression(810700011) {
  source: TypedExpression = 0;
  projection: TypedExpression = 1;
  item_binding_id: BindingId = 2;
}

struct ConversionExpression(810700012) {
  conversion_id: ConversionId = 0;
  input: TypedExpression = 1;
}

enum Expression(810700013) {
  literal: TypedValue = 1;
  binding: BindingRef = 2;
  field_access: FieldAccessExpression = 3;
  interpolation: InterpolationExpression = 4;
  comparison: ComparisonExpression = 5;
  boolean_operation: BooleanExpression = 6;
  arithmetic: ArithmeticExpression = 7;
  conditional: ConditionalExpression = 8;
  collection_projection: CollectionProjectionExpression = 9;
  conversion: ConversionExpression = 10;
}

struct TypedExpression(810700014) {
  result_type: TypeExpression = 0;
  expression: Expression? = 1;
}
