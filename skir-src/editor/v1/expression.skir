import {
  DataValue,
  ExpressionBindingId,
  OperationId,
  TypeUse,
  ValueLocation,
  ValuePath,
} from "editor/v1/type_catalog.skir";

struct ExpressionRead(810600001) {
  binding: ExpressionBindingId = 0;
  path: ValuePath = 1;
}

struct ExpressionCall(810600002) {
  operation: OperationId = 0;
  arguments: [ExpressionNode] = 1;
}

struct BinaryExpression(810600003) {
  left: ExpressionNode = 0;
  right: ExpressionNode = 1;
}

struct ConditionalExpression(810600004) {
  test: ExpressionNode = 0;
  yes: ExpressionNode = 1;
  no: ExpressionNode = 2;
}

struct OrElseExpression(810600005) {
  input: ExpressionNode = 0;
  fallback: ExpressionNode = 1;
}

struct CollectionExpression(810600006) {
  operation: OperationId = 0;
  input: ExpressionNode = 1;
  bindings: [ExpressionBindingId] = 2;
  arguments: [ExpressionNode] = 3;
  body: ExpressionNode? = 4;
}

enum ExpressionNode(810600007) {
  literal: DataValue = 1;
  read: ExpressionRead = 2;
  call: ExpressionCall = 3;
  and: BinaryExpression = 4;
  or: BinaryExpression = 5;
  conditional: ConditionalExpression = 6;
  or_else: OrElseExpression = 7;
  collection: CollectionExpression = 8;
}

struct ExpressionType(810600008) {
  value: TypeUse = 0;
  may_be_missing: bool = 1;
}

struct OperationDescriptor(810600009) {
  id: OperationId = 0;
  input: [ExpressionType] = 1;
  result: ExpressionType = 2;
}

struct EvaluationBudget(810600010) {
  max_steps: int64 = 0;
  max_collection_items: int64 = 1;
}

struct ExpressionBinding(810600011) {
  id: ExpressionBindingId = 0;
  location: ValueLocation = 1;
}

struct ExpressionBindings(810600012) {
  values: [ExpressionBinding] = 0;
}

struct EvaluationDiagnostic(810600013) {
  code: string = 0;
  message: string = 1;
  locations: [ValueLocation] = 2;
}
