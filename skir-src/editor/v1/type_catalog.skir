// The editor type catalog is the shared vocabulary for declarations, resolved references, typed values, and
// constraints.
// Catalog consumers validate references and values locally, then use the same definitions to decode presentations,
// capabilities, and conversions. A resolved reference identifies a declaration revision plus its type arguments.

import { Duration } from "kernel/v1/duration.skir";

enum BuiltinTypeId(810100001) {
  option = 1;
  some = 2;
  none = 3;
}

struct DeclaredTypeId(810100002) {
  value: string = 0;
}

struct QualifiedTypeId(810100003) {
  namespace: string = 0;
  name: string = 1;
}

enum TypeId(810100004) {
  builtin: BuiltinTypeId = 1;
  declared: DeclaredTypeId = 2;
  qualified: QualifiedTypeId = 3;
}

enum TypeVariance(810100005) {
  invariant = 1;
  covariant = 2;
  contravariant = 3;
}

enum IntegerWidth(810100006) {
  eight_bits = 1;
  sixteen_bits = 2;
  thirty_two_bits = 3;
  sixty_four_bits = 4;
}

enum FloatWidth(810100007) {
  thirty_two_bits = 1;
  sixty_four_bits = 2;
}

struct StringConstraints(810100008) {
  minimum_length: int32? = 0;
  maximum_length: int32? = 1;
  pattern: string? = 2;
  allowed_values: [string] = 3;
}

struct NumericConstraints(810100009) {
  minimum: string? = 0;
  minimum_inclusive: bool = 1;
  maximum: string? = 2;
  maximum_inclusive: bool = 3;
  multiple_of: string? = 4;
}

struct CollectionConstraints(810100010) {
  minimum_length: int32? = 0;
  maximum_length: int32? = 1;
  unique_items: bool = 2;
}

struct ResolvedTypeRef(810100011) {
  type_id: TypeId = 0;
  revision: int32 = 1;
  arguments: [TypeExpression] = 2;
}

struct TypedRecordField(810200001) {
  name: string = 0;
  value: TypedValue = 1;
}

struct TypedRecordValue(810200002) {
  fields: [TypedRecordField|name] = 0;
}

struct TypedMapEntry(810200003) {
  key: TypedValue = 0;
  value: TypedValue = 1;
}

struct TypedMapValue(810200004) {
  entries: [TypedMapEntry] = 0;
}

struct TypedNamedValue(810200005) {
  tag: ResolvedTypeRef = 0;
  payload: TypedValue = 1;
}

struct TypedDurationValue(810200006) {
  duration: Duration = 0;
}

/// Opaque authored resource identity. Consumers compare it and never parse it.
struct ResourceId(810200008) {
  value: string = 0;
}

enum TypedValue(810200007) {
  unit = 1;
  boolean: bool = 2;
  string: string = 3;
  bytes: bytes = 4;
  signed_eight: int32 = 5;
  signed_sixteen: int32 = 6;
  signed_thirty_two: int32 = 7;
  signed_sixty_four: int64 = 8;
  unsigned_eight: int32 = 9;
  unsigned_sixteen: int32 = 10;
  unsigned_thirty_two: int64 = 11;
  unsigned_sixty_four: string = 12;
  float_thirty_two: float32 = 13;
  float_sixty_four: float64 = 14;
  decimal: string = 15;
  timestamp: timestamp = 16;
  list: [TypedValue] = 17;
  map: TypedMapValue = 18;
  record: TypedRecordValue = 19;
  named: TypedNamedValue = 20;
  duration: TypedDurationValue = 21;
  reference: ResourceId = 22;
}

struct ListType(810100012) {
  element: TypeExpression = 0;
  constraints: CollectionConstraints = 1;
}

struct MapType(810100013) {
  key: TypeExpression = 0;
  value: TypeExpression = 1;
  constraints: CollectionConstraints = 2;
}

struct RecordField(810100014) {
  name: string = 0;
  value_type: TypeExpression = 1;
  initializer: TypedValue? = 2;
  defaulted: bool = 3;
}

struct RecordType(810100015) {
  fields: [RecordField|name] = 0;
  closed: bool = 1;
}

struct IntegerType(810100016) {
  width: IntegerWidth = 0;
  constraints: NumericConstraints = 1;
}

struct FloatType(810100017) {
  width: FloatWidth = 0;
  constraints: NumericConstraints = 1;
}

struct EnumType(810100018) {
  value_type: TypeExpression = 0;
  canonical_values: [TypedValue] = 1;
}

struct ReferenceType(810100029) {
  target_type: ResolvedTypeRef = 0;
}

enum TypeExpression(810100019) {
  any = 1;
  unit = 2;
  boolean = 3;
  string: StringConstraints = 4;
  bytes: CollectionConstraints = 5;
  signed_integer: IntegerType = 6;
  unsigned_integer: IntegerType = 7;
  float: FloatType = 8;
  decimal: NumericConstraints = 9;
  timestamp = 10;
  duration = 11;
  list: ListType = 12;
  map: MapType = 13;
  record: RecordType = 14;
  enum_type: EnumType = 15;
  parameter: string = 16;
  named: ResolvedTypeRef = 17;
  reference: ReferenceType = 18;
}

struct TypeParameter(810100020) {
  name: string = 0;
  variance: TypeVariance = 1;
  upper_bounds: [TypeExpression] = 2;
}

enum TypeDefinitionKind(810100021) {
  concrete = 1;
  open_abstract = 2;
  sealed_abstract = 3;
}

struct PresentationId(810100022) {
  namespace: string = 0;
  name: string = 1;
}

struct ConversionId(810100023) {
  namespace: string = 0;
  name: string = 1;
}

struct CapabilityId(810100028) {
  value: string = 0;
}

struct CatalogGeneration(810900001) {
  value: string = 0;
}

struct NamedPresentation(810100025) {
  name: string = 0;
  presentation_id: PresentationId = 1;
}

// A semantic surface resolved independently for each nominal type. Consumers
// select the nearest associated ancestor for the requested role.
enum PresentationRole(810100030) {
  reference_summary = 1;
  reference_option = 2;
  catalog_option = 3;
  authoring_result = 4;
  page_tile = 5;
  graph_node = 6;
  inspector_header = 7;
}

struct RolePresentation(810100031) {
  role: PresentationRole = 0;
  presentation_id: PresentationId = 1;
}

enum FieldMergeStrategy(810100032) {
  set_membership = 1;
}

// Merge policy belongs to the canonical type declaration. Editors use it to
// reconcile an affected field without introducing resource specific paths.
struct FieldMergePolicy(810100033) {
  // Merge policies currently address record fields only. This avoids a schema
  // cycle between type definitions, typed map keys, and general data paths.
  field_path: [string] = 0;
  strategy: FieldMergeStrategy = 1;
}

struct TypeDefinition(810100026) {
  display_name: string = 0;
  parameters: [TypeParameter|name] = 1;
  direct_parents: [ResolvedTypeRef] = 2;
  representation: TypeExpression = 3;
  type_id: TypeId = 4;
  revision: int32 = 5;
  kind: TypeDefinitionKind = 6;
  default_presentation_id: PresentationId? = 7;
  named_presentations: [NamedPresentation|name] = 8;
  outgoing_conversion_ids: [ConversionId] = 9;
  role_presentations: [RolePresentation] = 10;
  field_merge_policies: [FieldMergePolicy] = 11;
  declaration_owner: string = 12;
  initializer: TypedValue? = 13;
}

struct TypeCatalog(810100027) {
  definitions: [TypeDefinition] = 0;
}
