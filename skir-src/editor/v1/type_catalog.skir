// Portable type declarations, applied schemas, and authored values form the shared model
// interpreted by Realm and panel code. Templates can contain declaration parameters;
// TypeUse contains closed applications. Authored values retain concrete named type evidence,
// stable collection identities, and unfinished input independently of native runtime objects.

import { Duration } from "kernel/v1/duration.skir";

struct DeclaredTypeId(810100001) {
  value: string = 0;
}
struct QualifiedTypeId(810100002) {
  namespace: string = 0;
  name: string = 1;
}
enum TypeId(810100003) {
  declared: DeclaredTypeId = 1;
  qualified: QualifiedTypeId = 2;
}
struct TypeDefinitionId(810100004) {
  type_id: TypeId = 0;
  revision: int32 = 1;
}
struct ParameterKey(810100005) {
  owner: TypeDefinitionId = 0;
  index: int32 = 1;
}

enum IntegerWidth(810100006) {
  signed_eight = 1;
  signed_sixteen = 2;
  signed_thirty_two = 3;
  signed_sixty_four = 4;
  unsigned_eight = 5;
  unsigned_sixteen = 6;
  unsigned_thirty_two = 7;
  unsigned_sixty_four = 8;
}
enum FloatWidth(810100007) {
  thirty_two = 1;
  sixty_four = 2;
}
struct IntegerScalar(810100008) {
  width: IntegerWidth = 0;
}
struct FloatScalar(810100009) {
  width: FloatWidth = 0;
}
enum ScalarKind(810100010) {
  unit = 1;
  boolean = 2;
  text = 3;
  bytes = 4;
  integer: IntegerScalar = 5;
  float: FloatScalar = 6;
  decimal = 7;
  timestamp = 8;
  duration = 9;
}

struct NamedTypeTemplate(810100011) {
  definition: TypeDefinitionId = 0;
  arguments: [TypeTemplate] = 1;
}
struct NullableTypeTemplate(810100012) {
  value: TypeTemplate = 0;
}
/// Declaration type expression that can retain references to parameters owned by a definition.
enum TypeTemplate(810100013) {
  parameter: ParameterKey = 1;
  named: NamedTypeTemplate = 2;
  nullable: NullableTypeTemplate = 3;
  scalar: ScalarKind = 4;
}
struct NamedTypeUse(810100014) {
  definition: TypeDefinitionId = 0;
  arguments: [TypeUse] = 1;
}
struct NullableTypeUse(810100015) {
  value: TypeUse = 0;
}
/// Closed type application with concrete arguments, suitable for resolution in a checked catalog.
enum TypeUse(810100016) {
  named: NamedTypeUse = 1;
  nullable: NullableTypeUse = 2;
  scalar: ScalarKind = 3;
}

struct TypeParameter(810100017) {
  key: ParameterKey = 0;
  name: string = 1;
  bounds: [TypeTemplate] = 2;
}
struct FieldOwner(810100018) {
  definition: TypeDefinitionId = 0;
  name: string = 1;
}
struct FieldDeclaration(810100019) {
  owner: FieldOwner = 0;
  type: TypeTemplate = 1;
  overrides: [FieldOwner] = 2;
  has_constructor_default: bool = 3;
}
enum CollectionKind(810100020) {
  list = 1;
  set = 2;
}
struct EnumVariant(810100021) {
  key: string = 0;
}
struct ScalarRepresentationTemplate(810100022) {
  kind: ScalarKind = 0;
}
struct RecordRepresentationTemplate(810100023) {
  fields: [FieldDeclaration] = 0;
  abstract: bool = 1;
}
struct SequenceRepresentationTemplate(810100024) {
  item: TypeTemplate = 0;
  kind: CollectionKind = 1;
}
struct MappingRepresentationTemplate(810100025) {
  key: TypeTemplate = 0;
  value: TypeTemplate = 1;
}
struct EnumerationRepresentationTemplate(810100026) {
  cases: [EnumVariant|key] = 0;
}
struct EndpointId(810100027) {
  value: string = 0;
}
struct LinkRepresentationTemplate(810100028) {
  endpoint: EndpointId = 0;
  target: TypeTemplate = 1;
}
enum RepresentationTemplate(810100029) {
  scalar: ScalarRepresentationTemplate = 1;
  record: RecordRepresentationTemplate = 2;
  sequence: SequenceRepresentationTemplate = 3;
  mapping: MappingRepresentationTemplate = 4;
  enumeration: EnumerationRepresentationTemplate = 5;
  link: LinkRepresentationTemplate = 6;
}
/// Canonical declaration meaning before application of generic arguments and inherited fields.
/// Display metadata, editor controls, and native constructors are owned by adjacent catalog services.
struct TypeDefinition(810100030) {
  id: TypeDefinitionId = 0;
  parameters: [TypeParameter] = 1;
  representation: RepresentationTemplate = 2;
  parents: [NamedTypeTemplate] = 3;
}

struct ResourceId(810100031) {
  value: string = 0;
}
/// Stable authored collection occurrence identity. Reordering preserves it; equal values can
/// still occupy different list positions or map rows with different identities.
struct ItemId(810100032) {
  value: string = 0;
}
/// Targets an authored resource and optionally the exact inverse value location.
/// An absent opposite path allows a relation authored on only one side.
struct LinkTarget(810100033) {
  resource: ResourceId = 0;
  opposite: ValuePath? = 1;
}
struct LinkValue(810100034) {
  endpoint: EndpointId = 0;
  target: LinkTarget = 1;
}
struct FieldValue(810100035) {
  name: string = 0;
  value: DataValue = 1;
}
struct RecordPayload(810100036) {
  fields: [FieldValue|name] = 0;
}
struct NamedValue(810100037) {
  actual_type: NamedTypeUse = 0;
  payload: DataValue = 1;
}
struct ListItem(810100038) {
  id: ItemId = 0;
  value: DataValue = 1;
}
struct ListPayload(810100039) {
  items: [ListItem] = 0;
}
struct MapRow(810100040) {
  id: ItemId = 0;
  key: DataValue = 1;
  value: DataValue = 2;
}
struct MapPayload(810100041) {
  rows: [MapRow] = 0;
}
struct DurationValue(810100042) {
  value: Duration = 0;
}
/// Portable authored content. unfilled means input is unfinished, while null is an explicit
/// nullable value. Named wrappers retain concrete type evidence; collection item identities
/// are independent of value equality. Schema and completeness checks apply separately.
enum DataValue(810100043) {
  unfilled = 1;
  null = 2;
  unit = 3;
  boolean: bool = 4;
  integer: string = 5;
  float: float64 = 6;
  decimal: string = 7;
  string_value: string = 8;
  bytes: bytes = 9;
  timestamp: timestamp = 10;
  duration: DurationValue = 11;
  enum_case: string = 12;
  record: RecordPayload = 13;
  named: NamedValue = 14;
  list_value: ListPayload = 15;
  set_value: ListPayload = 16;
  map_value: MapPayload = 17;
  link: LinkValue = 18;
}

enum ArgumentSelection(810100044) {
  chosen: TypeUse = 1;
  unfilled = 2;
}
struct PendingTypeSelection(810100045) {
  definition: TypeDefinitionId = 0;
  arguments: [ArgumentSelection] = 1;
}
/// A resource configuration can retain unfinished generic arguments without inventing a closed type.
/// Partial schema resolution exposes known fields while dependent fields await those arguments.
enum TypeSelection(810100046) {
  complete: NamedTypeUse = 1;
  pending: PendingTypeSelection = 2;
}
/// Canonical authored configuration and fields for one resource, before native construction.
/// It can be structurally valid while containing unfinished input that blocks publication.
struct AuthoringRecord(810100047) {
  configuration: TypeSelection = 0;
  fields: [FieldValue|name] = 1;
}

struct PresentationId(810100048) {
  namespace: string = 0;
  name: string = 1;
}
struct ConversionId(810100049) {
  namespace: string = 0;
  name: string = 1;
}
struct CapabilityId(810100050) {
  value: string = 0;
}
/// Opaque identity for one assembled catalog incarnation. Compare for equality, not ordering;
/// resource observations and publication identities have separate lifecycles.
struct CatalogGeneration(810100051) {
  value: string = 0;
}
struct InputToken(810100052) {
  value: string = 0;
}
struct ExpressionBindingId(810100053) {
  value: string = 0;
}
struct RuleOrigin(810100054) {
  owner: TypeDefinitionId = 0;
  ordinal: int32 = 1;
}
struct RuleId(810100055) {
  origin: RuleOrigin = 0;
  local_index: int32 = 1;
}

/// Exact path within one resource or bound value. Collection segments use stable item identity,
/// and map_key or map_value selects a branch after the map row item segment.
struct ValuePath(810100056) {
  segments: [PathSegment] = 0;
}
struct FieldPathSegment(810100057) {
  name: string = 0;
}
struct ItemPathSegment(810100058) {
  id: ItemId = 0;
}
enum PathSegment(810100059) {
  field: FieldPathSegment = 1;
  item: ItemPathSegment = 2;
  map_key = 3;
  map_value = 4;
}
struct ValueLocation(810100060) {
  resource: ResourceId = 0;
  path: ValuePath = 1;
}
struct NamedFieldPatternSegment(810100061) {
  name: string = 0;
}
enum FieldPatternSegment(810100062) {
  field: NamedFieldPatternSegment = 1;
  items = 2;
  keys = 3;
  values = 4;
}
/// Schema pattern expanded against an owning occurrence. Collection wildcards describe many
/// concrete value paths and do not themselves identify an editable item.
struct RelativeFieldPattern(810100063) {
  segments: [FieldPatternSegment] = 0;
}
struct NativeBindingId(810100064) {
  value: string = 0;
}
struct CheckExecutionId(810100065) {
  value: string = 0;
}
struct DiagnosticId(810100066) {
  value: string = 0;
}
struct SelectionId(810100067) {
  value: string = 0;
}
struct PublicationId(810100068) {
  value: string = 0;
}
struct CanonicalValueHash(810100069) {
  value: string = 0;
}
struct RelationId(810100070) {
  value: string = 0;
}
struct RelationFamilyId(810100071) {
  value: string = 0;
}

struct ScalarResolvedRepresentation(810100073) {
  kind: ScalarKind = 0;
}
struct RecordResolvedRepresentation(810100074) {
  fields: [ResolvedField|key] = 0;
  abstract: bool = 1;
}
struct SequenceResolvedRepresentation(810100075) {
  item: TypeUse = 0;
  kind: CollectionKind = 1;
}
struct MappingResolvedRepresentation(810100076) {
  key: TypeUse = 0;
  value: TypeUse = 1;
}
struct EnumerationResolvedRepresentation(810100077) {
  cases: [EnumVariant|key] = 0;
}
struct LinkResolvedRepresentation(810100078) {
  endpoint: EndpointId = 0;
  target: TypeUse = 1;
}
enum ResolvedRepresentation(810100079) {
  scalar: ScalarResolvedRepresentation = 1;
  record: RecordResolvedRepresentation = 2;
  sequence: SequenceResolvedRepresentation = 3;
  mapping: MappingResolvedRepresentation = 4;
  enumeration: EnumerationResolvedRepresentation = 5;
  link: LinkResolvedRepresentation = 6;
}
struct ResolvedField(810100080) {
  key: string = 0;
  declaration_owner: TypeDefinitionId = 1;
  type: TypeUse = 2;
  guarantees: [RuleId] = 3;
}
struct AppliedSchema(810100081) {
  use: TypeUse = 0;
  representation: ResolvedRepresentation = 1;
  fields: [ResolvedField|key] = 2;
  ancestors: [NamedTypeUse] = 3;
}
/// Applied type evidence bound to a specific checked catalog generation.
/// A resolved schema is separate from proving that a particular authored value is complete.
struct CheckedType(810100082) {
  catalog: CatalogGeneration = 0;
  use: TypeUse = 1;
  schema: AppliedSchema = 2;
}
struct ArgumentLocation(810100083) {
  index: int32 = 0;
}
struct DependentField(810100084) {
  owner: FieldOwner = 0;
  type: TypeTemplate = 1;
  missing: [ParameterKey] = 2;
}
struct PartialSchema(810100085) {
  known_fields: [ResolvedField|key] = 0;
  dependent_fields: [DependentField] = 1;
  pending_arguments: [ArgumentLocation] = 2;
}

struct ContributionSourceId(810100086) {
  value: string = 0;
}
struct ProducerId(810100087) {
  value: string = 0;
}
struct ContributionName(810100088) {
  value: string = 0;
}
struct ContributionKey(810100089) {
  source: ContributionSourceId = 0;
  source_part: string = 1;
  producer: ProducerId = 2;
  name: ContributionName = 3;
}
struct DeclarationOwner(810100090) {
  source: ContributionKey = 0;
  local_identity: string = 1;
}
