// Portable type declarations, applied schemas, and authored values form the shared model
// interpreted by Realm and panel code. Templates can contain declaration parameters;
// TypeUse contains closed applications. Authored values retain concrete named type evidence,
// stable collection identities, and unfinished input independently of native runtime objects.

import { Duration } from "kernel/v1/duration.skir";
import { ResourceId } from "kernel/v1/resource_id.skir";

struct DeclaredTypeId(84180001) {
  value: string = 0;
}
struct QualifiedTypeId(84180002) {
  namespace: string = 0;
  name: string = 1;
}
/// A case of a closed record, named inside the record that lists it.
struct MemberTypeId(84180003) {
  owner: TypeId = 0;
  name: string = 1;
}
/// Names a type a resource declares. A declaration always has a generated key, which survives a
/// reorder, a rename and a retype. A field key appears only in a use and means whatever that field
/// of the resource holds: a declaration by its generated key, or a plain type such as an alias.
enum ContentKey(84180004) {
  generated: string = 1;
  field: string = 2;
}
/// A type declared by content: the resource that declares it and its key there.
struct ContentTypeId(84180005) {
  resource: ResourceId = 0;
  key: ContentKey = 1;
}
enum TypeId(84180006) {
  declared: DeclaredTypeId = 1;
  qualified: QualifiedTypeId = 2;
  member: MemberTypeId = 3;
  content: ContentTypeId = 4;
}
struct TypeDefinitionId(84180007) {
  type_id: TypeId = 0;
  revision: int32 = 1;
}
struct ParameterKey(84180008) {
  owner: TypeDefinitionId = 0;
  index: int32 = 1;
}

enum IntegerWidth(84180009) {
  signed_eight = 1;
  signed_sixteen = 2;
  signed_thirty_two = 3;
  signed_sixty_four = 4;
  unsigned_eight = 5;
  unsigned_sixteen = 6;
  unsigned_thirty_two = 7;
  unsigned_sixty_four = 8;
}
enum FloatWidth(84180010) {
  thirty_two = 1;
  sixty_four = 2;
}
struct IntegerScalar(84180011) {
  width: IntegerWidth = 0;
}
struct FloatScalar(84180012) {
  width: FloatWidth = 0;
}
enum ScalarKind(84180013) {
  unit = 1;
  boolean = 2;
  text = 3;
  bytes = 4;
  integer: IntegerScalar = 5;
  float: FloatScalar = 6;
  decimal = 7;
  timestamp = 8;
  duration = 9;
  /// A value that is itself a type, stored as a type_use value.
  type = 10;
}

struct NamedTypeTemplate(84180014) {
  definition: TypeDefinitionId = 0;
  arguments: [TypeTemplate] = 1;
}
struct NullableTypeTemplate(84180015) {
  value: TypeTemplate = 0;
}
/// A named slot of a function type template. Names are part of the type.
struct FunctionParameterTemplate(84180016) {
  name: string = 0;
  type: TypeTemplate = 1;
}
/// A function type before generic application. Context names what a body reads from its scope;
/// parameters are what a caller passes. A function type has no definition id: its stored form is
/// the Formula record.
struct FunctionTypeTemplate(84180017) {
  context: [FunctionParameterTemplate|name] = 0;
  parameters: [FunctionParameterTemplate|name] = 1;
  result: TypeTemplate = 2;
}
/// Declaration type expression that can retain references to parameters owned by a definition.
enum TypeTemplate(84180018) {
  parameter: ParameterKey = 1;
  named: NamedTypeTemplate = 2;
  nullable: NullableTypeTemplate = 3;
  scalar: ScalarKind = 4;
  function: FunctionTypeTemplate = 5;
}
struct NamedTypeUse(84180019) {
  definition: TypeDefinitionId = 0;
  arguments: [TypeUse] = 1;
}
struct NullableTypeUse(84180020) {
  value: TypeUse = 0;
}
/// A named slot of a function type. Names are part of the type.
struct FunctionParameterUse(84180021) {
  name: string = 0;
  type: TypeUse = 1;
}
/// A structural function type. Two function types are the same only when their context,
/// parameter names and types, and result agree. Its stored schema is the Formula record.
struct FunctionTypeUse(84180022) {
  context: [FunctionParameterUse|name] = 0;
  parameters: [FunctionParameterUse|name] = 1;
  result: TypeUse = 2;
}
/// Closed type application with concrete arguments, suitable for resolution in a checked catalog.
enum TypeUse(84180023) {
  named: NamedTypeUse = 1;
  nullable: NullableTypeUse = 2;
  scalar: ScalarKind = 3;
  function: FunctionTypeUse = 4;
}

struct TypeParameter(84180024) {
  key: ParameterKey = 0;
  name: string = 1;
  bounds: [TypeTemplate] = 2;
}
struct FieldOwner(84180025) {
  definition: TypeDefinitionId = 0;
  name: string = 1;
}
struct FieldDeclaration(84180026) {
  owner: FieldOwner = 0;
  type: TypeTemplate = 1;
  overrides: [FieldOwner] = 2;
  has_constructor_default: bool = 3;
}
enum CollectionKind(84180027) {
  list = 1;
  set = 2;
}
struct ScalarRepresentationTemplate(84180028) {
  kind: ScalarKind = 0;
}
/// The only subtypes of a closed record, in declaration order. An enum is a closed record whose
/// cases are all unit.
struct ClosedCases(84180029) {
  cases: [NamedTypeTemplate] = 0;
}
/// A concrete record has values of its own. An open record accepts any subtype that names it as
/// a parent; a closed record accepts only the cases it lists.
enum RecordForm(84180030) {
  concrete = 1;
  open = 2;
  closed: ClosedCases = 3;
}
struct RecordRepresentationTemplate(84180031) {
  fields: [FieldDeclaration] = 0;
  form: RecordForm = 1;
}
struct SequenceRepresentationTemplate(84180032) {
  item: TypeTemplate = 0;
  kind: CollectionKind = 1;
}
struct MappingRepresentationTemplate(84180033) {
  key: TypeTemplate = 0;
  value: TypeTemplate = 1;
}
struct EndpointId(84180034) {
  value: string = 0;
}
struct LinkRepresentationTemplate(84180035) {
  endpoint: EndpointId = 0;
  target: TypeTemplate = 1;
}
enum RepresentationTemplate(84180036) {
  scalar: ScalarRepresentationTemplate = 1;
  record: RecordRepresentationTemplate = 2;
  sequence: SequenceRepresentationTemplate = 3;
  mapping: MappingRepresentationTemplate = 4;
  link: LinkRepresentationTemplate = 5;
}
/// Canonical declaration meaning before application of generic arguments and inherited fields.
/// Display metadata, editor controls, and native constructors are owned by adjacent catalog services.
struct TypeDefinition(84180037) {
  id: TypeDefinitionId = 0;
  parameters: [TypeParameter] = 1;
  representation: RepresentationTemplate = 2;
  parents: [NamedTypeTemplate] = 3;
}

/// Stable authored collection occurrence identity. Reordering preserves it; equal values can
/// still occupy different list positions or map rows with different identities.
struct ItemId(84180038) {
  value: string = 0;
}
/// Targets an authored resource and optionally the exact inverse value location.
/// An absent opposite path allows a relation authored on only one side.
struct LinkTarget(84180039) {
  resource: ResourceId = 0;
  opposite: ValuePath? = 1;
}
struct LinkValue(84180040) {
  endpoint: EndpointId = 0;
  target: LinkTarget = 1;
}
struct FieldValue(84180041) {
  name: string = 0;
  value: DataValue = 1;
}
struct RecordPayload(84180042) {
  fields: [FieldValue|name] = 0;
}
struct NamedValue(84180043) {
  actual_type: NamedTypeUse = 0;
  payload: DataValue = 1;
}
struct ListItem(84180044) {
  id: ItemId = 0;
  value: DataValue = 1;
}
struct ListPayload(84180045) {
  items: [ListItem] = 0;
}
struct MapRow(84180046) {
  id: ItemId = 0;
  key: DataValue = 1;
  value: DataValue = 2;
}
struct MapPayload(84180047) {
  rows: [MapRow] = 0;
}
struct DurationValue(84180048) {
  value: Duration = 0;
}
/// Portable authored content. unfilled means input is unfinished, while null is an explicit
/// nullable value. Named wrappers retain concrete type evidence; collection item identities
/// are independent of value equality. Schema and completeness checks apply separately.
enum DataValue(84180049) {
  unfilled = 1;
  null = 2;
  unit = 3;
  boolean: bool = 4;
  integer: string = 5;
  float: float64 = 6;
  decimal: string = 7;
  string_value: string = 8;
  bytes: bytes = 9;
  timestamp: timestamp = 10;
  duration: DurationValue = 11;
  record: RecordPayload = 12;
  named: NamedValue = 13;
  list_value: ListPayload = 14;
  set_value: ListPayload = 15;
  map_value: MapPayload = 16;
  link: LinkValue = 17;
  /// A type held as a value, such as a Definition of Type. Its declarations live on the same
  /// resource's types list.
  type_use: TypeUse = 18;
}

enum ArgumentSelection(84180050) {
  chosen: TypeUse = 1;
  unfilled = 2;
}
struct PendingTypeSelection(84180051) {
  definition: TypeDefinitionId = 0;
  arguments: [ArgumentSelection] = 1;
}
/// A resource configuration can retain unfinished generic arguments without inventing a closed type.
/// Partial schema resolution exposes known fields while dependent fields await those arguments.
enum TypeSelection(84180052) {
  complete: NamedTypeUse = 1;
  pending: PendingTypeSelection = 2;
}
/// Canonical authored configuration and fields for one resource, before native construction.
/// It can be structurally valid while containing unfinished input that blocks publication.
struct AuthoringRecord(84180053) {
  configuration: TypeSelection = 0;
  fields: [FieldValue|name] = 1;
  /// The types this resource declares, each with a content id on this resource.
  types: [TypeDefinition] = 2;
}

struct PresentationId(84180054) {
  namespace: string = 0;
  name: string = 1;
}
struct ConversionId(84180055) {
  namespace: string = 0;
  name: string = 1;
}
struct CapabilityId(84180056) {
  value: string = 0;
}
/// Opaque identity for one assembled catalog incarnation. Compare for equality, not ordering;
/// resource observations and publication identities have separate lifecycles.
struct CatalogGeneration(84180057) {
  value: string = 0;
}
struct InputToken(84180058) {
  value: string = 0;
}
struct ExpressionBindingId(84180059) {
  value: string = 0;
}
struct RuleOrigin(84180060) {
  owner: TypeDefinitionId = 0;
  ordinal: int32 = 1;
}
struct RuleId(84180061) {
  origin: RuleOrigin = 0;
  local_index: int32 = 1;
}

/// Exact path within one resource or bound value. Collection segments use stable item identity,
/// and map_key or map_value selects a branch after the map row item segment.
struct ValuePath(84180062) {
  segments: [PathSegment] = 0;
}
struct FieldPathSegment(84180063) {
  name: string = 0;
}
struct ItemPathSegment(84180064) {
  id: ItemId = 0;
}
enum PathSegment(84180065) {
  field: FieldPathSegment = 1;
  item: ItemPathSegment = 2;
  map_key = 3;
  map_value = 4;
}
struct ValueLocation(84180066) {
  resource: ResourceId = 0;
  path: ValuePath = 1;
}
struct NamedFieldPatternSegment(84180067) {
  name: string = 0;
}
enum FieldPatternSegment(84180068) {
  field: NamedFieldPatternSegment = 1;
  items = 2;
  keys = 3;
  values = 4;
}
/// Schema pattern expanded against an owning occurrence. Collection wildcards describe many
/// concrete value paths and do not themselves identify an editable item.
struct RelativeFieldPattern(84180069) {
  segments: [FieldPatternSegment] = 0;
}
struct NativeBindingId(84180070) {
  value: string = 0;
}
struct CheckExecutionId(84180071) {
  value: string = 0;
}
struct DiagnosticId(84180072) {
  value: string = 0;
}
struct SelectionId(84180073) {
  value: string = 0;
}
struct PublicationId(84180074) {
  value: string = 0;
}
struct CanonicalValueHash(84180075) {
  value: string = 0;
}
struct RelationId(84180076) {
  value: string = 0;
}
struct RelationFamilyId(84180077) {
  value: string = 0;
}

struct ScalarResolvedRepresentation(84180078) {
  kind: ScalarKind = 0;
}
struct ResolvedClosedCases(84180079) {
  cases: [NamedTypeUse] = 0;
}
enum ResolvedRecordForm(84180080) {
  concrete = 1;
  open = 2;
  closed: ResolvedClosedCases = 3;
}
struct RecordResolvedRepresentation(84180081) {
  fields: [ResolvedField|key] = 0;
  form: ResolvedRecordForm = 1;
}
struct SequenceResolvedRepresentation(84180082) {
  item: TypeUse = 0;
  kind: CollectionKind = 1;
}
struct MappingResolvedRepresentation(84180083) {
  key: TypeUse = 0;
  value: TypeUse = 1;
}
struct LinkResolvedRepresentation(84180084) {
  endpoint: EndpointId = 0;
  target: TypeUse = 1;
}
enum ResolvedRepresentation(84180085) {
  scalar: ScalarResolvedRepresentation = 1;
  record: RecordResolvedRepresentation = 2;
  sequence: SequenceResolvedRepresentation = 3;
  mapping: MappingResolvedRepresentation = 4;
  link: LinkResolvedRepresentation = 5;
}
struct ResolvedField(84180086) {
  key: string = 0;
  declaration_owner: TypeDefinitionId = 1;
  type: TypeUse = 2;
  guarantees: [RuleId] = 3;
}
struct AppliedSchema(84180087) {
  use: TypeUse = 0;
  representation: ResolvedRepresentation = 1;
  fields: [ResolvedField|key] = 2;
  ancestors: [NamedTypeUse] = 3;
}
/// Applied type evidence bound to a specific checked catalog generation.
/// A resolved schema is separate from proving that a particular authored value is complete.
struct CheckedType(84180088) {
  catalog: CatalogGeneration = 0;
  use: TypeUse = 1;
  schema: AppliedSchema = 2;
}
struct ArgumentLocation(84180089) {
  index: int32 = 0;
}
struct DependentField(84180090) {
  owner: FieldOwner = 0;
  type: TypeTemplate = 1;
  missing: [ParameterKey] = 2;
}
struct PartialSchema(84180091) {
  known_fields: [ResolvedField|key] = 0;
  dependent_fields: [DependentField] = 1;
  pending_arguments: [ArgumentLocation] = 2;
}

struct ContributionSourceId(84180092) {
  value: string = 0;
}
struct ProducerId(84180093) {
  value: string = 0;
}
struct ContributionName(84180094) {
  value: string = 0;
}
struct ContributionKey(84180095) {
  source: ContributionSourceId = 0;
  source_part: string = 1;
  producer: ProducerId = 2;
  name: ContributionName = 3;
}
struct DeclarationOwner(84180096) {
  source: ContributionKey = 0;
  local_identity: string = 1;
}

/// Which resources a display or operation applies to: every application of one type template,
/// or every resource when nothing more specific is declared.
enum ResourceTarget(84180097) {
  type: TypeTemplate = 1;
  any_resource = 2;
}
