// The editor catalog publishes checked authoring declarations and portable presentation
// material from one Realm catalog generation. It describes what clients can author and
// how to present it; executable callbacks remain owned by the Realm provider catalog.
// Saved resources reference these declarations and must be interpreted under that generation.

import { CapabilityDefinition } from "editor/v1/capability.skir";
import {
  DeclarationDiagnostic,
  DiagnosticTemplate,
  InitializationDiagnostic,
} from "editor/v1/diagnostic.skir";
import { ExpressionNode } from "editor/v1/expression.skir";
import { ResourceOperationDefinition } from "editor/v1/operation.skir";
import {
  PresentationDependencies,
  PresentationNode,
} from "editor/v1/presentation.skir";
import {
  AuthoringRecord,
  CatalogGeneration,
  DataValue,
  DeclarationOwner,
  EndpointId,
  FieldOwner,
  NamedTypeTemplate,
  NamedTypeUse,
  PresentationId,
  RelationFamilyId,
  RelationId,
  RelativeFieldPattern,
  ResourceTarget,
  RuleId,
  RuleOrigin,
  TypeDefinition,
  TypeDefinitionId,
  TypeSelection,
  TypeTemplate,
  TypeUse,
  ValuePath,
} from "editor/v1/type_catalog.skir";
import { Color } from "kernel/v1/color.skir";
import { InternalError } from "kernel/v1/errors.skir";
import { Icon } from "kernel/v1/icon.skir";

/// Name, accent and icon formulas for resources of [target]. Each formula reads only the subject
/// resource: its fields and its published type through the configured value binding.
struct ResourceDisplayFormulas(84060001) {
  target: ResourceTarget = 0;
  label: ExpressionNode = 1;
  accent: ExpressionNode = 2;
  icon: ExpressionNode = 3;
}

enum RelationDeletePolicy(84060002) {
  restrict = 1;
  cascade = 2;
  clear = 3;
}

enum EndpointSlot(84060003) {
  first = 1;
  second = 2;
}

enum EndpointCardinality(84060004) {
  one = 1;
  many = 2;
}

/// Declares one side of a relation. Cardinality constrains how many resources on this side
/// one opposite resource can reference. on_delete applies when a resource on this side is deleted.
struct EndpointDefinition(84060005) {
  id: EndpointId = 0;
  slot: EndpointSlot = 1;
  resource: NamedTypeTemplate = 2;
  cardinality: EndpointCardinality = 3;
  on_delete: RelationDeletePolicy = 4;
}

/// Shared relation meaning used to validate authored references and derive graph edges.
/// Families attach shared semantics such as ownership without relying on presentation names.
struct RelationContract(84060006) {
  id: RelationId = 0;
  first: EndpointDefinition = 1;
  second: EndpointDefinition = 2;
  families: [RelationFamilyId] = 3;
}

/// The family of relations whose one owner endpoint holds the resources on its many member endpoint,
/// such as a Book holding its pages. Every owned resource has one owner, and ownership never loops.
const RESOURCE_OWNERSHIP_FAMILY: RelationFamilyId = {
  value: "resource.ownership",
};

enum DeclarationStatus(84060007) {
  ready = 1;
  unavailable: [DeclarationDiagnostic] = 2;
}

struct EffectiveFieldTemplate(84060008) {
  key: string = 0;
  owner: FieldOwner = 1;
  type: TypeTemplate = 2;
  rules: [RuleId] = 3;
}

struct PublishedType(84060009) {
  definition: TypeDefinition = 0;
  status: DeclarationStatus = 1;
  effective_fields: [EffectiveFieldTemplate|key] = 2;
  ancestor_templates: [NamedTypeTemplate] = 3;
  display: TypeDisplay = 4;
  /// Search scope keyword for resources of this type, such as book in book:"Main story".
  /// Present for every resource type except the realm root and its sections, which every
  /// resource sits inside, and absent for every other type.
  search_key: string? = 5;
  /// The single effective field typed as a placement, which editors and Realm read and write
  /// when they lay out resources of this type. Absent when the type declares no placement.
  placement_field: ValuePath? = 6;
}

struct TypeDisplay(84060010) {
  name: string = 0;
  description: string = 1;
  icon: Icon = 2;
  color: Color = 3;
}

enum RepresentationKind(84060011) {
  unit = 1;
  boolean = 2;
  text = 3;
  bytes = 4;
  integer = 5;
  float = 6;
  decimal = 7;
  timestamp = 8;
  duration = 9;
  record = 10;
  list = 11;
  set = 12;
  map = 13;
  enumeration = 14;
  link = 15;
}

struct RuleDescriptor(84060012) {
  predicate: ExpressionNode = 0;
}

struct OwnedRule(84060013) {
  id: RuleId = 0;
  descriptor: RuleDescriptor = 1;
  diagnostic: DiagnosticTemplate = 2;
}

struct ConfigurationRecipe(84060014) {
  origin: RuleOrigin = 0;
  relative_path: RelativeFieldPattern = 1;
  representation_condition: RepresentationKind? = 2;
  rules: [OwnedRule] = 3;
}

/// Places in the editor shell. A role names where content appears, never what it is.
/// Registering a role does not create a surface. Missing presentations follow the catalog's
/// explicit role fallbacks.
enum PresentationRole(84060015) {
  /// Main area of a resource route.
  workspace = 1;
  /// Side navigation: the realm root's navigator fills the shell sidebar; the nearest other
  /// owner declaring one fills the rail.
  navigator = 2;
  /// Editable properties in inspectors, editing review, and delegated field controls.
  inspector = 3;
  /// A resource laid out inside another place: grid card, graph node, list or tree row.
  item = 4;
  /// A compact preview of the selected reference target, with writes and input disabled.
  reference_preview = 5;
  /// A candidate target in a reference picker or a reference question during creation.
  reference_picker_result = 6;
  /// An existing resource shown in authoring search, with navigation owned by the result row.
  resource_search_result = 7;
}

enum PresentationTarget(84060016) {
  named: NamedTypeTemplate = 1;
  representation: RepresentationKind = 2;
}

struct PresentationDescriptor(84060017) {
  id: PresentationId = 0;
  owner: DeclarationOwner = 1;
  target: PresentationTarget = 2;
  roles: [PresentationRole] = 3;
  priority: int32 = 4;
}

/// Checked portable layout for a provider, target, and role. Dependencies describe required
/// services and typed inputs. inheritable_nodes identifies reusable inspector material rather
/// than granting inheritance to every node in the layout.
struct PresentationMaterial(84060018) {
  provider: PresentationId = 0;
  target: PresentationTarget = 1;
  role: PresentationRole = 2;
  layout: PresentationNode = 3;
  dependencies: PresentationDependencies = 4;
  subject: TypeTemplate = 5;
  inheritable_nodes: [string] = 6;
}

struct RoleFallback(84060019) {
  role: PresentationRole = 0;
  parents: [PresentationRole] = 1;
}

/// The complete editor catalog of one installed generation: one coherent set of authoring types,
/// relations, presentations, capabilities, and operations. Generation changes invalidate client
/// assumptions across the whole catalog; they are separate from saved resource observations and
/// selected compiled publications.
struct EditorCatalog(84060020) {
  generation: CatalogGeneration = 0;
  types: [PublishedType] = 1;
  relations: [RelationContract] = 2;
  resource_displays: [ResourceDisplayFormulas] = 3;
  presentations: [PresentationDescriptor] = 4;
  presentation_materials: [PresentationMaterial] = 5;
  configuration: [ConfigurationRecipe] = 6;
  diagnostics: [DeclarationDiagnostic] = 7;
  endpoint_bindings: [EndpointBindingTemplate] = 8;
  capabilities: [CapabilityDefinition] = 9;
  recommendations: [TypeRecommendation] = 10;
  role_fallbacks: [RoleFallback] = 11;
  resource_operations: [ResourceOperationDefinition] = 12;
  /// The realm root type. The realm keeps exactly one instance, which owns every section.
  realm_root: TypeDefinitionId = 13;
}

struct CatalogFetchRequest(84060021) {
  expected_generation: CatalogGeneration? = 0;
}

/// The installed catalog, or its actual generation when it differs from the expected one.
enum CatalogFetchResult(84060022) {
  catalog: EditorCatalog = 1;
  generation_changed_error: CatalogGeneration = 2;
  internal_error: InternalError = 3;
}

/// Announces the installed catalog generation so clients can fetch current declarations.
/// Delivery is an invalidation hint, rather than a durable history of catalog transitions.
struct CatalogInvalidated(84060023) {
  generation: CatalogGeneration = 0;
}

enum PreparationTarget(84060024) {
  value: TypeUse = 1;
  record: TypeSelection = 2;
}

struct ValuePreparationRequest(84060025) {
  catalog: CatalogGeneration = 0;
  target: PreparationTarget = 1;
  supplied_value: DataValue? = 2;
}

enum PreparedContent(84060026) {
  value: DataValue = 1;
  record: AuthoringRecord = 2;
}

/// Proposed editable content after value preparation. It may carry initialization findings;
/// preparation does not save a resource or establish that authored content is publishable.
struct PreparedValue(84060027) {
  content: PreparedContent = 0;
  findings: [InitializationDiagnostic] = 1;
}

struct RequiredInput(84060028) {
  path: ValuePath = 0;
  expected: TypeUse = 1;
}

/// Caller retained continuation for deferred constructor defaults and required input.
/// Resume validates catalog, target, pending default paths, and supplied answers. The runtime
/// retains no preparation session behind this value, and constructor sampling may execute provider code.
struct PreparationDraft(84060029) {
  catalog: CatalogGeneration = 0;
  target: PreparationTarget = 1;
  content: PreparedContent = 2;
  pending_defaults: [ValuePath] = 3;
  required_inputs: [RequiredInput] = 4;
  findings: [InitializationDiagnostic] = 5;
}

struct InputAnswer(84060030) {
  path: ValuePath = 0;
  value: DataValue = 1;
}

enum PreparationOperation(84060031) {
  start: ValuePreparationRequest = 1;
  resume: struct {
    draft: PreparationDraft = 0;
    answers: [InputAnswer] = 1;
  } = 2;
}

/// Separates prepared editable content from a continuation needing caller input or unavailable
/// preparation. ready describes completion of initialization, not saved authoring or publication.
enum PrepareValueResult(84060032) {
  ready: PreparedValue = 1;
  needs_input: PreparationDraft = 2;
  unavailable_error: PreparationDraft = 3;
  catalog_changed_error: CatalogGeneration = 4;
  internal_error: InternalError = 5;
}

struct EndpointBindingTemplate(84060033) {
  endpoint: EndpointId = 0;
  containing_resource: NamedTypeTemplate = 1;
  value_owner: TypeDefinitionId = 2;
  relative_path: RelativeFieldPattern = 3;
  target: TypeTemplate = 4;
  contains_collection: bool = 5;
}

struct TypeRecommendation(84060034) {
  type: NamedTypeUse = 0;
  occurrences: int64 = 1;
}

/// What the most specific [ResourceDisplayFormulas] of one resource evaluate to: its label, accent
/// and icon. Editors evaluate it and bind it to resource presentations as a read model; it is never
/// stored.
struct ResourceAppearance(84060035) {
  label: string = 0;
  accent: Color = 1;
  icon: Icon = 2;
}

method FetchEditorCatalog(
  CatalogFetchRequest
): CatalogFetchResult = 940601;

method WatchEditorCatalog(
  struct {}
): enum {
  invalidated: CatalogInvalidated = 1;
  internal_error: InternalError = 2;
} = 940602;

method PrepareValue(
  PreparationOperation
): PrepareValueResult = 940603;
