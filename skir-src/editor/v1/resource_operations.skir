// Resource operations resolve affordances and prepare proposed edits against the panel
// working observation. The Realm validates the confirmed saved baseline plus local overlay,
// then runs catalog owned preparation. A preview is staged by the client and committed
// through authoring admission separately.

import {
  AuthoringDiagnostic,
  AuthoringObservationId,
  CatalogChanged,
  CounterpartChoice,
  LinkOccurrence,
  PreparedEdit,
} from "editor/v1/authoring.skir";
import { InvocationId } from "editor/v1/capability.skir";
import {
  OperationConfirmation,
  ResolvedResourceOperations,
  ResourceOperationId,
} from "editor/v1/operation.skir";
import {
  AuthoringRecord,
  CapabilityId,
  CatalogGeneration,
  DataValue,
  ValuePath,
} from "editor/v1/type_catalog.skir";
import { InternalError } from "kernel/v1/errors.skir";
import { ResourceId } from "kernel/v1/resource_id.skir";

struct OperationOrigin(84160001) {
  container: ResourceId? = 0;
  occurrences: [LinkOccurrence] = 1;
}

/// Captures the operation selection and its exact origin occurrences under one catalog.
/// invocation_id correlates requests and supplies stable preparation allocation identity; it does
/// not make requests durable or guarantee server deduplication.
struct OperationInvocation(84160002) {
  invocation_id: InvocationId = 0;
  catalog: CatalogGeneration = 1;
  targets: [ResourceId] = 2;
  origin: OperationOrigin = 3;
}

struct OperationResourceUpsert(84160003) {
  resource: ResourceId = 0;
  content: AuthoringRecord = 1;
}

/// Proposed replacements and removals layered over the confirmed saved observation for this request.
/// These values are validated before callbacks run and are not saved by resolve or preparation.
struct OperationWorkingOverlay(84160004) {
  upserts: [OperationResourceUpsert] = 0;
  removals: [ResourceId] = 1;
}

/// Couples a local overlay to the saved observation it was built from. A stale observation must
/// be refreshed rather than silently applying the overlay to a different saved graph.
struct OperationWorkingContext(84160005) {
  confirmed_observation: AuthoringObservationId = 0;
  overlay: OperationWorkingOverlay = 1;
}

struct PreparationChoiceId(84160006) {
  value: string = 0;
}

struct PreparationSourceOption(84160007) {
  label: string = 0;
  occurrence: LinkOccurrence = 1;
}

struct PreparationCounterpartOption(84160008) {
  label: string = 0;
  counterpart: CounterpartChoice = 1;
}

enum PreparationChoice(84160009) {
  source: struct {
    choice_id: PreparationChoiceId = 0;
    label: string = 1;
    candidates: [PreparationSourceOption] = 2;
  } = 1;
  counterpart: struct {
    choice_id: PreparationChoiceId = 0;
    label: string = 1;
    source: LinkOccurrence = 2;
    candidates: [PreparationCounterpartOption] = 3;
  } = 2;
}

enum PreparationChoiceAnswer(84160010) {
  source: struct {
    choice_id: PreparationChoiceId = 0;
    occurrence: LinkOccurrence = 1;
  } = 1;
  counterpart: struct {
    choice_id: PreparationChoiceId = 0;
    counterpart: CounterpartChoice = 1;
  } = 2;
}

struct OperationInputProblem(84160011) {
  path: ValuePath = 0;
  code: string = 1;
  message: string = 2;
}

enum OperationSelectionEffect(84160012) {
  unchanged = 1;
  replace: [ResourceId] = 2;
}

struct StaleAuthoringObservation(84160013) {
  actual: AuthoringObservationId = 0;
}

struct ResourceOperationFailure(84160014) {
  diagnostics: [AuthoringDiagnostic] = 0;
}

struct ResolveResourceOperationsRequest(84160015) {
  invocation: OperationInvocation = 0;
  context: OperationWorkingContext = 1;
}

enum ResolveResourceOperationsResult(84160016) {
  resolved: ResolvedResourceOperations = 1;
  stale_observation_error: StaleAuthoringObservation = 2;
  invalid_error: ResourceOperationFailure = 3;
  catalog_changed_error: CatalogChanged = 4;
  permission_denied_error: ResourceOperationFailure = 5;
  failed_error: ResourceOperationFailure = 6;
  internal_error: InternalError = 7;
}

/// Replays preparation with current input and choice answers. input_revision orders client responses;
/// it is echoed in successful preparation results and is independent of saved resource versions.
struct PrepareAuthoringActionRequest(84160017) {
  invocation: OperationInvocation = 0;
  capability: CapabilityId = 1;
  context: OperationWorkingContext = 2;
  input_revision: int32 = 3;
  input: DataValue? = 4;
  choices: [PreparationChoiceAnswer] = 5;
}

struct AuthoringActionNeedsInput(84160018) {
  invocation_id: InvocationId = 0;
  input_revision: int32 = 1;
  normalized_input: DataValue? = 2;
  problems: [OperationInputProblem] = 3;
  choices: [PreparationChoice] = 4;
}

/// Proposed edit and client effects after preparation. Selection replacement applies when the
/// preview is staged; confirmation describes the proposed action and does not persist it.
struct AuthoringActionPreview(84160019) {
  invocation_id: InvocationId = 0;
  input_revision: int32 = 1;
  edit: PreparedEdit = 2;
  confirmation: OperationConfirmation? = 3;
  selection: OperationSelectionEffect = 4;
}

/// Separates missing interactive input from a usable preview, stale baseline, unavailable action,
/// validation rejection, permission failure, and callback failure. Refresh catalog or saved state
/// when requested before attempting preparation again.
enum AuthoringActionResult(84160020) {
  needs_input: AuthoringActionNeedsInput = 1;
  preview: AuthoringActionPreview = 2;
  stale_observation_error: StaleAuthoringObservation = 3;
  invalid_error: ResourceOperationFailure = 4;
  unavailable_error: ResourceOperationFailure = 5;
  catalog_changed_error: CatalogChanged = 6;
  permission_denied_error: ResourceOperationFailure = 7;
  failed_error: ResourceOperationFailure = 8;
  internal_error: InternalError = 9;
}

/// Gives operation input search the same selection, working observation, and input revision as preparation.
struct OperationSearchContext(84160021) {
  invocation: OperationInvocation = 0;
  context: OperationWorkingContext = 1;
  input_revision: int32 = 2;
}

/// Destinations one operation accepts for the dragged resources, from its declared candidates and
/// accepts. complete is false when the list was capped.
struct DropCandidates(84160022) {
  operation: ResourceOperationId = 0;
  destinations: [ResourceId] = 1;
  complete: bool = 2;
}

/// invocation targets are the dragged resources.
struct ResolveDropCandidatesRequest(84160023) {
  invocation: OperationInvocation = 0;
  context: OperationWorkingContext = 1;
}

/// Resolved once when a drag starts, so hovering is a local lookup. Only enabled operations that
/// declare a drop field contribute candidates.
enum ResolveDropCandidatesResult(84160024) {
  resolved: [DropCandidates] = 1;
  stale_observation_error: StaleAuthoringObservation = 2;
  invalid_error: ResourceOperationFailure = 3;
  catalog_changed_error: CatalogChanged = 4;
  permission_denied_error: ResourceOperationFailure = 5;
  failed_error: ResourceOperationFailure = 6;
  internal_error: InternalError = 7;
}

method ResolveResourceOperations(
  ResolveResourceOperationsRequest
): ResolveResourceOperationsResult = 941601;

method PrepareAuthoringAction(
  PrepareAuthoringActionRequest
): AuthoringActionResult = 941602;

method ResolveDropCandidates(
  ResolveDropCandidatesRequest
): ResolveDropCandidatesResult = 941603;
