// Checks evaluate retained authoring inputs and attach original fact evidence to results.
// Execution completion and finding freshness are independent: a finished result can become
// outdated after saved state changes, and missing input or incomplete traversal is not success.

import { EditExpectation } from "editor/v1/authoring_facts.skir";
import { Diagnostic } from "editor/v1/diagnostic.skir";
import {
  CatalogGeneration,
  CheckExecutionId,
  RuleId,
  ValueLocation,
} from "editor/v1/type_catalog.skir";

/// Evaluation completion, separate from the diagnostics it emitted. finished may still have
/// error findings; needs_input, failed, and incomplete cannot establish publication readiness.
enum CheckOutcome(84080001) {
  finished = 1;
  needs_input: [ValueLocation] = 2;
  failed: [Diagnostic] = 3;
  incomplete: string = 4;
}

enum FindingStatus(84080002) {
  current = 1;
  outdated = 2;
}

struct CheckInstanceId(84080003) {
  rule: RuleId = 0;
  location: ValueLocation = 1;
}

/// Distinguishes a rule occurrence, its catalog incarnation, and one scheduled execution.
/// Current finding admission rejects results from executions superseded for the same instance.
struct CheckTicket(84080004) {
  instance: CheckInstanceId = 0;
  incarnation: string = 1;
  execution: CheckExecutionId = 2;
  catalog: CatalogGeneration = 3;
}

/// Findings with the execution and original facts they describe. Status records freshness;
/// consumers retain the evidence needed to compare them with saved or local working values.
struct FindingSet(84080005) {
  ticket: CheckTicket = 0;
  expectations: [EditExpectation] = 1;
  outcome: CheckOutcome = 2;
  findings: [Diagnostic] = 3;
  status: FindingStatus = 4;
}

struct CheckResult(84080006) {
  ticket: CheckTicket = 0;
  outcome: CheckOutcome = 1;
  expectations: [EditExpectation] = 2;
  findings: [Diagnostic] = 3;
}
