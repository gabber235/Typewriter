// Capabilities publish typed Realm operations in the editor catalog. Computations return
// portable values, commands return panel instructions, search streams correlated snapshots,
// and authoring capabilities prepare proposed edits. Invocation results distinguish stale
// catalog data, invalid input, unavailable execution, and permission rejection.

import { Diagnostic } from "editor/v1/diagnostic.skir";
import {
  OperationInputDefinition,
  OperationTargets,
} from "editor/v1/operation.skir";
import {
  CapabilityId,
  CatalogGeneration,
  DataValue,
  TypeTemplate,
  TypeUse,
} from "editor/v1/type_catalog.skir";
import { InternalError } from "kernel/v1/errors.skir";

/// Caller correlation identity. It does not imply durable command storage or automatic deduplication.
struct InvocationId(84050001) {
  value: string = 0;
}

struct SearchCapabilityDefinition(84050002) {
  capability_id: CapabilityId = 0;
  request_type: TypeUse = 1;
  result_type: TypeUse = 2;
}

struct ComputationCapabilityDefinition(84050003) {
  capability_id: CapabilityId = 0;
  request_type: TypeUse = 1;
  result_type: TypeUse = 2;
}

struct CommandCapabilityDefinition(84050004) {
  capability_id: CapabilityId = 0;
  request_type: TypeUse = 1;
}

enum CapabilityDefinition(84050005) {
  search: SearchCapabilityDefinition = 1;
  computation: ComputationCapabilityDefinition = 2;
  command: CommandCapabilityDefinition = 3;
  authoring: AuthoringCapabilityDefinition = 4;
}

struct ResourceAddress(84050006) {
  resource_type: TypeUse = 0;
  identity: DataValue = 1;
}

struct InvalidateResourceInstruction(84050007) {
  resource: ResourceAddress = 0;
}

struct OpenResourceInstruction(84050008) {
  resource: ResourceAddress = 0;
}

enum NotificationSeverity(84050009) {
  info = 1;
  success = 2;
  warning = 3;
  error = 4;
}

struct NotifyInstruction(84050010) {
  severity: NotificationSeverity = 0;
  message: string = 1;
}

/// Client effects returned by Realm commands. These instructions direct navigation, refresh,
/// or notification; receiving them is separate from applying them in the current panel session.
enum PanelInstruction(84050011) {
  invalidate_resource: InvalidateResourceInstruction = 1;
  open_resource: OpenResourceInstruction = 2;
  notify: NotifyInstruction = 3;
}

/// Selects a capability under a catalog generation with portable input. Computations require
/// the declared result type; commands require expected_result_type to be absent.
struct CapabilityInvocationRequest(84050012) {
  invocation_id: InvocationId = 0;
  generation: CatalogGeneration = 1;
  capability_id: CapabilityId = 2;
  payload: DataValue = 3;
  expected_result_type: TypeTemplate? = 4;
}

struct ComputationSuccess(84050013) {
  invocation_id: InvocationId = 0;
  value: DataValue = 1;
}

struct CommandSuccess(84050014) {
  invocation_id: InvocationId = 0;
  instructions: [PanelInstruction] = 1;
}

struct CapabilityPermissionDenied(84050015) {
  invocation_id: InvocationId = 0;
  message: string = 1;
}

struct StaleCatalogGeneration(84050016) {
  invocation_id: InvocationId = 0;
  actual_generation: CatalogGeneration = 1;
}

struct CapabilityFailure(84050017) {
  invocation_id: InvocationId = 0;
  diagnostics: [Diagnostic] = 1;
}

enum ComputationResult(84050018) {
  success: ComputationSuccess = 1;
  invalid_error: CapabilityFailure = 2;
  unavailable_error: CapabilityFailure = 3;
  permission_denied_error: CapabilityPermissionDenied = 4;
  stale_generation_error: StaleCatalogGeneration = 5;
  internal_error: InternalError = 6;
}

enum CommandResult(84050019) {
  success: CommandSuccess = 1;
  invalid_error: CapabilityFailure = 2;
  unavailable_error: CapabilityFailure = 3;
  permission_denied_error: CapabilityPermissionDenied = 4;
  stale_generation_error: StaleCatalogGeneration = 5;
  internal_error: InternalError = 6;
}

struct AuthoringCapabilityDefinition(84050020) {
  capability_id: CapabilityId = 0;
  targets: OperationTargets = 1;
  input: OperationInputDefinition? = 2;
}

method InvokeRealmComputation(
  CapabilityInvocationRequest
): ComputationResult = 940501;

method InvokeRealmCommand(
  CapabilityInvocationRequest
): CommandResult = 940502;
