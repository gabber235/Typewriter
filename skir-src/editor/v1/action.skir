// Editor actions describe intent embedded in portable presentations. Local actions target
// editable bindings, Realm actions invoke host capabilities, navigation identifies resource
// destinations, authoring actions enter selection preparation, and create actions start
// creating an owned resource. The panel dispatch owner resolves bindings and current edit
// scope before applying an action.

import { BindingRef } from "editor/v1/binding.skir";
import { ExpressionNode } from "editor/v1/expression.skir";
import {
  CapabilityId,
  ItemId,
  TypeDefinitionId,
  TypeUse,
  ValuePath,
} from "editor/v1/type_catalog.skir";

struct SetValueAction(84010001) {
  target: BindingRef = 0;
  value: ExpressionNode = 1;
}

struct InsertListItemAction(84010002) {
  target: BindingRef = 0;
  after: ItemId? = 1;
  value: ExpressionNode = 2;
}

struct AppendListItemAction(84010003) {
  target: BindingRef = 0;
  value: ExpressionNode = 1;
}

struct RemoveListItemAction(84010004) {
  target: BindingRef = 0;
  item: ItemId = 1;
}

struct DuplicateListItemAction(84010005) {
  target: BindingRef = 0;
  item: ItemId = 1;
}

struct MoveListItemAction(84010006) {
  target: BindingRef = 0;
  item: ItemId = 1;
  after: ItemId? = 2;
}

struct InsertMapRowAction(84010007) {
  target: BindingRef = 0;
  key: ExpressionNode = 1;
  value: ExpressionNode = 2;
}

struct UpdateMapRowAction(84010008) {
  target: BindingRef = 0;
  row: ItemId = 1;
  key: ExpressionNode = 2;
  value: ExpressionNode = 3;
}

struct RemoveMapRowAction(84010009) {
  target: BindingRef = 0;
  row: ItemId = 1;
}

struct ChooseFormAction(84010010) {
  target: BindingRef = 0;
  type: TypeUse = 1;
}

/// Mutations of bound editor values. Collection item identities identify occurrences and
/// anchors; the owning edit scope decides staging and commit behavior.
enum LocalEditorAction(84010011) {
  set_value: SetValueAction = 1;
  insert_list_item: InsertListItemAction = 2;
  append_list_item: AppendListItemAction = 3;
  remove_list_item: RemoveListItemAction = 4;
  duplicate_list_item: DuplicateListItemAction = 5;
  move_list_item: MoveListItemAction = 6;
  insert_map_row: InsertMapRowAction = 7;
  update_map_row: UpdateMapRowAction = 8;
  remove_map_row: RemoveMapRowAction = 9;
  choose_form: ChooseFormAction = 10;
}

struct ReloadRealmAction(84010012) {}

struct CommandCapabilityAction(84010013) {
  capability_id: CapabilityId = 0;
  payload: ExpressionNode = 1;
}

enum RealmEditorAction(84010014) {
  reload: ReloadRealmAction = 1;
  command: CommandCapabilityAction = 2;
}

enum ResourceNavigationMode(84010015) {
  open = 1;
  reveal = 2;
  edit = 3;
}

struct ResourceNavigationAction(84010016) {
  resource: ExpressionNode = 0;
  mode: ResourceNavigationMode = 1;
}

/// Invokes catalog authoring preparation for evaluated resource targets and optional initial input.
/// Its output is a proposed edit, rather than an immediate saved resource mutation.
struct AuthoringCapabilityAction(84010017) {
  capability: CapabilityId = 0;
  targets: ExpressionNode = 1;
  initial_input: ExpressionNode? = 2;
}

enum EditorAction(84010018) {
  local: LocalEditorAction = 1;
  realm: RealmEditorAction = 2;
  navigate: ResourceNavigationAction = 3;
  authoring: AuthoringCapabilityAction = 4;
  create: CreateResourceAction = 5;
}

/// A preset value for one field of the created resource, addressed relative to the created type.
/// A value that evaluates to missing leaves the field at its creation default.
struct CreateFieldValue(84010019) {
  path: ValuePath = 0;
  value: ExpressionNode = 1;
}

/// Creates a resource of [type] and links it at [owner], with preset fields. The owner is the
/// link field of an ownership relation the new resource joins, such as the pages of the routed
/// Book, so an owner type with two owning fields is never ambiguous. Without an owner, the host
/// chooses one, for example the single instance of a realm section.
struct CreateResourceAction(84010020) {
  type: TypeDefinitionId = 0;
  owner: BindingRef? = 1;
  fields: [CreateFieldValue] = 2;
}
