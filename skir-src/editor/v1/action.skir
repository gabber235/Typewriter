import { BindingRef } from "editor/v1/binding.skir";
import { TypeDiagnostic } from "editor/v1/diagnostic.skir";
import { TypedExpression } from "editor/v1/expression.skir";
import {
  CapabilityId,
  ResolvedTypeRef,
  TypedValue,
} from "editor/v1/type_catalog.skir";

// Editor actions describe local mutations and requests delegated to Realm. Local variants operate on bound values;
// Realm variants leave execution to Realm. Mutation results carry applied state or failure information.

struct SetValueAction(810700001) {
  target: BindingRef = 0;
  value: TypedExpression = 1;
}

struct InsertListItemAction(810700002) {
  target: BindingRef = 0;
  index: TypedExpression = 1;
  value: TypedExpression = 2;
}

struct RemoveListItemAction(810700003) {
  target: BindingRef = 0;
  index: TypedExpression = 1;
}

struct AppendListItemAction(810700004) {
  target: BindingRef = 0;
  value: TypedExpression = 1;
}

struct DuplicateListItemAction(810700005) {
  source: BindingRef = 0;
}

struct ReorderListItemAction(810700006) {
  source: BindingRef = 0;
  new_index: TypedExpression = 1;
}

struct PutMapEntryAction(810700007) {
  target: BindingRef = 0;
  key: TypedExpression = 1;
  value: TypedExpression = 2;
}

struct RemoveMapEntryAction(810700008) {
  target: BindingRef = 0;
  key: TypedExpression = 1;
}

struct ReplaceConcreteNominalTypeAction(810700009) {
  target: BindingRef = 0;
  concrete_type: ResolvedTypeRef = 1;
}

// A mutation that can be evaluated and applied within the current editor
// value. Binding resolution supplies writability and the revision being edited.
enum LocalEditorAction(810700010) {
  set_value: SetValueAction = 1;
  insert_list_item: InsertListItemAction = 2;
  remove_list_item: RemoveListItemAction = 3;
  append_list_item: AppendListItemAction = 4;
  duplicate_list_item: DuplicateListItemAction = 5;
  reorder_list_item: ReorderListItemAction = 6;
  put_map_entry: PutMapEntryAction = 7;
  remove_map_entry: RemoveMapEntryAction = 8;
  replace_concrete_nominal_type: ReplaceConcreteNominalTypeAction = 9;
}

// Requests the owning editor to refresh its Realm view.
struct ReloadRealmAction(810700011) {}

// Requests a Realm capability operation. Execution and authorization belong to the Realm owner.
struct CommandCapabilityAction(810700012) {
  capability_id: CapabilityId = 0;
  payload: TypedExpression = 1;
}

enum RealmEditorAction(810700013) {
  reload: ReloadRealmAction = 1;
  command: CommandCapabilityAction = 2;
}

enum EditorAction(810700014) {
  local: LocalEditorAction = 1;
  realm: RealmEditorAction = 2;
}

// Confirms the resulting value and revision after a mutation is applied.
struct MutationSuccess(810700015) {
  revision: int64 = 0;
  value: TypedValue = 1;
}

// Reports that the expected revision did not match the current value.
struct MutationConflict(810700016) {
  expected_revision: int64 = 0;
  actual_revision: int64 = 1;
  actual_value: TypedValue = 2;
}

struct PermissionDenied(810700017) {
  message: string = 0;
}

enum TypedMutationResult(810700018) {
  success: MutationSuccess = 1;
  conflict: MutationConflict = 2;
  invalid: [TypeDiagnostic] = 3;
  unavailable: [TypeDiagnostic] = 4;
  permission_denied: PermissionDenied = 5;
}
