import { ExpressionNode } from "editor/v1/expression.skir";
import {
  CapabilityId,
  ItemId,
  TypeUse,
} from "editor/v1/type_catalog.skir";

struct SetValueAction(810700001) {
  target: BindingRef = 0;
  value: ExpressionNode = 1;
}

struct InsertListItemAction(810700002) {
  target: BindingRef = 0;
  after: ItemId? = 1;
  value: ExpressionNode = 2;
}

struct AppendListItemAction(810700003) {
  target: BindingRef = 0;
  value: ExpressionNode = 1;
}

struct RemoveListItemAction(810700004) {
  target: BindingRef = 0;
  item: ItemId = 1;
}

struct DuplicateListItemAction(810700005) {
  target: BindingRef = 0;
  item: ItemId = 1;
}

struct MoveListItemAction(810700006) {
  target: BindingRef = 0;
  item: ItemId = 1;
  after: ItemId? = 2;
}

struct InsertMapRowAction(810700007) {
  target: BindingRef = 0;
  key: ExpressionNode = 1;
  value: ExpressionNode = 2;
}

struct UpdateMapRowAction(810700008) {
  target: BindingRef = 0;
  row: ItemId = 1;
  key: ExpressionNode = 2;
  value: ExpressionNode = 3;
}

struct RemoveMapRowAction(810700009) {
  target: BindingRef = 0;
  row: ItemId = 1;
}

struct ChooseFormAction(810700010) {
  target: BindingRef = 0;
