// Realm presentation search sends typed capability input and query state to a retained
// Realm provider. A subscription returns correlated snapshots as results accumulate.
// Search jobs outlive the startup response and end through completion, replacement,
// explicit cancellation, failure, or the enclosing Realm scope.

import { Diagnostic } from "editor/v1/diagnostic.skir";
import {
  OperationSearchContext,
  StaleAuthoringObservation,
} from "editor/v1/resource_operations.skir";
import {
  CapabilityId,
  CatalogGeneration,
  DataValue,
  TypeTemplate,
} from "editor/v1/type_catalog.skir";

struct RealmSearchSelector(811000001) {
  selector_id: string = 0;
  key: string = 1;
  value: string? = 2;
}

enum RealmSearchSelectorOperator(811000002) {
  and = 1;
  or = 2;
}

struct RealmSearchSelectorBinaryExpression(811000003) {
  operator: RealmSearchSelectorOperator = 0;
  left: RealmSearchSelectorExpression = 1;
  right: RealmSearchSelectorExpression = 2;
}

struct RealmSearchSelectorNotExpression(811000004) {
  expression: RealmSearchSelectorExpression = 0;
}

enum RealmSearchSelectorExpression(811000005) {
  selector: RealmSearchSelector = 1;
  binary: RealmSearchSelectorBinaryExpression = 2;
  not: RealmSearchSelectorNotExpression = 3;
}

/// Preserves normalized text, parsed terms, selector identities, and Boolean selector structure.
/// Providers interpret the query instead of reconstructing selected filters from display text.
struct RealmSearchQuery(811000006) {
  normalized_query: string = 0;
  selectors: [RealmSearchSelector] = 1;
  selector_expression: RealmSearchSelectorExpression? = 2;
  terms: [string] = 3;
}

/// Starts or replaces work for one subscription. Operation context gives input searches the
/// same confirmed saved baseline and local overlay used by action preparation.
struct RealmPresentationSearchRequest(811000007) {
  subscription_id: string = 0;
  generation: CatalogGeneration = 1;
  capability_id: CapabilityId = 2;
  payload: DataValue = 3;
  result_type: TypeTemplate = 4;
  query: RealmSearchQuery = 5;
  operation_context: OperationSearchContext? = 6;
}

enum RealmPresentationSearchStatus(811000008) {
  loading = 1;
  ready = 2;
  error = 3;
}

/// Complete values accumulated for this subscription so far, not an incremental append batch.
/// loading allows further snapshots; ready marks producer completion; error carries diagnostics.
struct RealmPresentationSearchSnapshot(811000009) {
  subscription_id: string = 0;
  status: RealmPresentationSearchStatus = 1;
  values: [DataValue] = 2;
  guidance: [string] = 3;
  diagnostics: [Diagnostic] = 4;
}

struct RealmPresentationSearchUnavailable(811000010) {
  subscription_id: string = 0;
  diagnostics: [Diagnostic] = 1;
}

enum RealmPresentationSearchUpdate(811000011) {
  snapshot: RealmPresentationSearchSnapshot = 1;
  unavailable: RealmPresentationSearchUnavailable = 2;
  stale_observation: struct {
    subscription_id: string = 0;
    observation: StaleAuthoringObservation = 1;
  } = 3;
}

method WatchRealmPresentationSearch(
  RealmPresentationSearchRequest
): RealmPresentationSearchUpdate = 919103;

struct CancelRealmPresentationSearchRequest(811000012) {
  subscription_id: string = 0;
}

enum CancelRealmPresentationSearchResult(811000013) {
  canceled = 1;
  not_found = 2;
  unavailable = 3;
}

/// Requests cancellation of a source owned search job. not_found also covers work already retired.
method CancelRealmPresentationSearch(
  CancelRealmPresentationSearchRequest
): CancelRealmPresentationSearchResult = 919104;
