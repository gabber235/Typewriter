import { TypeDiagnostic } from "editor/v1/diagnostic.skir";
import {
  RealmActionId,
  TypeExpression,
  TypedValue,
} from "editor/v1/type_catalog.skir";

struct RealmSearchSelector(811200001) {
  selector_id: string = 0;
  key: string = 1;
  value: string? = 2;
}

enum RealmSearchSelectorOperator(811200002) {
  and = 1;
  or = 2;
}

struct RealmSearchSelectorBinaryExpression(811200003) {
  operator: RealmSearchSelectorOperator = 0;
  left: RealmSearchSelectorExpression = 1;
  right: RealmSearchSelectorExpression = 2;
}

struct RealmSearchSelectorNotExpression(811200004) {
  expression: RealmSearchSelectorExpression = 0;
}

enum RealmSearchSelectorExpression(811200005) {
  selector: RealmSearchSelector = 1;
  binary: RealmSearchSelectorBinaryExpression = 2;
  not: RealmSearchSelectorNotExpression = 3;
}

struct RealmSearchQuery(811200006) {
  normalized_query: string = 0;
  selectors: [RealmSearchSelector] = 1;
  selector_expression: RealmSearchSelectorExpression? = 2;
}

struct RealmPresentationSearchRequest(811200007) {
  subscription_id: string = 0;
  realm_action_id: RealmActionId = 1;
  payload: TypedValue = 2;
  result_type: TypeExpression = 3;
  query: RealmSearchQuery = 4;
}

enum RealmPresentationSearchStatus(811200008) {
  loading = 1;
  ready = 2;
  error = 3;
}

struct RealmPresentationSearchSnapshot(811200009) {
  subscription_id: string = 0;
  status: RealmPresentationSearchStatus = 1;
  values: [TypedValue] = 2;
  guidance: [string] = 3;
  diagnostics: [TypeDiagnostic] = 4;
}

struct RealmPresentationSearchUnavailable(811200010) {
  subscription_id: string = 0;
  diagnostics: [TypeDiagnostic] = 1;
}

enum RealmPresentationSearchUpdate(811200011) {
  snapshot: RealmPresentationSearchSnapshot = 1;
  unavailable: RealmPresentationSearchUnavailable = 2;
}

method WatchRealmPresentationSearch(
  RealmPresentationSearchRequest
): RealmPresentationSearchUpdate = 910003;
