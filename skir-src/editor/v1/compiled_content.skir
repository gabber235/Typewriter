// Compiled content is the complete output set selected by a Realm publication.
// Descriptors reference immutable blobs; consumers verify exact bytes before decoding
// and admitting artifact meaning against their runtime catalog. Selection and engine
// application are separate facts.

import { CompilationRoot } from "editor/v1/compilation_root.skir";
import { ResourceId } from "kernel/v1/resource_id.skir";
import {
  CatalogGeneration,
  NamedTypeUse,
  NamedValue,
  NativeBindingId,
  PublicationId,
  RelationId,
  TypeDefinition,
  ValuePath,
} from "editor/v1/type_catalog.skir";
import { InternalError } from "kernel/v1/errors.skir";

/// Addresses serialized bytes by lowercase SHA 256 digest and exact byte count.
/// This digest can differ from the semantic digest of the decoded artifact.
struct CompiledBlobPointer(811500001) {
  digest: string = 0;
  size: int64 = 1;
}
struct CompiledArtifactReference(811500002) {
  root: CompilationRoot = 0;
  format_revision: int32 = 1;
  media_type: string = 2;
  semantic_digest: string = 3;
}
struct PublishedOutput(811500003) {
  reference: CompiledArtifactReference = 0;
  blob: CompiledBlobPointer = 1;
}
/// Complete selected runtime descriptor, including the implementation requirements under which
/// its outputs were compiled. Engines fetch the whole set before contributing a visible snapshot.
struct PublishedContent(811500004) {
  publication: PublicationId = 0;
  format_revision: int32 = 1;
  catalog: CatalogGeneration = 2;
  implementation_token: string = 3;
  outputs: [PublishedOutput] = 4;
}
/// Membership in the Realm selected publication. active does not confirm application by any engine,
/// nor that the currently saved root still compiles to the selected artifact.
enum CompiledResourceState(811500005) {
  not_compiled = 1;
  active: PublicationId = 2;
}
struct CompiledResourceStatus(811500006) {
  root: CompilationRoot = 0;
  state: CompiledResourceState = 1;
}
/// Hint to refetch current selection. The event carries no descriptor or ordered publication log.
struct CompiledContentChanged(811500007) {
  generation: CatalogGeneration = 0;
}
enum CompilationStatusSelection(811500008) {
  all_roots = 1;
  supplied_roots: [CompilationRoot] = 2;
}

/// Distinguishes one generated occurrence of an authored resource. The root occurrence has no segments.
struct InstancePath(811500009) {
  segments: [string] = 0;
}
struct CompilationContext(811500010) {
  instance_path: InstancePath = 0;
}
/// Identifies a resource in a compiled occurrence.
struct CompiledResourceKey(811500011) {
  source: ResourceId = 0;
  context: CompilationContext = 1;
}
/// The typed record of one compiled resource before graph hydration, with the native binding that
/// produced it. Engines hydrate it only through the same binding provider and signature.
struct CompiledResource(811500012) {
  key: CompiledResourceKey = 0;
  actual_type: NamedTypeUse = 1;
  binding_provider: NativeBindingId = 2;
  binding_signature: string = 3;
  value: NamedValue = 4;
}
/// The declared relation an edge projects, with the authored locations of both endpoints.
struct CompiledRelationOrigin(811500013) {
  relation: RelationId = 0;
  first_location: ValuePath? = 1;
  second_location: ValuePath? = 2;
}
enum CompiledEdgeOrigin(811500014) {
  relation: CompiledRelationOrigin = 1;
}
/// A link between compiled keys, including keys outside its shard.
struct CompiledEdge(811500015) {
  source: CompiledResourceKey = 0;
  target: CompiledResourceKey = 1;
  origin: CompiledEdgeOrigin = 2;
}
struct RuntimeRelationFact(811500016) {
  relation: RelationId = 0;
  owns_resources: bool = 1;
}
/// The canonical resource graph of one compilation unit: its resources, edges, and the type and
/// relation declarations engines need to admit them against their runtime catalog.
struct RuntimeCompilationFacts(811500017) {
  format_revision: int32 = 0;
  root: CompiledResourceKey = 1;
  resources: [CompiledResource] = 2;
  edges: [CompiledEdge] = 3;
  types: [TypeDefinition] = 4;
  relations: [RuntimeRelationFact] = 5;
}
/// The payload of a resource graph blob: canonical facts and their semantic digest, the lowercase
/// SHA 256 of their canonical encoding. Consumers recompute the digest before admitting the facts.
struct ResourceGraphShard(811500018) {
  digest: string = 0;
  facts: RuntimeCompilationFacts = 1;
}

/// Returns the descriptor of the selected publication, or absent before any publication is selected.
method QueryPublishedContent(
  struct {}
): enum {
  content: PublishedContent = 1;
  absent: struct {} = 2;
  internal_error: InternalError = 3;
} = 920008;

method QueryCompiledResourceStatus(
  struct {
    selection: CompilationStatusSelection = 0;
  }
): enum {
  success: struct {
    statuses: [CompiledResourceStatus] = 0;
  } = 1;
  internal_error: InternalError = 2;
} = 920009;
