import { DataPath } from "editor/v1/path.skir";
import {
  ResolvedTypeRef,
  TypedValue,
} from "editor/v1/type_catalog.skir";
import { Color } from "kernel/v1/color.skir";
import { PageKindRef } from "kernel/v1/page_kind.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct GraphPlacement {
  x: int32;
  y: int32;
  width: int32;
  height: int32;
}

struct TimelineEntryPlacement {
  track_index: int32;
}

struct TimelineSegmentPlacement {
  start_frame: int32;
  end_frame: int32;
}

struct TimelineKeyframePlacement {
  frame: int32;
}

enum ElementPlacement {
  graph_v1: GraphPlacement;
  timeline_entry_v1: TimelineEntryPlacement;
  timeline_segment_v1: TimelineSegmentPlacement;
  timeline_keyframe_v1: TimelineKeyframePlacement;
}

struct Book {
  id: RecordId;
  revision: int64;
  title: string;
  icon: string;
  color: Color;
  tags: [RecordId];
}

struct Tag {
  id: RecordId;
  revision: int64;
  name: string;
  color: Color;
  parents: [RecordId];
  placement: GraphPlacement;
}

struct Page {
  id: RecordId;
  revision: int64;
  book: RecordId;
  name: string;
  kind: PageKindRef;
  chapter: string;
  priority: int32;
}

struct PageElement {
  id: RecordId;
  revision: int64;
  element_type: string;
  schema_revision: int32;
  name: string;
  value: TypedValue;
  placement: ElementPlacement;
}

struct PageReference {
  source: RecordId;
  slot: string;
  target: RecordId;
}

struct ResourceSummary {
  id: RecordId;
  name: string?;
  element_type: string?;
  page: RecordId?;
  exists: bool;
}

struct PageDiagnostic {
  code: string;
  message: string;
  element: RecordId?;
  slot: string?;
  target: RecordId?;
}

enum PageCompileStatus {
  not_compiled;
  active: struct {
    manifest_id: string;
  };
  blocked: struct {
    last_active_manifest_id: string?;
    diagnostic_count: int32;
  };
}

struct PageDocument {
  revision: string;
  page: Page;
  elements: [PageElement];
  references: [PageReference];
  cross_page_targets: [ResourceSummary];
  cross_page_sources: [ResourceSummary];
  diagnostics: [PageDiagnostic];
  compile_status: PageCompileStatus;
}

method GetPageDocument(
  struct {
    page_id: RecordId;
  }
): enum {
  success: PageDocument;
  page_not_found: struct {
    page_id: RecordId;
  };
  invalid_request: struct {
    diagnostics: [string];
  };
  internal_error: struct {
    message: string;
  };
} = 920001;

enum PageInvalidationReason {
  execution;
  layout;
}

struct PageDocumentInvalidation {
  batch_id: string;
  revision: int64;
  page_ids: [RecordId];
  reason: PageInvalidationReason;
}

method WatchPageDocuments(
  struct {
    page_ids: [RecordId];
  }
): enum {
  initial;
  invalidated: PageDocumentInvalidation;
  invalid_request: struct {
    diagnostics: [string];
  };
  internal_error: struct {
    message: string;
  };
} = 920020;

enum LibraryResourceKind {
  book;
  page;
  tag;
}

struct LibraryInvalidation {
  batch_id: string;
  revision: int64;
  resources: [LibraryResourceKind];
}

method WatchLibraryInvalidations(
  struct {}
): enum {
  initial: struct {
    revision: int64;
  };
  invalidated: LibraryInvalidation;
  internal_error: struct {
    message: string;
  };
} = 920022;

struct CompiledBlobPointer {
  digest: string;
  size: int64;
}

struct CompiledShardPointer {
  shard_digest: string;
  blob: CompiledBlobPointer;
}

struct CompiledContentActivation {
  activation_revision: int64;
  manifest_digest: string;
  manifest: CompiledBlobPointer;
  shards: [CompiledShardPointer];
}

method WatchCompiledContent(
  struct {}
): enum {
  initial: struct {
    activation: CompiledContentActivation?;
  };
  activated: CompiledContentActivation;
  internal_error: struct {
    message: string;
  };
} = 920021;

struct SetValueMutation {
  path: DataPath;
  value: TypedValue;
}

struct InsertListItemsMutation {
  path: DataPath;
  index: int32;
  values: [TypedValue];
}

struct RemoveListItemsMutation {
  path: DataPath;
  index: int32;
  count: int32;
}

struct ReorderListItemsMutation {
  path: DataPath;
  source_index: int32;
  count: int32;
  destination_index: int32;
}

struct DuplicateListItemsMutation {
  path: DataPath;
  source_index: int32;
  count: int32;
  destination_index: int32;
}

struct PutMapEntry {
  key: TypedValue;
  value: TypedValue;
}

struct PutMapEntriesMutation {
  path: DataPath;
  entries: [PutMapEntry];
}

struct RemoveMapEntriesMutation {
  path: DataPath;
  keys: [TypedValue];
}

struct ReplaceConcreteTypeMutation {
  path: DataPath;
  concrete_type: ResolvedTypeRef;
  value: TypedValue;
}

enum ElementValueMutation {
  set_value: SetValueMutation;
  insert_list_items: InsertListItemsMutation;
  remove_list_items: RemoveListItemsMutation;
  reorder_list_items: ReorderListItemsMutation;
  duplicate_list_items: DuplicateListItemsMutation;
  put_map_entries: PutMapEntriesMutation;
  remove_map_entries: RemoveMapEntriesMutation;
  replace_concrete_type: ReplaceConcreteTypeMutation;
}

struct ElementValueUpdate {
  id: RecordId;
  expected_revision: int64;
  name: string;
  mutations: [ElementValueMutation];
}

struct ElementBatchConflict {
  id: RecordId;
  expected_revision: int64;
  actual_revision: int64?;
}

struct BatchSuccess {
  batch_id: string;
  affected_pages: [RecordId];
}

method UpdateElementValues(
  struct {
    batch_id: string;
    updates: [ElementValueUpdate];
  }
): enum {
  success: BatchSuccess;
  conflict: [ElementBatchConflict];
  invalid: [PageDiagnostic];
  internal_error: struct {
    message: string;
  };
} = 920002;

