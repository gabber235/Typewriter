import { Color } from "kernel/v1/color.skir";
import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct Book {
  book_id: RecordId;
  revision: int64;
  title: string;
  icon: string;
  color: Color;
  tag_ids: [RecordId];
}

enum BookValidationError {
  title_required;
  icon_required;
}

method WatchBooks(
  struct {}
): enum {
  internal_error: InternalError;

  list: [Book];
  add: Book;
  update: Book;
  remove: RecordId;
} = 216867;

method WatchBook(
  struct {
    book_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  initial: Book;
  update: Book;
  remove: RecordId;

  book_not_found_error: struct {
    book_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 452891;
