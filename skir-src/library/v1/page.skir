import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { PageKindRef } from "kernel/v1/page_kind.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct Page {
  page_id: RecordId;
  revision: int64;
  book_id: RecordId;
  name: string;
  kind: PageKindRef;
  chapter: string;
  priority: int32;
}

enum PageValidationError {
  name_required;
  page_kind_unknown;
  page_kind_revision_unknown;
}

method SearchPages(
  struct {
    book_id: RecordId;
    search: string?;
  }
): enum {
  internal_error: InternalError;

  success: [Page];

  book_not_found_error: struct {
    book_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247484;

method WatchPage(
  struct {
    page_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  initial: Page;
  update: Page;
  remove: RecordId;

  page_not_found_error: struct {
    page_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247485;
