import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { PageKindRef } from "kernel/v1/page_kind.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct Page {
  page_id: RecordId;
  revision: int64;
  book_id: RecordId;
  name: string;
  kind: PageKindRef;
  chapter: string;
  priority: int32;
}

enum PageValidationError {
  name_required;
  page_kind_unknown;
  page_kind_revision_unknown;
}

method ChangePageKind(
  struct {
    page_id: RecordId;
    target: PageKindRef;
  }
): enum {
  internal_error: InternalError;

  success: Page;

  page_not_found_error: struct {
    page_id: RecordId;
  };
  validation_error: PageValidationError;
  conversion_unavailable: struct {};

  invalid_record_id_error: InvalidRecordIdError;
} = 247483;

method SearchPages(
  struct {
    book_id: RecordId;
    search: string?;
  }
): enum {
  internal_error: InternalError;

  success: [Page];

  book_not_found_error: struct {
    book_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247484;

method WatchPage(
  struct {
    page_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  initial: Page;
  update: Page;
  remove: RecordId;

  page_not_found_error: struct {
    page_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247485;

method CreatePage(
  struct {
    book_id: RecordId;
    name: string;
    kind: PageKindRef;
    chapter: string?;
    priority: int32?;
  }
): enum {
  internal_error: InternalError;

  success: Page;

  book_not_found_error: struct {
    book_id: RecordId;
  };
  validation_error: PageValidationError;

  invalid_record_id_error: InvalidRecordIdError;
} = 247486;

method UpdatePage(
  struct {
    page_id: RecordId;
    expected_revision: int64;
    name: string?;
    chapter: string?;
    priority: int32?;
  }
): enum {
  internal_error: InternalError;

  success: Page;

  conflict_error: struct {
    expected_revision: int64;
    actual: Page;
  };

  page_not_found_error: struct {
    page_id: RecordId;
  };
  validation_error: PageValidationError;

  invalid_record_id_error: InvalidRecordIdError;
} = 247487;

method ChangePagesChapters(
  struct {
    book_id: RecordId;
    old_chapter: string;
    new_chapter: string;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    updated_count: int32;
  };

  book_not_found_error: struct {
    book_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247488;

method DeletePage(
  struct {
    page_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {};

  page_not_found_error: struct {
    page_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 247489;
