import { Color } from "kernel/v1/color.skir";
import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct Placement {
  x: int32;
  y: int32;
  width: int32;
  height: int32;
}

struct Tag {
  tag_id: RecordId;
  revision: int64;
  name: string;
  color: Color;
  parent_ids: [RecordId];
  placement: Placement;
}

enum TagValidationError {
  name_required;
  width_invalid;
  height_invalid;
  inheritance_cycle;
}

method WatchTags(
  struct {}
): enum {
  internal_error: InternalError;

  list: [Tag];
  add: Tag;
  update: Tag;
  remove: RecordId;
} = 822515;

method WatchTag(
  struct {
    tag_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  initial: Tag;
  update: Tag;
  remove: RecordId;

  tag_not_found_error: struct {
    tag_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 929317;
