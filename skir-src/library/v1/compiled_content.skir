import { InternalError } from "kernel/v1/errors.skir";

// Compiled content delivery contract shared by the Realm and runtime consumers.
// Semantic content digests identify manifests and shards. Blob digests identify
// the serialized bytes fetched from the blob endpoint.

struct CompiledBlobPointer(812300001) {
  digest: string = 0;
  size: int64 = 1;
}

struct CompiledShardPointer(812300002) {
  shard_digest: string = 0;
  blob: CompiledBlobPointer = 1;
}

/// Describes the compiled content revision currently available for activation.
/// The activation revision orders delivery. Manifest and shard digests identify
/// content, while their blob pointers identify bytes to download and verify.
struct CompiledContentActivation(812300003) {
  activation_revision: int64 = 0;
  manifest_digest: string = 1;
  manifest: CompiledBlobPointer = 2;
  shards: [CompiledShardPointer] = 3;
}

/// Watches the current compiled activation and later activation state changes.
/// The initial response is a point in time. Activated and blocked notifications
/// are advisory, so consumers reconnect or refresh when delivery is uncertain.
method WatchCompiledContent(
  struct {}
): enum {
  initial: struct {
    activation: CompiledContentActivation? = 0;
  } = 1;
  activated: CompiledContentActivation = 2;
  blocked: struct {} = 3;
  internal_error: InternalError = 4;
} = 920003;
