// What one run of one test runner proved. Every runner writes this one shape (the component
// runner, the graph's own steps, the panel driver), so the change report, conformance and
// evidence read a single type instead of each runner's own output format.
struct TestRun(85010001) {
  runner: Runner;
  commit: string;
  started_at_millis: int64;
  // How the cases' attempts were made; the verdict depends on it.
  attempt_policy: AttemptPolicy;
  cases: [TestCase];
}

enum AttemptPolicy(85010002) {
  // Failed cases run again until they pass, up to this many attempts in total.
  rerun_failures: int32;
  // Every case ran exactly this many times.
  exactly: int32;
}

struct TestCase(85010003) {
  // The test path or step name, unique within its run.
  id: string;
  // The requirement the test declares it demonstrates, for example "QUEST-1.E1".
  requirement: string?;
  demonstrates: Demonstrates;
  // In order; never empty.
  attempts: [Attempt];
}

// One run of one case.
struct Attempt(85010004) {
  // What this attempt observed. Quarantine and flakiness are the attempt policy's verdict.
  outcome: Outcome;
  // Where the attempt sits in the run's recording, when there is one.
  span: Span?;
  duration_millis: int64;
  // Clips, screenshots, log excerpts and spans that show the outcome, relative to `folder`.
  artifacts: [Artifact];
  // Where this attempt's evidence lies, relative to the folder of the run file; empty for
  // that folder itself.
  folder: string;
}

enum Runner(85010005) {
  components;
  schema;
  panel;
  panel_web;
  step;
}

enum Demonstrates(85010006) {
  happy_path;
  failure;
  edge_case;
}

enum Outcome(85010007) {
  passed;
  failed: Failure;
}

struct Failure(85010008) {
  message: string;
  // The first failing step or frame, when the runner knows it.
  first_broken: string?;
}

struct Span(85010009) {
  start_millis: int64;
  end_millis: int64;
}

enum ArtifactKind(85010010) {
  clip;
  screenshot;
  log_excerpt;
  // OTLP JSON spans of the traces an attempt started.
  spans;
}

struct Artifact(85010011) {
  kind: ArtifactKind;
  path: string;
}
