// What one run of one test runner proved. Every runner writes this one shape (the component
// runner, the graph's own steps, the panel driver), so the change report, conformance and
// evidence read a single type instead of each runner's own output format.
struct TestRun(85020001) {
  // The run the file belongs to. `cargo xtask e2e game` names it and every test JVM and game pool of
  // the run writes it, so a file an earlier run left never passes for this one; empty for runners
  // that write their file once.
  run_id: string;
  runner: Runner;
  commit: string;
  started_at_millis: int64;
  // How the cases' attempts were made; the verdict depends on it.
  attempt_policy: AttemptPolicy;
  cases: [TestCase];
  // Where the run's logs lie (for the game runner the pool's, Paper's and each client's), relative to
  // the folder of the run file; empty when the run names none.
  logs: string;
  // How the run ended.
  end: RunEnd;
  // Every process the run started that its cases depended on (for the game runner the pool's Papers and
  // clients), in the order they started, each with how it ended. Empty for runners that start none.
  parts: [Part];
  // Whether the run only records evidence of another run's cases, as a game suite's demo run records
  // clips of the cases of its verdict run: its cases are never verdicts.
  evidence_only: bool;
}

// How a run ended. A run that could not run, or was cut short, proves less than its cases say: the
// cases it never reached are missing from it.
enum RunEnd(85020002) {
  // It ran to the end.
  completed;
  // It stopped before it was over. Only the game pool says so: on every rewrite until the run is over,
  // so a file a crashed pool left holds the cases that finished and says the rest never ran.
  cut_short;
  // It could not run at all, as when the game never booted: why, for a person to read.
  could_not_run: string;
  // A part every case depended on was lost, so the run stopped: the attempts it held were interrupted
  // and the cases still waiting never ran. `parts` says how the part was lost.
  lost: RunLost;
}

// The run stopped because the part named `part` was lost.
struct RunLost(85020003) {
  part: string;
  // The cases that were waiting and never ran, by id.
  not_run: [string];
}

enum AttemptPolicy(85020004) {
  // Failed cases run again until they pass, up to this many attempts in total.
  rerun_failures: int32;
  // Every case ran exactly this many times.
  exactly: int32;
}

struct TestCase(85020005) {
  // The test path or step name, unique within its run.
  id: string;
  // The requirement the test declares it demonstrates, for example "QUEST-1.E1".
  requirement: string?;
  demonstrates: Demonstrates;
  // In order; never empty.
  attempts: [Attempt];
  // Whether the change under test is new to this case or touched it: an added line lies in the case's
  // own code, or its last attempt ran an added line of the code under test.
  touched: bool;
  // The case run again at other paces after its attempts passed, one attempt per pace: a touched game
  // requirement runs at 5 and 50 ms between ticks. Each must hold every window at the tick the attempts
  // held it at; they never count as attempts.
  paced: [Attempt];
  // Whether holding a window at another tick at another pace blocks, or is only reported.
  pacing: Pacing;
}

// What a case whose windows hold at different ticks at different paces does to the verdict.
enum Pacing(85020006) {
  // It fails the case: the window depends on wall clock.
  gates;
  // It is reported and blocks nothing, while the code under test still waits on work no tick waits for.
  reports;
}

// One run of one case.
struct Attempt(85020007) {
  // What this attempt observed. Quarantine and flakiness are the attempt policy's verdict.
  outcome: Outcome;
  // Where the attempt sits in the run's recording, when there is one.
  span: Span?;
  duration_millis: int64;
  // Clips, screenshots, golden candidates, log excerpts and spans that show the outcome, relative
  // to `folder`.
  artifacts: [Artifact];
  // Where this attempt's evidence lies, relative to the folder of the run file; empty for
  // that folder itself.
  folder: string;
  // What a scenario did and checked, in order, for the captions of its recording and to see
  // where an attempt's time goes. Empty for tests that report no steps.
  steps: [Step];
  // Where a scenario's taps landed, for the markers of its recording.
  taps: [Tap];
  // The plugin classes the attempt ran and their lines, for runners that measure coverage per case.
  covered: [CoveredClass];
  // The shortest wall clock time between two ticks the attempt's Paper ran, in milliseconds; 0 when a
  // tick ran as soon as nothing held it back. Only stepped runners pace.
  pace_millis: int32;
  // Every window the attempt's body waited in, in order, for runners that step ticks.
  windows: [WindowEnd];
}

// How one window of an attempt ended.
struct WindowEnd(85020008) {
  // The requirement line that opened it, as `File.kt:42`.
  at: string;
  // How many ticks it lasted at most.
  length: int32;
  // The tick of the window, counted from 1 after its stimulus, at which every check held; null when it
  // missed or a failure ended it.
  held_at: int32?;
  // Whether it was decided after the attempt met work reported hung or a lost part: neither holds back
  // a tick, so the tick it held at measures wall clock and may differ between paces.
  after_wall_clock: bool;
}

// One class an attempt ran code of, with the lines of its source file that ran.
struct CoveredClass(85020009) {
  // The JVM name, with slashes: "com/typewritermc/playtest/plugin/Probes".
  name: string;
  // The source file by its package path: "com/typewritermc/playtest/plugin/Probes.java".
  source: string;
  // The lines of `source` with an instruction the attempt ran, ascending.
  lines: [int32];
}

// One thing a scenario did or checked, in the words a reader would use.
struct Step(85020010) {
  // Unix milliseconds, the clock of the attempt's span.
  at_millis: int64;
  // The user signed in when the step started.
  actor: string?;
  says: string;
  // How long the step took, from `at_millis` until it returned.
  duration_millis: int64;
}

// One tap, in pixels of the recorded screen.
struct Tap(85020011) {
  // Unix milliseconds, the clock of the attempt's span.
  at_millis: int64;
  x: int32;
  y: int32;
}

enum Runner(85020012) {
  components;
  schema;
  panel;
  panel_web;
  step;
  // The JUnit XML a step's test tasks wrote, one case per test (the Gradle services suites).
  junit;
  // The game verification pool: requirements run against real Minecraft clients on a stepped Paper.
  game;
}

enum Demonstrates(85020013) {
  happy_path;
  failure;
  edge_case;
}

enum Outcome(85020014) {
  passed;
  failed: Failure;
  // A part the attempt depended on was lost while it ran: the attempt proves nothing either way.
  interrupted: Interruption;
}

struct Interruption(85020015) {
  // The lost part, by its name in the run's `parts`.
  part: string;
}

// One process a run started, such as a Paper or a Minecraft client.
struct Part(85020016) {
  // Unique within its run: "paper" for the shared Paper, "paper-<attempt>" for an attempt's own,
  // "client-<player>" for a client (with "-<n>" for the n-th replacement).
  name: string;
  kind: PartKind;
  // Its log, relative to the run's `logs` folder; empty when it keeps none.
  log: string;
  end: PartEnd;
}

enum PartKind(85020017) {
  // The Paper every attempt that does not restart Paper shares.
  shared_paper;
  // The Paper of an attempt that restarts Paper, its own.
  own_paper;
  // A Minecraft client that serves one player.
  client;
  // The virtual display a client draws on (Linux).
  display;
}

enum PartEnd(85020018) {
  // It ran until the run stopped it.
  ran_to_end;
  // It ended before the run stopped it, other than when an attempt asked for it.
  lost: PartLoss;
}

struct PartLoss(85020019) {
  cause: LossCause;
  // Unix milliseconds, when the run noticed.
  at_millis: int64;
}

// Why a part was lost, as far as the run could tell.
enum LossCause(85020020) {
  // Its process exited with this status; a status over 128 means the signal `status - 128` ended it.
  exited: int32;
  // It closed its connection to the pool, or left Paper, for this reason.
  left: string;
  // It answered nothing for longer than the run waits for it.
  stalled;
  // It never became ready within the run's limit.
  never_ready;
  // It still ran but could no longer do what attempts need of it, for this reason.
  broke: string;
}

struct Failure(85020021) {
  message: string;
  // The first failing step or frame, when the runner knows it.
  first_broken: string?;
}

struct Span(85020022) {
  start_millis: int64;
  end_millis: int64;
}

enum ArtifactKind(85020023) {
  clip;
  screenshot;
  log_excerpt;
  // OTLP JSON spans of the traces an attempt started.
  spans;
  // What `cargo xtask goldens approve` reads to make a captured frame a golden: the golden file it
  // is for, the frame's image beside it, its hash and size, and the renderer that drew it.
  golden;
}

struct Artifact(85020024) {
  kind: ArtifactKind;
  path: string;
}
