// The goldens of the game verification framework: approved frames a requirement compares a captured frame
// with to the pixel. Each lives in the repository as `<name>.golden`, readable Skir JSON of a `Golden`;
// the image it was approved from lies on the evidence branch under its hash. A run writes a
// `GoldenCandidate` beside each frame it captures, and `cargo xtask goldens approve` makes it the golden.

// What drew a frame: the graphics backend, the device and the driver it reports, the operating system and
// the CPU architecture. Two renderers draw the same scene alike to the pixel only when all five match.
struct Renderer(85010001) {
  backend: string;
  device: string;
  driver: string;
  os: string;
  arch: string;
}

// An approved frame: the hash of its pixels, its size, and the renderer that drew it. Only a frame from the
// same renderer can match it to the pixel.
struct Golden(85010002) {
  // The SHA-256 of the frame's size and colours, in hex; the evidence branch names its image after it.
  sha256: string;
  width: int32;
  height: int32;
  renderer: Renderer;
}

// What a run writes beside a captured frame, as `<name>.golden` in the attempt's folder, and lists as the
// attempt's `golden` artifact: what `cargo xtask goldens approve` needs to make the frame the golden.
struct GoldenCandidate(85010003) {
  // The golden file it is for, from the repository root.
  file: string;
  // The frame's PNG, in the same folder.
  image: string;
  // The frame as its golden file holds it once approved.
  golden: Golden;
  // Whether the run found the frame's renderer to be the pinned one; approve takes no other frame.
  pinned: bool;
}
