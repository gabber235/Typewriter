import { InternalError } from "kernel/v1/errors.skir";
import { ServiceRole } from "service/v1/service.skir";

// Creates the durable identity and initial credentials used by a service registrar.
// Identity issuance is separate from organization registration: success creates the service record and returns
// credentials, but does not bind the service to an organization or make it live. Role errors reject the requested
// identity shape, while provider unavailability means the external account system could not serve the request.
method IssueServiceIdentity(
  struct {
    role: ServiceRole;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    service_id: string;
    display_name: string;
    username: string;
    token: string;
  };

  /// Malformed request.
  malformed_request_error: struct {};
  /// Unknown role.
  unknown_role_error: struct {};
  /// Unknown role property.
  role_unknown_property_error: struct {};
  /// Invalid role type.
  role_type_invalid_error: struct {};
  /// Invalid role version.
  role_version_invalid_error: struct {};
  /// Custom role name required.
  custom_role_name_required_error: struct {};
  /// Invalid custom role name.
  custom_role_name_invalid_error: struct {};
  /// Built in role name forbidden.
  builtin_role_name_forbidden_error: struct {};
  /// Identity provider unavailable.
  identity_provider_unavailable_error: struct {};
} = 672941;
