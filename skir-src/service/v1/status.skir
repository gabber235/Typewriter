import { InternalError } from "kernel/v1/errors.skir";

// Durable organization association returned without changing registration state.
enum ServiceBinding(83080001) {
  bound: struct {
    organization_id: string;
    organization_name: string?;
  };
  unbound;
}

struct RegistrationLease(83080002) {
  token: string;
  expires_at: timestamp;
}

// Reads the durable binding only. It does not renew a lease or report liveness.
method QueryServiceBinding(
  struct {}
): enum {
  binding: struct {
    binding: ServiceBinding;
  };
  /// Service not found.
  service_not_found_error: struct {};
  internal_error: InternalError;
} = 930801;

// Issues or reuses the temporary capability required to bind an unbound service.
method EnsureRegistrationLease(
  struct {}
): enum {
  issued: RegistrationLease;
  already_bound: struct {
    organization_id: string;
    organization_name: string?;
  };
  /// Service not found.
  service_not_found_error: struct {};
  internal_error: InternalError;
} = 930802;
