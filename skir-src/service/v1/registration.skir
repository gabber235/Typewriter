import { InternalError } from "kernel/v1/errors.skir";
import { ServiceRole } from "service/v1/service.skir";

// Completes the operator mediated transition from an issued, unbound service to an organization bound service.
// The registration token is a temporary bearer capability. The registration service validates its expiry and
// atomically consumes it while writing the organization binding. This operation is user scoped
// and does not issue or replace service identity credentials.
method BindService(
  struct {
    registration_token: string;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    service_id: string;
    service_name: string?;
    service_role: ServiceRole;
  };

  /// Invalid or expired registration token.
  invalid_registration_token_error: struct {};
  /// Organization not found.
  organization_not_found_error: struct {};
} = 930501;

// Authoritative binding transition delivered to the service registrar after BindService commits.
// It carries organization context only. Receipt means binding changed, not that the service has proved liveness;
// the registrar must still establish authenticated messaging and send heartbeats.
struct ServiceBoundNotification(83050001) {
  organization_id: string;
  organization_name: string?;
}

// Why one unbinding in a refused batch was not applied.
enum ServiceUnbindRefusal(83050002) {
  /// Service not found in organization.
  service_not_found_error: struct {};

  /// The same service appears more than once in the batch.
  duplicate_error: struct {};
}

// One unbinding that kept its batch from being applied.
struct RefusedServiceUnbind(83050003) {
  service_id: string;
  reason: ServiceUnbindRefusal;
}

// Removes the organization binding for services owned by the addressed organization, as one all or nothing batch;
// a single unbinding is a batch of one.
// The registration service also clears each registration lease and publishes fresh organization views. The service
// identities remain intact, so a later binding uses a newly observed lease rather than reviving the old one.
// refused_error lists every item that kept the batch from applying; nothing changed.
method UnbindServices(
  struct {
    service_ids: [string];
  }
): enum {
  internal_error: InternalError;

  success: struct {};

  /// One or more unbindings were refused; nothing changed.
  refused_error: [RefusedServiceUnbind];
} = 930502;
