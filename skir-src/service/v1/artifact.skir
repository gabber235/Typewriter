import { InternalError } from "kernel/v1/errors.skir";

// Artifact descriptors refer to immutable blob bytes. The catalog and transfer operations use the digest and size together to verify content.
struct ArtifactDigest(83010001) {
  algorithm: DigestAlgorithm = 0;
  value: string = 1;
}

enum DigestAlgorithm(83010002) {
  sha256 = 1;
}

struct BlobMetadata(83010003) {
  digest: ArtifactDigest = 0;
  size: int64 = 1;
}

struct BlobChunk(83010004) {
  offset: int64 = 0;
  bytes: bytes = 1;
  complete: bool = 2;
}

// The durable catalog record for one logical artifact revision. Live records reference immutable blob content.
// Deleted records are tombstones and omit digest and size so consumers cannot download deleted content.
struct SharedArtifactDescriptor(83010005) {
  id: string = 0;
  revision: int64 = 1;
  label: string = 2;
  media_type: string = 3;
  digest: ArtifactDigest? = 4;
  size: int64? = 5;
  metadata: ProducerMetadata? = 6;
  provenance: SharedArtifactProvenance = 7;
  deleted: bool = 8;
}

// Provenance identifies how a descriptor was produced. It is descriptive and does not transfer blob ownership.
enum SharedArtifactProvenance(83010006) {
  local_inbox: struct {
    relative_path: string = 0;
  } = 1;
  panel: struct {
    user_id: string = 0;
  } = 2;
  service: struct {
    service_id: string = 0;
    runtime_id: string = 1;
  } = 3;
}

// Catalog revision orders changes across artifacts. Descriptor revision orders changes to one artifact identity.
struct SharedArtifactCatalog(83010007) {
  revision: int64 = 0;
  artifacts: [SharedArtifactDescriptor] = 1;
}

struct ProducerMetadataEntry(83010008) {
  key: string = 0;
  value: string = 1;
}

struct ProducerMetadata(83010009) {
  entries: [ProducerMetadataEntry] = 0;
}

// Reads the complete descriptor catalog, including tombstones. The current owner returns the
// complete snapshot regardless of after_revision; callers must not treat it as a delta.
method FetchSharedArtifactCatalog(
  struct {
    after_revision: int64? = 0;
  }
): enum {
  success: SharedArtifactCatalog = 1;
  internal_error: InternalError = 2;
} = 930101;

// Publishes a descriptor for an already uploaded blob, or a tombstone when deleted is true.
// Live publication requires digest and size. Deletion requires an expected revision.
// Equal live content and metadata return unchanged before revision comparison; provenance alone
// does not change the revision. Otherwise a null expected revision means creation.
method PublishSharedArtifact(
  struct {
    id: string = 0;
    expected_revision: int64? = 1;
    label: string = 2;
    media_type: string = 3;
    digest: ArtifactDigest? = 4;
    size: int64? = 5;
    metadata: ProducerMetadata? = 6;
    provenance: SharedArtifactProvenance = 7;
    deleted: bool = 8;
  }
): enum {
  published: SharedArtifactDescriptor = 1;
  unchanged: SharedArtifactDescriptor = 2;
  conflict_error: SharedArtifactDescriptor? = 3;
  internal_error: InternalError = 4;
} = 930102;

// Reads a bounded byte range from immutable blob content. The response offset and complete flag provide the continuation contract.
method ReadArtifactBlob(
  struct {
    digest: ArtifactDigest = 0;
    offset: int64 = 1;
    maximum_bytes: int32 = 2;
  }
): enum {
  success: BlobChunk = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  internal_error: InternalError = 4;
} = 930103;

// Starts or resumes a transfer for the expected digest and size. The returned offset is the next accepted byte for the transfer.
method BeginArtifactBlobWrite(
  struct {
    transfer_id: string = 0;
    expected: BlobMetadata = 1;
  }
): enum {
  accepted: struct {
    offset: int64 = 0;
  } = 1;
  invalid_error: struct {
    reason: string = 0;
  } = 2;
  conflict_error: struct {
    reason: string = 0;
  } = 3;
  internal_error: InternalError = 4;
} = 930104;

// Appends a chunk at the requested transfer offset. Accepted returns the next offset; invalid_error and conflict_error reject the write.
method WriteArtifactBlobChunk(
  struct {
    transfer_id: string = 0;
    offset: int64 = 1;
    bytes: bytes = 2;
  }
): enum {
  accepted: struct {
    offset: int64 = 0;
  } = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  conflict_error: struct {
    reason: string = 0;
  } = 4;
  internal_error: InternalError = 5;
} = 930105;

// Finalizes a transfer and verifies the expected digest and size.
method CompleteArtifactBlobWrite(
  struct {
    transfer_id: string = 0;
  }
): enum {
  success: BlobMetadata = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  conflict_error: struct {
    reason: string = 0;
  } = 4;
  internal_error: InternalError = 5;
} = 930106;

method FetchArtifactBlobMetadata(
  struct {
    digest: ArtifactDigest = 0;
  }
): enum {
  success: BlobMetadata = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  internal_error: InternalError = 4;
} = 930107;
