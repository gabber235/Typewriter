import { InternalError } from "kernel/v1/errors.skir";

// Artifact descriptors refer to immutable blob bytes. The catalog and blob operations use the digest and size together to verify content.
struct ArtifactDigest(83010001) {
  algorithm: DigestAlgorithm = 0;
  value: string = 1;
}

enum DigestAlgorithm(83010002) {
  sha256 = 1;
}

struct BlobMetadata(83010003) {
  digest: ArtifactDigest = 0;
  size: int64 = 1;
}

// The durable catalog record for one logical artifact revision. Live records reference immutable blob content.
// Deleted records are tombstones and omit digest and size so consumers cannot download deleted content.
struct SharedArtifactDescriptor(83010004) {
  id: string = 0;
  revision: int64 = 1;
  label: string = 2;
  media_type: string = 3;
  digest: ArtifactDigest? = 4;
  size: int64? = 5;
  metadata: ProducerMetadata? = 6;
  provenance: SharedArtifactProvenance = 7;
  deleted: bool = 8;
}

// Provenance identifies how a descriptor was produced. It is descriptive and does not transfer blob ownership.
enum SharedArtifactProvenance(83010005) {
  local_inbox: struct {
    relative_path: string = 0;
  } = 1;
  panel: struct {
    user_id: string = 0;
  } = 2;
  service: struct {
    service_id: string = 0;
    runtime_id: string = 1;
  } = 3;
}

// Catalog revision orders changes across artifacts. Descriptor revision orders changes to one artifact identity.
struct SharedArtifactCatalog(83010006) {
  revision: int64 = 0;
  artifacts: [SharedArtifactDescriptor] = 1;
}

struct ProducerMetadataEntry(83010007) {
  key: string = 0;
  value: string = 1;
}

struct ProducerMetadata(83010008) {
  entries: [ProducerMetadataEntry] = 0;
}

// Reads the complete descriptor catalog, including tombstones. The current owner returns the
// complete snapshot regardless of after_revision; callers must not treat it as a delta.
method FetchSharedArtifactCatalog(
  struct {
    after_revision: int64? = 0;
  }
): enum {
  success: SharedArtifactCatalog = 1;
  internal_error: InternalError = 2;
} = 930101;

// Publishes a descriptor for an already uploaded blob, or a tombstone when deleted is true.
// Live publication requires digest and size. Deletion requires an expected revision.
// Equal live content and metadata return unchanged before revision comparison; provenance alone
// does not change the revision. Otherwise a null expected revision means creation.
method PublishSharedArtifact(
  struct {
    id: string = 0;
    expected_revision: int64? = 1;
    label: string = 2;
    media_type: string = 3;
    digest: ArtifactDigest? = 4;
    size: int64? = 5;
    metadata: ProducerMetadata? = 6;
    provenance: SharedArtifactProvenance = 7;
    deleted: bool = 8;
  }
): enum {
  published: SharedArtifactDescriptor = 1;
  unchanged: SharedArtifactDescriptor = 2;
  conflict_error: SharedArtifactDescriptor? = 3;
  internal_error: InternalError = 4;
} = 930102;

// Reads the complete immutable content of a blob. The content always hashes to the requested digest.
method FetchArtifactBlob(
  struct {
    digest: ArtifactDigest = 0;
  }
): enum {
  success: struct {
    content: bytes = 0;
  } = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  internal_error: InternalError = 4;
} = 930103;

// Stores complete blob content after verifying it against the expected digest and size. Content that is
// already stored succeeds without change, so a retry after a lost reply is safe.
method StoreArtifactBlob(
  struct {
    expected: BlobMetadata = 0;
    content: bytes = 1;
  }
): enum {
  success: BlobMetadata = 1;
  invalid_error: struct {
    reason: string = 0;
  } = 2;
  internal_error: InternalError = 3;
} = 930104;

// Reports whether a blob is stored and its size, without moving its content.
method FetchArtifactBlobMetadata(
  struct {
    digest: ArtifactDigest = 0;
  }
): enum {
  success: BlobMetadata = 1;
  not_found_error: struct {} = 2;
  invalid_error: struct {
    reason: string = 0;
  } = 3;
  internal_error: InternalError = 4;
} = 930105;
