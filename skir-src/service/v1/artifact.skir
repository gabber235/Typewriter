// Artifact descriptors refer to immutable blob bytes. The catalog and transfer operations use the digest and size together to verify content.
struct ArtifactDigest(812100001) {
  algorithm: DigestAlgorithm = 0;
  value: string = 1;
}

enum DigestAlgorithm(812100002) {
  sha256 = 1;
}

struct BlobMetadata(812100003) {
  digest: ArtifactDigest = 0;
  size: int64 = 1;
}

struct BlobChunk(812100004) {
  offset: int64 = 0;
  bytes: bytes = 1;
  complete: bool = 2;
}

// The durable catalog record for one logical artifact revision. Live records reference immutable blob content.
// Deleted records are tombstones and omit digest and size so consumers cannot download deleted content.
struct SharedArtifactDescriptor(812100005) {
  id: string = 0;
  revision: int64 = 1;
  label: string = 2;
  media_type: string = 3;
  digest: ArtifactDigest? = 4;
  size: int64? = 5;
  metadata: ProducerMetadata? = 6;
  provenance: SharedArtifactProvenance = 7;
  deleted: bool = 8;
}

// Provenance identifies how a descriptor was produced. It is descriptive and does not transfer blob ownership.
enum SharedArtifactProvenance(812100006) {
  local_inbox: struct {
    relative_path: string = 0;
  } = 1;
  panel: struct {
    user_id: string = 0;
  } = 2;
  service: struct {
    service_id: string = 0;
    runtime_id: string = 1;
  } = 3;
}

// Catalog revision orders changes across artifacts. Descriptor revision orders changes to one artifact identity.
struct SharedArtifactCatalog(812100007) {
  revision: int64 = 0;
  artifacts: [SharedArtifactDescriptor] = 1;
}

struct ProducerMetadataEntry(812100008) {
  key: string = 0;
  value: string = 1;
}

struct ProducerMetadata(812100009) {
  entries: [ProducerMetadataEntry] = 0;
}

method FetchSharedArtifactCatalog(
  struct {
    after_revision: int64? = 0;
  }
): enum {
  success: SharedArtifactCatalog = 1;
  unavailable: struct {} = 2;
} = 910005;

// Publishes a descriptor for an already uploaded blob, or a tombstone when deleted is true. A null expected revision means creation; an equal live descriptor may return unchanged.
method PublishSharedArtifact(
  struct {
    id: string = 0;
    expected_revision: int64? = 1;
    label: string = 2;
    media_type: string = 3;
    digest: ArtifactDigest? = 4;
    size: int64? = 5;
    metadata: ProducerMetadata? = 6;
    provenance: SharedArtifactProvenance = 7;
    deleted: bool = 8;
  }
): enum {
  published: SharedArtifactDescriptor = 1;
  unchanged: SharedArtifactDescriptor = 2;
  conflict: SharedArtifactDescriptor? = 3;
  unavailable: struct {} = 4;
} = 910006;

// Reads a bounded byte range from immutable blob content. The response offset and complete flag provide the continuation contract.
method ReadArtifactBlob(
  struct {
    digest: ArtifactDigest = 0;
    offset: int64 = 1;
    maximum_bytes: int32 = 2;
  }
): enum {
  success: BlobChunk = 1;
  not_found: struct {} = 2;
  invalid: struct {
    reason: string = 0;
  } = 3;
  unavailable: struct {} = 4;
} = 910007;

// Starts or resumes a transfer for the expected digest and size. The returned offset is the next accepted byte for the transfer.
method BeginArtifactBlobWrite(
  struct {
    transfer_id: string = 0;
    expected: BlobMetadata = 1;
  }
): enum {
  accepted: struct {
    offset: int64 = 0;
  } = 1;
  invalid: struct {
    reason: string = 0;
  } = 2;
  conflict: struct {
    reason: string = 0;
  } = 3;
  unavailable: struct {} = 4;
} = 910008;

// Appends a chunk at the requested transfer offset. Accepted returns the next offset; invalid and conflict reject the write.
method WriteArtifactBlobChunk(
  struct {
    transfer_id: string = 0;
    offset: int64 = 1;
    bytes: bytes = 2;
  }
): enum {
  accepted: struct {
    offset: int64 = 0;
  } = 1;
  not_found: struct {} = 2;
  invalid: struct {
    reason: string = 0;
  } = 3;
  conflict: struct {
    reason: string = 0;
  } = 4;
  unavailable: struct {} = 5;
} = 910009;

// Finalizes a transfer and verifies the expected digest and size.
method CompleteArtifactBlobWrite(
  struct {
    transfer_id: string = 0;
  }
): enum {
  success: BlobMetadata = 1;
  not_found: struct {} = 2;
  invalid: struct {
    reason: string = 0;
  } = 3;
  conflict: struct {
    reason: string = 0;
  } = 4;
  unavailable: struct {} = 5;
} = 910010;

method FetchArtifactBlobMetadata(
  struct {
    digest: ArtifactDigest = 0;
  }
): enum {
  success: BlobMetadata = 1;
  not_found: struct {} = 2;
  invalid: struct {
    reason: string = 0;
  } = 3;
  unavailable: struct {} = 4;
} = 910011;
