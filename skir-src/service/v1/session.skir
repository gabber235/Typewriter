// Sessions: who is connected to which engine of a realm. Each engine reports its own connections
// into the realm's sessions bucket, one entry per session; the realm keeps no session state.

// Who an identity acts for: a Minecraft player (`minecraft`, its UUID) or a panel user (`user`, its id).
struct PrincipalId(83080001) {
  kind: string;
  id: string;
}

// The one actor a protagonist is, across every engine and connection it has.
struct Protagonist(83080002) {
  principal: PrincipalId;
}

// One engine of a realm: the topology engine instance id, `panel.<realm id>` for the realm's panel
// engine, or `local.<realm id>` for an engine of a host running without topology.
struct EngineId(83080003) {
  value: string;
}

// One connection of a protagonist, chosen by its engine kind: the player UUID for Minecraft, which
// survives server moves, or a per tab id for the panel, which survives reloads.
struct SessionId(83080004) {
  value: string;
}

// The value of one session's entry in the realm's sessions bucket.
struct SessionEntry(83080005) {
  protagonist: Protagonist;
  // When the session began; a rejoin while the session is vacant and a server move keep it.
  since: timestamp;
  // Whether an engine holds the session now, or nobody does while it waits for a takeover.
  state: SessionState;
}

// Who holds a session. A vacant session is alive, so a server move or a rejoin takes it over and nothing
// it owns ends, but nobody holds it: nothing is sent to the engine its protagonist left.
enum SessionState(83080006) {
  // An engine holds the connection now and keeps the entry alive.
  held: SessionHold;
  // The holder released the session when its protagonist left; it stays alive for its engine kind's
  // vacancy and ends unless an engine takes it over.
  vacant;
}

// The engine holding a session and when its connection began.
struct SessionHold(83080007) {
  holder: EngineId;
  // When the holder's connection began, on the holder's clock. Of two engines claiming the session,
  // the later connection holds it; at the same instant, the greater engine id does.
  connected: timestamp;
}
