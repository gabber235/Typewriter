// Sessions: who is connected to which engine of a realm. Each engine reports its own connections
// into the realm's sessions bucket, one entry per session; the realm keeps no session state.

import {
  EngineId,
  Protagonist,
} from "kernel/v1/identity.skir";

// The value of one session's entry in the realm's sessions bucket.
struct SessionEntry(83080001) {
  protagonist: Protagonist;
  // The engine that holds the connection now and keeps the entry alive.
  holder: EngineId;
  // When the session began; a rejoin within the grace and a server move keep it.
  since: timestamp;
}
