import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

// Separates the latest configuration requested by the control plane from the latest configuration applied by the host.
struct ReconciledRevision(83090001) {
  desired: int64;
  applied: int64;
}

// Selects an engine artifact and the version constraint a host must satisfy.
struct EngineTarget(83090002) {
  engine_id: string;
  version_constraint: string;
}

struct SupportedEngine(83090003) {
  engine_id: string;
}

enum HostRuntimeStatus(83090004) {
  offline;
  reconciling;
  active;
  failed;
  drifted;
}

// Host observation reported by the runtime. Message is diagnostic context, not configuration.
struct HostRuntimeState(83090005) {
  status: HostRuntimeStatus;
  message: string?;
  updated_at: timestamp;
}

enum ChildRuntimeStatus(83090006) {
  absent;
  staging;
  active;
  quiescing;
  failed;
  rolled_back;
  drifted;
}

// Runtime observation for a Realm or engine hosted by a service host. Active artifact version is present only when known.
struct ChildRuntimeState(83090007) {
  status: ChildRuntimeStatus;
  active_artifact_version: string?;
  message: string?;
  updated_at: timestamp;
}

// A service host registered in an organization. It owns the desired child assignments and reports their runtime state.
// revision protects host configuration writes. topology_revision tracks reconciliation separately from that write revision.
struct ServiceHost(83090008) {
  host_id: RecordId;
  service_id: RecordId;
  revision: int64;
  entrypoint: string;
  can_host_realm: bool;
  supported_engines: [SupportedEngine];
  topology_revision: ReconciledRevision;
  state: HostRuntimeState;
}

// Embedded host identity used by child resources and configuration results.
struct OwnerHost(83090009) {
  id: RecordId;
  name: string;
}

// Desired and observed state for a Realm runtime assigned to one host. Its revision changes when its target changes.
struct RealmInstance(83090010) {
  realm_id: RecordId;
  owner_host: OwnerHost;
  revision: int64;
  target_engine: EngineTarget;
  state: ChildRuntimeState;
}

// Reduced Realm reference embedded in an engine instance.
struct RealmInfo(83090011) {
  realm_id: RecordId;
  owner_host: OwnerHost;
}

// Desired and observed state for an engine runtime, including the Realm it is attached to.
struct EngineInstance(83090012) {
  engine_id: RecordId;
  owner_host: OwnerHost;
  realm: RealmInfo;
  revision: int64;
  target: EngineTarget;
  state: ChildRuntimeState;
}

// Configuration for creating or updating the Realm owned by the selected host.
struct HostedRealmConfiguration(83090013) {
  primary_engine: EngineTarget;
}

// Chooses whether the primary engine uses the host owned Realm or an existing Realm.
enum EngineRealmSelection(83090014) {
  hosted_realm;
  existing_realm: struct {
    realm_id: RecordId;
  };
}

// Configuration for the primary engine and the Realm to which it is attached.
struct HostedEngineConfiguration(83090015) {
  target: EngineTarget;
  realm: EngineRealmSelection;
}

// Complete desired execution configuration for a host. Null removes that hosted role.
struct HostExecutionConfiguration(83090016) {
  realm: HostedRealmConfiguration?;
  primary_engine: HostedEngineConfiguration?;
}

// Canonical result of a host configuration attempt, including current child resources and removals.
// It is also the payload used to reconcile organization topology projections after a committed change.
struct HostConfigurationChange(83090017) {
  host: ServiceHost;
  realm: RealmInstance?;
  engine: EngineInstance?;
  removed_resources: [RecordId];
}

// Applies a complete host execution configuration with optimistic concurrency. A successful result changes desired state;
// runtime activation is reported later through host execution updates.
method ConfigureServiceHost(
  struct {
    host_id: RecordId;
    expected_revision: int64;
    execution: HostExecutionConfiguration;
  }
): enum {
  success: HostConfigurationChange;

  /// Host changed elsewhere.
  conflict_error: struct {
    actual: HostConfigurationChange;
  };

  /// Host configuration is invalid.
  invalid_configuration_error: struct {
    message: string;
  };

  /// Engine target is incompatible.
  incompatible_engine_error: struct {
    target: EngineTarget;
  };

  /// Realm not found.
  realm_not_found_error: struct {
    realm_id: RecordId;
  };
  /// Record IDs from an unexpected table.
  invalid_record_id_error: InvalidRecordIdError;
  internal_error: InternalError;
} = 930901;

struct OrganizationTopologySnapshot(83090018) {
  hosts: [ServiceHost];
  realms: [RealmInstance];
  engines: [EngineInstance];
}

struct RealmRuntimeObservation(83090019) {
  realm_id: RecordId;
  state: ChildRuntimeState;
}

struct EngineRuntimeObservation(83090020) {
  engine_id: RecordId;
  state: ChildRuntimeState;
}

// The published host read model and current states of all assigned children after a runtime report.
// A child omitted by the report retains its previously stored state in this projection.
struct HostExecutionObservation(83090021) {
  host: ServiceHost;
  realm: RealmRuntimeObservation?;
  engine: EngineRuntimeObservation?;
}

enum OrganizationTopologyChanged(83090022) {
  replace: OrganizationTopologySnapshot;
  configuration_changed: HostConfigurationChange;
  observations_reported: HostExecutionObservation;
  host_advertised: ServiceHost;
}

// Reads the current organization topology snapshot. Later events use OrganizationTopologyChanged.
method WatchOrganizationTopology(
  struct {}
): enum {
  list: OrganizationTopologySnapshot;
  internal_error: InternalError;
} = 930902;

// Reads the desired child assignments for one service host. The topology revision identifies the assignment version to report.
method WatchHostExecution(
  struct {}
): enum {
  desired: struct {
    topology_revision: int64;
    realm: RealmInstance?;
    engine: EngineInstance?;
  };

  internal_error: InternalError;
} = 930903;

// Reports runtime observations for the assignment revision received from WatchHostExecution. Stale reports are rejected.
// The host is marked applied only when this report includes an active observation for every assigned child.
// Omitting a child preserves its stored observation but does not count it as active for this report.
method ReportHostExecution(
  struct {
    topology_revision: int64;
    realm_state: ChildRuntimeState?;
    engine_state: ChildRuntimeState?;
  }
): enum {
  success: struct {};
  /// Host topology revision is stale.
  stale_revision_error: struct {};
  internal_error: InternalError;
} = 930904;

// Identifies the organization and Realm relationships needed to route messages for a service.
struct ServiceMessagingScope(83090023) {
  organization_id: string;
  owned_realm: RecordId?;
  attached_realm: RecordId?;
}

// Resolves the messaging scope of a service, including its host owned Realm and attached Realm when present.
method GetServiceMessagingScope(
  struct {
    service_id: RecordId;
  }
): enum {
  found: ServiceMessagingScope;
  /// Service messaging scope not found.
  not_found_error: struct {};
  internal_error: InternalError;
} = 930905;

// Registers a service host and advertises the engine artifacts and Realm capability it supports.
method RegisterServiceHost(
  struct {
    entrypoint: string;
    can_host_realm: bool;
    supported_engines: [SupportedEngine];
  }
): enum {
  success: ServiceHost;
  internal_error: InternalError;
} = 930906;
