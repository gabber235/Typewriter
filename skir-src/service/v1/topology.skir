import { InternalError } from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct SemanticVersion {
  major: int32;
  minor: int32;
  patch: int32;
}

struct EngineTarget {
  engine_id: string;
  major_version: int32;
}

enum HostEntrypoint {
  standalone;
  paper;
}

struct SupportedEngine {
  engine_id: string;
  supported_major_versions: [int32];
}

enum HostRuntimeStatus {
  offline;
  reconciling;
  active;
  failed;
  drifted;
}

struct HostRuntimeState {
  status: HostRuntimeStatus;
  message: string?;
  updated_at: timestamp;
}

enum ChildRuntimeStatus {
  absent;
  staging;
  active;
  quiescing;
  failed;
  rolled_back;
  drifted;
}

struct ChildRuntimeState {
  status: ChildRuntimeStatus;
  active_artifact_version: SemanticVersion?;
  message: string?;
  updated_at: timestamp;
}

struct ServiceHost {
  host_id: RecordId;
  service_id: RecordId;
  revision: int64;
  entrypoint: HostEntrypoint;
  can_host_realm: bool;
  supported_engines: [SupportedEngine];
  desired_topology_revision: int64;
  applied_topology_revision: int64;
  state: HostRuntimeState;
}

struct RealmInstance {
  realm_id: RecordId;
  owner_host_id: RecordId;
  revision: int64;
  target_engine: EngineTarget;
  desired_manifest_revision: int64;
  applied_manifest_revision: int64;
  state: ChildRuntimeState;
}

struct EngineInstance {
  engine_id: RecordId;
  owner_host_id: RecordId;
  realm_id: RecordId;
  revision: int64;
  target: EngineTarget;
  desired_manifest_revision: int64;
  applied_manifest_revision: int64;
  state: ChildRuntimeState;
}

struct HostedRealmConfiguration {
  target_engine: EngineTarget;
}

enum EngineRealmSelection {
  hosted_realm;
  existing_realm: struct {
    realm_id: RecordId;
  };
}

struct HostedEngineConfiguration {
  target: EngineTarget;
  realm: EngineRealmSelection;
}

struct HostExecutionConfiguration {
  realm: HostedRealmConfiguration?;
  engine: HostedEngineConfiguration?;
}

method ConfigureServiceHost(
  struct {
    host_id: RecordId;
    expected_revision: int64;
    execution: HostExecutionConfiguration;
  }
): enum {
  success: struct {
    host: ServiceHost;
    realm: RealmInstance?;
    engine: EngineInstance?;
  };

  conflict_error: struct {
    actual: ServiceHost;
  };

  invalid_configuration_error: struct {
    message: string;
  };

  incompatible_engine_error: struct {
    target: EngineTarget;
  };

  realm_not_found_error: struct {
    realm_id: RecordId;
  };

  internal_error: InternalError;
} = 934201;

method WatchOrganizationTopology(
  struct {}
): enum {
  list: struct {
    hosts: [ServiceHost];
    realms: [RealmInstance];
    engines: [EngineInstance];
  };

  host_updated: ServiceHost;
  realm_updated: RealmInstance;
  engine_updated: EngineInstance;
  resource_removed: RecordId;
  internal_error: InternalError;
} = 934202;

method WatchHostExecution(
  struct {
    host_id: RecordId;
  }
): enum {
  desired: struct {
    topology_revision: int64;
    realm: RealmInstance?;
    engine: EngineInstance?;
  };

  internal_error: InternalError;
} = 934203;

method ReportHostExecution(
  struct {
    host_id: RecordId;
    topology_revision: int64;
    realm_state: ChildRuntimeState?;
    engine_state: ChildRuntimeState?;
  }
): enum {
  success: struct {};
  stale_revision_error: struct {};
  internal_error: InternalError;
} = 934204;
