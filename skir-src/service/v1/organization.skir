import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import { Service } from "service/v1/service.skir";

// Validation failures for organization owned service metadata. These are rejected without changing the service
// revision or publishing a service update.
enum ServiceUpdateValidationError(83040001) {
  name_invalid;
}

// Events for one organization service projection. Binding and unbinding replace the complete list.
// Metadata and liveness publish updates. Accepted command integration can remove an unbound identity.
// Only organization bound services belong in this projection.
enum OrganizationServicesChanged(83040002) {
  replace: [Service];
  update: Service;
  remove: RecordId;
}

// Reads the current organization service snapshot. Later events use OrganizationServicesChanged.
method WatchOrganizationServices(
  struct {}
): enum {
  internal_error: InternalError;

  list: [Service];
} = 930401;

// One requested rename of an organization service, guarded by the revision the caller last read.
struct ServiceRename(83040003) {
  service_id: RecordId;
  expected_revision: int64;
  name: string;
}

// Why one rename in a refused batch was not applied.
enum ServiceRenameRefusal(83040004) {
  /// Service changed elsewhere.
  conflict_error: struct {
    expected_revision: int64;
    actual: Service;
  };

  /// Service not found in organization.
  service_not_found_error: struct {};

  /// Service update is invalid.
  validation_error: ServiceUpdateValidationError;

  /// The same service appears more than once in the batch.
  duplicate_error: struct {};

  /// Record IDs from an unexpected table.
  invalid_record_id_error: InvalidRecordIdError;
}

// One rename that kept its batch from being applied.
struct RefusedServiceRename(83040005) {
  service_id: RecordId;
  reason: ServiceRenameRefusal;
}

// Renames organization services as one all or nothing batch; a single rename is a batch of one.
// The registration service owns each revision and increments it only after accepting the batch. A stale expected
// revision refuses the batch with the current service, unless the requested name is already stored: then that item
// succeeds with the stored service unchanged, so a client may resend a batch whose reply was lost.
// refused_error lists every item that kept the batch from applying; nothing changed.
// success lists the resulting services in request order.
method UpdateOrganizationServices(
  struct {
    renames: [ServiceRename];
  }
): enum {
  internal_error: InternalError;

  success: [Service];

  /// One or more renames were refused; nothing changed.
  refused_error: [RefusedServiceRename];
} = 930402;
