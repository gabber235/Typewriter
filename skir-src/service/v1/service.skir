import { RecordId } from "kernel/v1/record_id.skir";

struct Service {
  service_id: RecordId;
  revision: int64;
  name: string;
  role: ServiceRole;
  created_at: timestamp;
  organization: RecordId?;
  registration: ServiceRegistration?;
  state: ServiceState?;
}

enum ServiceRole {
  host: struct {
    version: string;
  } = 1;
  custom: struct {
    name: string;
    version: string;
  } = 2;
}

enum ServiceStatus {
  online;
  offline;
}

struct ServiceState {
  status: ServiceStatus;
  last_seen: timestamp;
}

struct ServiceRegistration {
  token: string;
  expires_at: timestamp;
}
