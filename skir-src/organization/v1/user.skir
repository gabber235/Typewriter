// User scoped organization operations expose the projections a user needs to discover memberships and manage their own join requests.
// Organization membership and pending request views are separate streams, each with its own sequence and change events.

import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import {
  AutoAcceptedMember,
  UserJoinRequest,
  UserJoinRequestsChanged,
  UserJoinRequestsSnapshot,
} from "organization/v1/join_request.skir";
import {
  UserOrganizationsChanged,
  UserOrganizationsSnapshot,
} from "organization/v1/organization.skir";

// Reads the organizations currently visible to the user. Membership changes publish later list changes on the user stream.
method WatchUserOrganizations(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: UserOrganizationsSnapshot;
  changed: UserOrganizationsChanged;
} = 246975;

// Reads all unexpired join requests made by the user. Request changes publish later user scoped changes.
method WatchUserJoinRequests(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: UserJoinRequestsSnapshot;
  changed: UserJoinRequestsChanged;
} = 939197;

// Submits one join code for the authenticated user.
// A valid code either creates a pending request or immediately creates membership when its auto acceptance policy applies.
// Single use codes are consumed as part of the successful submission.
method SubmitUserJoinRequest(
  struct {
    operation_id: string;
    code: RecordId;
  }
): enum {
  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  internal_error: InternalError;

  request_made: struct {
    request: UserJoinRequest;
    event: UserJoinRequestsChanged;
  };
  auto_accepted: struct {
    member: AutoAcceptedMember;
    event: UserOrganizationsChanged;
  };

  code_not_found_error: struct {
    code: RecordId;
  };
  already_member_error: struct {};
  no_assignable_roles_error: struct {};
  max_pending_requests_error: struct {};
  pending_request_exists_error: struct {};

  invalid_record_id_error: InvalidRecordIdError;
} = 4962;

// Cancels one pending request made by the user and publishes its removal from the user request view.
// The organization request view receives the corresponding removal as well.
method CancelUserJoinRequest(
  struct {
    operation_id: string;
    request_id: RecordId;
  }
): enum {
  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  internal_error: InternalError;

  success: struct {
    event: UserJoinRequestsChanged;
  };

  request_not_found_error: struct {
    request_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 387737;
