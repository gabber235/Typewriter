// Organization roles define the labels and assignment policy used by membership operations.
// Protected roles remain visible in member values but are controlled by organization invariants rather than ordinary role selection.

import { Color } from "kernel/v1/color.skir";
import { InternalError } from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

// One organization role. Assignable controls ordinary administrator selection, while deletable controls role removal policy.
struct OrganizationRole(82060001) {
  role_id: RecordId;
  name: string;
  color: Color;
  // Fallback role for member updates whose requested and retained protected roles are empty.
  default_role: bool;
  // Whether administrators may include this role in an ordinary assignment.
  assignable: bool;
  // Advertised role removal policy. References from members and join codes impose further restrictions.
  deletable: bool;
}

// Returns the current roles for the selected organization. The response can also carry role changes for streaming consumers.
method WatchOrganizationRoles(
  struct {}
): enum {
  internal_error: InternalError;

  list: [OrganizationRole];
  add: OrganizationRole;
  update: OrganizationRole;
  remove: RecordId;
} = 920601;
