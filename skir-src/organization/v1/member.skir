import { RecordId } from "kernel/v1/record_id.skir";
import { OrganizationRole } from "organization/v1/role.skir";

struct OrganizationMember {
  user_id: RecordId;
  name: string?;
  email: string?;
  avatar_url: string?;
  roles: [OrganizationRole];
  joined_at: timestamp;
}

method WatchOrganizationMembers(
  struct {}
): enum {
  internal_error: struct {};

  list: [OrganizationMember];
  add: OrganizationMember;
  update: OrganizationMember;
  remove: RecordId;
} = 638484;

method UpdateOrganizationMemberRoles(
  struct {
    user_id: RecordId;
    role_ids: [RecordId];
  }
): enum {
  internal_error: struct {};

  success: OrganizationMember;

  user_not_found_error: struct {
    user_id: RecordId;
  };
  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  roles_not_assignable_error: struct {
    role_ids: [RecordId];
  };
  roles_required_error: struct {};
  founder_role_required_error: struct {};
} = 813953;

method RemoveOrganizationMember(
  struct {
    user_id: RecordId;
  }
): enum {
  internal_error: struct {};

  success: struct {};

  user_not_member_error: struct {
    user_id: RecordId;
  };
  founder_cannot_be_removed_error: struct {
    user_id: RecordId;
  };
} = 291414;
