// Organization membership is the authoritative organization projection for member roles and profile data.
// The snapshot and change stream share one organization sequence, allowing clients to recover from missed or repeated changes.

import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import { OrganizationRole } from "organization/v1/role.skir";

struct OrganizationMember(82030001) {
  user_id: RecordId;
  name: string?;
  email: string?;
  avatar_url: string?;
  roles: [OrganizationRole];
  joined_at: timestamp;
}

struct OrganizationMembersSnapshot(82030002) {
  sequence: int64;
  values: [OrganizationMember];
}

enum OrganizationMembersChange(82030003) {
  add: OrganizationMember;
  update: OrganizationMember;
  remove: RecordId;
}

struct OrganizationMembersChanged(82030004) {
  sequence: int64;
  changes: [OrganizationMembersChange];
}

// Reads the current organization membership projection. Later committed changes are published separately.
method WatchOrganizationMembers(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: OrganizationMembersSnapshot;
} = 920301;

// Applies one assignable role selection to every selected member in one transaction.
// Protected roles remain assigned. Any invalid target rejects the complete selection, so the response never describes a partial update.
method UpdateOrganizationMemberRoles(
  struct {
    user_ids: [RecordId];
    role_ids: [RecordId];
  }
): enum {
  internal_error: InternalError;
  success: struct {
    members: [OrganizationMember];
    event: OrganizationMembersChanged;
  };
  /// Users not found.
  user_not_found_error: struct {
    user_ids: [RecordId];
  };
  /// Roles not found.
  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  /// Roles not assignable.
  roles_not_assignable_error: struct {
    user_ids: [RecordId];
    role_ids: [RecordId];
  };
  /// At least one role is required.
  roles_required_error: struct {
    user_ids: [RecordId];
  };
  /// Founder role is required.
  founder_role_required_error: struct {};
  /// Selection must contain distinct targets.
  invalid_selection_error: struct {};
  /// Record IDs from an unexpected table.
  invalid_record_id_error: InvalidRecordIdError;
} = 920302;

// Removes one membership and publishes the corresponding organization change.
// The original founder cannot be removed while the organization exists. Other members cannot be
// removed if that would leave no holder of the founder role.
method RemoveOrganizationMember(
  struct {
    user_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    event: OrganizationMembersChanged;
  };

  /// User is not a member.
  user_not_member_error: struct {
    user_id: RecordId;
  };
  /// Founder cannot be removed.
  founder_cannot_be_removed_error: struct {
    user_id: RecordId;
  };

  /// Record IDs from an unexpected table.
  invalid_record_id_error: InvalidRecordIdError;
} = 920303;
