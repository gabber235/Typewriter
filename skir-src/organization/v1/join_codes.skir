// Organization join codes are the organization owned invitation projection. Watchers receive a current snapshot, then sequenced changes for creation, consumption, and revocation.
// Codes are read as active while unexpired. A single use code is removed when a join submission consumes it.

import { Duration } from "kernel/v1/duration.skir";
import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

// JoinCode is the persisted invitation identity and its admission policy.
// A null expiry means the code does not expire. Auto accepted roles are validated as assignable before the code is created.
struct JoinCode {
  code: RecordId;
  created_at: timestamp;
  expires_at: timestamp?;
  single_use: bool;
  auto_accept: struct {
    role_ids: [RecordId];
  };
}

// Current active codes and the organization sequence at the same read point.
struct OrganizationJoinCodesSnapshot {
  sequence: int64;
  values: [JoinCode];
}

enum OrganizationJoinCodesChange {
  add: JoinCode;
  remove: RecordId;
}

// Changes to the active code projection. Consumers apply changes only when sequence advances and refresh on a gap.
struct OrganizationJoinCodesChanged {
  sequence: int64;
  changes: [OrganizationJoinCodesChange];
}

// Reads the current active codes. Later changes are published separately on the organization code stream.
method WatchOrganizationJoinCodes(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: OrganizationJoinCodesSnapshot;
  changed: OrganizationJoinCodesChanged;
} = 690316;

// Creates an invitation code and emits its add change after the transaction commits.
method GenerateOrganizationJoinCode(
  struct {
    single_use: bool;
    expiration: enum {
      never;
      duration: Duration;
    };
    auto_accept: struct {
      role_ids: [RecordId];
    };
  }
): enum {
  internal_error: InternalError;

  success: struct {
    code: JoinCode;
    event: OrganizationJoinCodesChanged;
  };

  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  roles_not_assignable_error: struct {
    role_ids: [RecordId];
  };
  invalid_expiration_error: struct {
    duration: Duration;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 804958;

// Removes an active invitation code and emits its remove change after the transaction commits.
// An expired or already removed code is reported as not found.
method RevokeOrganizationJoinCode(
  struct {
    code_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    event: OrganizationJoinCodesChanged;
  };

  code_not_found_error: struct {
    code_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 510187;
