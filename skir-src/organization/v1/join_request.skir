// Join requests have two read models for one pending request. The organization view supports moderation, while the user view supports tracking and cancellation.
// Both views expose only unexpired requests. Their sequences belong to their respective owners and must be reconciled independently.

import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import {
  OrganizationMember,
  OrganizationMembersChanged,
} from "organization/v1/member.skir";
import { OrganizationRole } from "organization/v1/role.skir";

// OrganizationJoinRequest is the moderation view of one unexpired request.
// Profile fields are optional because the organization may not have every user profile attribute.
struct OrganizationJoinRequest {
  request_id: RecordId;
  user_id: RecordId;
  user_name: string?;
  user_email: string?;
  user_avatar_url: string?;
  requested_at: timestamp;
  expires_at: timestamp;
}

// UserJoinRequest is the requesting user's view of one unexpired request.
// It carries organization display data because this view is not scoped to one organization.
struct UserJoinRequest {
  request_id: RecordId;
  organization_id: RecordId;
  organization_name: string;
  organization_logo_url: string;
  requested_at: timestamp;
  expires_at: timestamp;
}

// Current unexpired requests for one organization and that organization's request sequence.
struct OrganizationJoinRequestsSnapshot {
  sequence: int64;
  values: [OrganizationJoinRequest];
}

enum OrganizationJoinRequestsChange {
  add: OrganizationJoinRequest;
  remove: RecordId;
}

// Organization request changes. Consumers apply them in sequence order and refresh when a sequence gap appears.
struct OrganizationJoinRequestsChanged {
  sequence: int64;
  changes: [OrganizationJoinRequestsChange];
}

// Current unexpired requests for one user and that user's request sequence.
struct UserJoinRequestsSnapshot {
  sequence: int64;
  values: [UserJoinRequest];
}

enum UserJoinRequestsChange {
  add: UserJoinRequest;
  remove: RecordId;
}

// User request changes. This sequence is independent from the organization request sequence for the same request.
struct UserJoinRequestsChanged {
  sequence: int64;
  changes: [UserJoinRequestsChange];
}

struct AutoAcceptedMember {
  organization_id: RecordId;
  organization_name: string;
  organization_logo_url: string?;
  roles: [OrganizationRole];
}

// Reads the organization moderation view. Pending request changes are published on the organization stream.
method WatchOrganizationJoinRequests(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: OrganizationJoinRequestsSnapshot;
  changed: OrganizationJoinRequestsChanged;
} = 399821;

struct ApprovedOrganizationJoinRequest {
  request_id: RecordId;
  member: OrganizationMember;
}

// Approves all selected requests in one transaction, creates their memberships, and removes the requests.
// The selected role set is applied to every approved request. Any invalid request or role rejects the complete selection.
// Success includes the organization request and member changes so consumers can reconcile both projections.
method ApproveOrganizationJoinRequests(
  struct {
    request_ids: [RecordId];
    role_ids: [RecordId];
  }
): enum {
  internal_error: InternalError;
  success: struct {
    approvals: [ApprovedOrganizationJoinRequest];
    join_requests_event: OrganizationJoinRequestsChanged;
    members_event: OrganizationMembersChanged;
  };
  request_not_found_error: struct {
    request_ids: [RecordId];
  };
  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  roles_not_assignable_error: struct {
    role_ids: [RecordId];
  };
  roles_required_error: struct {};
  user_already_member_error: struct {
    user_ids: [RecordId];
  };
  invalid_selection_error: struct {};
  invalid_record_id_error: InvalidRecordIdError;
} = 167357;

// Declines one request and removes it from both the organization and user pending request views.
// The response event is the organization event; the user stream also receives its corresponding removal.
method DeclineOrganizationJoinRequest(
  struct {
    request_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {
    event: OrganizationJoinRequestsChanged;
  };

  request_not_found_error: struct {
    request_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 329306;
