import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import { OrganizationMember } from "organization/v1/member.skir";
import { OrganizationRole } from "organization/v1/role.skir";

// OrganizationJoinRequest represents a pending request from a user to join an organization.
struct OrganizationJoinRequest {
  request_id: RecordId;
  user_id: RecordId;
  user_name: string?;
  user_email: string?;
  user_avatar_url: string?;
  requested_at: timestamp;
  expires_at: timestamp;
}

// UserJoinRequest represents a user's own pending request to join an organization.
// This is from the user's perspective, showing which organizations they've requested to join.
struct UserJoinRequest {
  request_id: RecordId;
  organization_id: RecordId;
  organization_name: string;
  organization_logo_url: string;
  requested_at: timestamp;
  expires_at: timestamp;
}

struct AutoAcceptedMember {
  organization_id: RecordId;
  organization_name: string;
  organization_logo_url: string?;
  roles: [OrganizationRole];
}

method WatchOrganizationJoinRequests(
  struct {}
): enum {
  internal_error: InternalError;

  list: [OrganizationJoinRequest];
  add: OrganizationJoinRequest;
  remove: RecordId;
} = 399821;

method ApproveOrganizationJoinRequest(
  struct {
    request_id: RecordId;
    role_ids: [RecordId];
  }
): enum {
  internal_error: InternalError;

  success: OrganizationMember;

  request_not_found_error: struct {
    request_id: RecordId;
  };
  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  roles_not_assignable_error: struct {
    role_ids: [RecordId];
  };
  roles_required_error: struct {};
  user_already_member_error: struct {
    user_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 167357;

method DeclineOrganizationJoinRequest(
  struct {
    request_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {};

  request_not_found_error: struct {
    request_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 329306;
