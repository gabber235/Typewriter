  "FieldEditor": {
    "prefix": "tweditor",
    "body": [
      "import \"package:flutter/material.dart\";",
      "import \"package:flutter_hooks/flutter_hooks.dart\";",
      "import \"package:hooks_riverpod/hooks_riverpod.dart\";",
      "import \"package:iconify_flutter_plus/icons/heroicons_solid.dart\";",
      "import \"package:typewriter_panel/logic/selectable/data_blueprint.dart\";",
      "import \"package:typewriter_panel/logic/selectable/selection.dart\";",
      "import \"package:typewriter_panel/utils/snake_case_input_formatter.dart\";",
      "",
      "import \"package:typewriter_panel/widgets/app/components/inspector/editors.dart\";",
      "import \"package:typewriter_panel/widgets/app/components/inspector/editors/field_editor.dart\";",
      "import \"package:typewriter_panel/widgets/generic/components/formatted_text_field.dart\";",
      "",
      "class ${1}Editor extends Editor {",
      "  @override",
      "  bool canEdit(DataBlueprint dataBlueprint) =>",
      "      dataBlueprint.matches(DataBlueprint.${1/^(.)(.*)$/${1:/downcase}${2}/}());",
      "",
      "  @override",
      "  Widget build(",
      "    String path,",
      "    DataBlueprint dataBlueprint,",
      "    EditorMode editorMode,",
      "  ) {",
      "    return ${1}EditorWidget(",
      "      path: path,",
      "      ${2|primitiveBlueprint,enumBlueprint,listBlueprint,mapBlueprint,objectBlueprint,algebraicBlueprint,customBlueprint|}: dataBlueprint as ${2/^([a-z])([a-z]+)Blueprint$/${1:/upcase}${2}Blueprint/},",
      "      editorMode: editorMode,",
      "    );",
      "  }",
      "}",
      "",
      "class ${1}EditorWidget extends HookConsumerWidget {",
      "  const ${1}EditorWidget({",
      "    required this.path,",
      "    required this.${2},",
      "    required this.editorMode,",
      "    super.key,",
      "  });",
      "  final String path;",
      "  final ${2/^([a-z])([a-z]+)Blueprint$/${1:/upcase}${2}Blueprint/} ${2};",
      "  final EditorMode editorMode;",
      "",
      "  @override",
      "  Widget build(BuildContext context, WidgetRef ref) {",
      "    final focusNode = useFocusNode();",
      "    final canEdit = (editorMode, ${2}).canEdit;",
      "",
      "    return FieldValueEditor(",
      "      path: path,",
      "      dataBlueprint: ${2},",
      "      editorMode: editorMode,",
      "      builder: (value) {",
      "        return ${4:Container()};",
      "      },",
      "    );",
      "  }",
      "}"
    ],
    "description": "Creates a Field Editor with selectable blueprint types"
  }
}
