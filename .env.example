# The fallback for contributors without the Typewriter 1Password vault: copy this file to `.env`
# and uncomment the keys a command needs. secretspec.toml describes each key and its profile;
# `cargo xtask secrets check` shows what is missing. An empty value counts as set, so leave the
# keys you do not use commented. SECRETSPEC_PROVIDER=local reads only this file.

# default: local tools
# FIBERY_WORKSPACE=
# FIBERY_API_TOKEN=
# GREPTIME_USERNAME=
# GREPTIME_PASSWORD=

# deploy: cargo xtask deploy local
# LOCAL_REGISTRY_PASSWORD=

# ci: the full tier
# CI_AGE_KEY=
# CI_REGISTRY_PASSWORD=
# INFRASTRUCTURE_DEPLOY_KEY=

# bot: the Discord bot
# DISCORD_TOKEN=
# CLICKUP_TOKEN=
# CLICKUP_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SIGNATURE=

# release: the release workflows
# MODRINTH_TOKEN=
# SPONSORS_GITHUB_TOKEN=

# marketplace: the marketplace website
# AUTH_SECRET=
# AUTH_AUTHENTIK_SECRET=
