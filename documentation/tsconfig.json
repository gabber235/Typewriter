{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@components/*": ["./src/components/*"],
			"@lib/*": ["./src/lib/*"],
			"@assets/*": ["./src/assets/*"],
			"@styles/*": ["./src/styles/*"],
			"@content/*": ["./src/content/*"]
		}
	},
	"contentMappers": [
		{
			"package": "@astrojs/ts-content-mapper",
			"extensions": [".astro"]
		}
	]
}
