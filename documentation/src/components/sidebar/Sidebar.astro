---
import { processSidebarBadges } from "../badge";
import SidebarList from "./SidebarList.astro";

const { sidebar } = Astro.locals.starlightRoute;
const sidebarWithBadges = await processSidebarBadges(
	sidebar as Parameters<typeof processSidebarBadges>[0],
);
---

<nav class="py-2" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
  <SidebarList sublist={sidebarWithBadges} />
</nav>

<script>
  import { navigate } from "astro:transitions/client";
  import { prefetch } from "astro:prefetch";

  (function () {
    // ========================================
    // CONSTANTS
    // ========================================
    const STORAGE_KEY = "sidebar-groups-state";
    const ANIMATION_DURATION = 200;
    const SELECTORS = {
      group: ".sidebar-group",
      content: ".sidebar-content",
      toggle: ".sidebar-toggle",
      groupLink: ".sidebar-group-link",
    };

    // ========================================
    // STATE MANAGEMENT (localStorage)
    // ========================================
    let cachedState: Record<string, boolean> | null = null;

    function getStoredState(): Record<string, boolean> {
      if (cachedState !== null) return cachedState;
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        cachedState = stored ? JSON.parse(stored) : {};
      } catch {
        cachedState = {};
      }
      return cachedState ?? {};
    }

    function saveState(groupId: string, isOpen: boolean) {
      const state = getStoredState();
      state[groupId] = isOpen;
      cachedState = state;
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        // Ignore storage errors
      }
    }

    // ========================================
    // SIBLING ACCORDION LOGIC
    // ========================================
    function getSiblingToCollapse(
      openedDetails: HTMLDetailsElement,
    ): HTMLDetailsElement | null {
      const parentLi = openedDetails.closest("li");
      if (!parentLi) return null;

      const parentUl = parentLi.parentElement;
      if (!parentUl) return null;

      const siblingDetails = parentUl.querySelectorAll<HTMLDetailsElement>(
        `:scope > li > .sidebar-group`,
      );

      for (let i = 0; i < siblingDetails.length; i++) {
        const details = siblingDetails[i];
        if (details !== openedDetails && details.open) {
          return details;
        }
      }
      return null;
    }

    // ========================================
    // ANIMATION HELPERS
    // ========================================
    function createTransition() {
      return `height ${ANIMATION_DURATION}ms ease-in-out`;
    }

    function animateCollapse(content: HTMLElement, onComplete?: () => void) {
      const currentHeight = content.scrollHeight;
      content.style.transition = "none";
      content.style.height = currentHeight + "px";
      content.offsetHeight; // Force reflow

      content.style.transition = createTransition();
      content.style.height = "0px";

      function cleanup() {
        content.removeEventListener("transitionend", cleanup);
        content.style.transition = "";
        content.style.height = "0px";
        if (onComplete) onComplete();
      }
      content.addEventListener("transitionend", cleanup);
    }

    // ========================================
    // GROUP TOGGLE OPERATIONS
    // ========================================
    function toggleGroup(details: HTMLDetailsElement) {
      const groupId = details.dataset.groupId;
      if (!groupId) return;

      const willOpen = !details.open;
      const content = details.querySelector<HTMLElement>(SELECTORS.content);
      if (!content) return;

      if (willOpen) {
        openGroupWithSiblingCollapse(details, content, groupId);
      } else {
        closeGroup(details, content, groupId);
      }
    }

    function openGroupWithSiblingCollapse(
      details: HTMLDetailsElement,
      content: HTMLElement,
      groupId: string,
    ) {
      // Find and prepare sibling to collapse
      const siblingToCollapse = getSiblingToCollapse(details);
      let siblingContent: HTMLElement | null = null;
      let siblingHeight = 0;

      if (siblingToCollapse) {
        siblingContent = siblingToCollapse.querySelector<HTMLElement>(
          SELECTORS.content,
        );
        if (siblingContent) {
          siblingHeight = siblingContent.scrollHeight;
        }
      }

      // Open and measure target
      details.open = true;
      content.style.height = "auto";
      const targetHeight = content.scrollHeight;

      // Prepare for synchronized animation
      content.style.transition = "none";
      content.style.height = "0px";

      if (siblingContent) {
        siblingContent.style.transition = "none";
        siblingContent.style.height = siblingHeight + "px";
      }

      content.offsetHeight; // Force reflow

      // Animate both simultaneously
      const transition = createTransition();
      content.style.transition = transition;
      content.style.height = targetHeight + "px";

      if (siblingContent) {
        siblingContent.style.transition = transition;
        siblingContent.style.height = "0px";
      }

      // Cleanup handlers
      function cleanupExpand() {
        content.removeEventListener("transitionend", cleanupExpand);
        content.style.transition = "";
        content.style.height = "auto";
      }
      content.addEventListener("transitionend", cleanupExpand);

      if (siblingContent) {
        const sc = siblingContent;
        const siblingDetails = siblingToCollapse as HTMLDetailsElement;
        function cleanupCollapse() {
          sc.removeEventListener("transitionend", cleanupCollapse);
          sc.style.transition = "";
          sc.style.height = "0px";
          siblingDetails.open = false;
        }
        sc.addEventListener("transitionend", cleanupCollapse);

        const siblingId = siblingDetails.dataset.groupId;
        if (siblingId) {
          saveState(siblingId, false);
        }
      }

      saveState(groupId, true);
    }

    function closeGroup(
      details: HTMLDetailsElement,
      content: HTMLElement,
      groupId: string,
    ) {
      animateCollapse(content, function () {
        details.open = false;
      });
      saveState(groupId, false);
    }

    // Expand group without toggle (for navigation)
    function expandGroup(details: HTMLDetailsElement) {
      if (details.open) return;

      const groupId = details.dataset.groupId;
      const content = details.querySelector<HTMLElement>(SELECTORS.content);
      if (!content) return;

      // Find sibling to collapse
      const siblingToCollapse = getSiblingToCollapse(details);
      let siblingContent: HTMLElement | null = null;
      let siblingHeight = 0;

      if (siblingToCollapse) {
        siblingContent = siblingToCollapse.querySelector<HTMLElement>(
          SELECTORS.content,
        );
        if (siblingContent) {
          siblingHeight = siblingContent.scrollHeight;
        }
      }

      details.open = true;
      content.style.height = "auto";
      const targetHeight = content.scrollHeight;

      content.style.transition = "none";
      content.style.height = "0px";

      if (siblingContent) {
        siblingContent.style.transition = "none";
        siblingContent.style.height = siblingHeight + "px";
      }

      content.offsetHeight;

      const transition = createTransition();
      content.style.transition = transition;
      content.style.height = targetHeight + "px";

      if (siblingContent) {
        siblingContent.style.transition = transition;
        siblingContent.style.height = "0px";
      }

      const c = content;
      function cleanupExpand() {
        c.removeEventListener("transitionend", cleanupExpand);
        c.style.transition = "";
        c.style.height = "auto";
      }
      c.addEventListener("transitionend", cleanupExpand);

      if (siblingContent) {
        const sc = siblingContent;
        const siblingDetails = siblingToCollapse as HTMLDetailsElement;
        function cleanupCollapse() {
          sc.removeEventListener("transitionend", cleanupCollapse);
          sc.style.transition = "";
          sc.style.height = "0px";
          siblingDetails.open = false;
        }
        sc.addEventListener("transitionend", cleanupCollapse);

        const siblingId = siblingDetails.dataset.groupId;
        if (siblingId) {
          saveState(siblingId, false);
        }
      }

      if (groupId) {
        saveState(groupId, true);
      }
    }

    // The nav element that actually holds the sidebar entries (returns null on
    // pages without a sidebar, e.g. the splash homepage). Used as the target for
    // the `.sidebar-ready` reveal class so it lands on an ancestor of the
    // content even when the sidebar was rebuilt after visiting a no-sidebar page.
    function getSidebarNav() {
      const anchor = document.querySelector(
        `${SELECTORS.group}, a[data-sidebar-link]`,
      );
      return anchor ? anchor.closest("nav[aria-label]") : null;
    }

    // ========================================
    // STATE RESTORATION
    // ========================================
    // Applies the persisted open/closed group state from localStorage and
    // reveals the sidebar. Runs on first load, on hard refresh, and whenever a
    // fresh sidebar is rendered (e.g. after returning from the splash page,
    // which drops the persisted sidebar). A persisted sidebar that is already
    // revealed is left untouched — see ensureSidebarReady().
    function restoreGroupStates() {
      cachedState = null;
      const state = getStoredState();
      const groups = document.querySelectorAll<HTMLDetailsElement>(
        SELECTORS.group,
      );
      const nav = getSidebarNav();

      groups.forEach(function (details) {
        const groupId = details.dataset.groupId;
        if (!groupId) return;

        const shouldBeOpen = state[groupId] === true;
        const content = details.querySelector<HTMLElement>(SELECTORS.content);

        // Close siblings if this group should be open (accordion behaviour)
        if (shouldBeOpen) {
          const siblingToClose = getSiblingToCollapse(details);
          if (siblingToClose) {
            siblingToClose.open = false;
            const siblingContent = siblingToClose.querySelector<HTMLElement>(
              SELECTORS.content,
            );
            if (siblingContent) siblingContent.style.height = "0px";
            const siblingId = siblingToClose.dataset.groupId;
            if (siblingId) {
              state[siblingId] = false;
            }
          }
        }

        details.open = shouldBeOpen;
        if (content) {
          content.style.height = shouldBeOpen ? "auto" : "0px";
        }
      });

      // Save updated state after sibling closures
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        cachedState = state;
      } catch {
        // Ignore storage errors
      }

      // Reveal sidebar now that states are set
      if (nav) nav.classList.add("sidebar-ready");
    }

    // ========================================
    // ACTIVE-STATE SYNC (runs on every navigation)
    // ========================================
    // The sidebar DOM is persisted across client-side navigations, so its
    // active highlight no longer changes via a server re-render. This recomputes
    // which link/group is current from the URL, expands the relevant groups, and
    // scrolls the active link into view.
    function normalizePath(path: string): string {
      try {
        path = new URL(path, window.location.href).pathname;
      } catch {
        // keep raw path on failure
      }
      return path.replace(/\/+$/, "") || "/";
    }

    function updateActiveState() {
      const current = normalizePath(window.location.pathname);

      // Clear previous markers
      document
        .querySelectorAll("a[data-sidebar-link][aria-current]")
        .forEach((a) => a.removeAttribute("aria-current"));
      document
        .querySelectorAll(`${SELECTORS.group} > summary[data-current]`)
        .forEach((s) => s.removeAttribute("data-current"));
      document
        .querySelectorAll(`${SELECTORS.group} > summary[data-has-current]`)
        .forEach((s) => s.removeAttribute("data-has-current"));

      // Find the active element: a leaf link or a group whose index page matches
      let activeEl: HTMLAnchorElement | HTMLDetailsElement | null = null;
      document
        .querySelectorAll<HTMLAnchorElement>("a[data-sidebar-link]")
        .forEach((a) => {
          if (
            !activeEl &&
            normalizePath(a.getAttribute("href") || "") === current
          ) {
            a.setAttribute("aria-current", "page");
            activeEl = a;
          }
        });

      document
        .querySelectorAll<HTMLDetailsElement>(SELECTORS.group)
        .forEach((details) => {
          const groupHref = details.dataset.href;
          if (!groupHref) return;
          const summary = details.querySelector(":scope > summary");
          if (!summary) return;
          if (normalizePath(groupHref) === current) {
            summary.setAttribute("data-current", "true");
            if (!activeEl) activeEl = details;
          }
        });

      if (!activeEl) return;
      // TS can't track assignments made inside the forEach closures above,
      // so it still sees `activeEl` as possibly `null` here.
      const active = activeEl as HTMLAnchorElement | HTMLDetailsElement;

      // Mark + expand every ancestor group of the active element
      let group = active.closest<HTMLDetailsElement>(SELECTORS.group);
      while (group) {
        const summary = group.querySelector(":scope > summary");
        if (summary) summary.setAttribute("data-has-current", "true");
        expandGroup(group);
        const parent = group.parentElement;
        group = parent
          ? parent.closest<HTMLDetailsElement>(SELECTORS.group)
          : null;
      }

      // Bring the active link into view within the sidebar scroller
      const target =
        active.tagName === "DETAILS"
          ? active.querySelector(":scope > summary") || active
          : active;
      target.scrollIntoView({ block: "nearest" });
    }

    // ========================================
    // EVENT HANDLERS (delegated)
    // ========================================
    function handleToggleClick(e: Event, toggleBtn: HTMLElement) {
      e.preventDefault();
      e.stopPropagation();
      const details = toggleBtn.closest<HTMLDetailsElement>(SELECTORS.group);
      if (details) {
        toggleGroup(details);
      }
    }

    function handleLabelClick(e: Event, labelSpan: HTMLElement) {
      // Only handle non-link labels (for groups without index pages)
      const summary = labelSpan.closest("summary");
      const details = summary
        ? summary.closest<HTMLDetailsElement>(SELECTORS.group)
        : null;
      if (!details) return;

      const href = details.dataset.href || "";
      const groupId = details.dataset.groupId || "";
      const isCurrentPage =
        href && normalizePath(href) === normalizePath(window.location.pathname);

      e.preventDefault();
      e.stopPropagation();
      // If there's an href and we're not on this page, navigate without toggling
      if (href && !isCurrentPage) {
        if (groupId) saveState(groupId, true);
        navigate(href);
      } else {
        // Otherwise toggle (on same page or no href)
        toggleGroup(details);
      }
    }

    // Single delegated click listener
    document.addEventListener("click", function (e) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Handle toggle button clicks (highest priority)
      const toggleBtn = target.closest<HTMLElement>(SELECTORS.toggle);
      if (toggleBtn) {
        handleToggleClick(e, toggleBtn);
        return;
      }

      // Handle SVG chevron clicks (toggle group)
      const svg = target.closest(`${SELECTORS.group} > summary svg`);
      if (svg) {
        e.preventDefault();
        e.stopPropagation();
        const details = svg.closest<HTMLDetailsElement>(SELECTORS.group);
        if (details) {
          toggleGroup(details);
        }
        return;
      }

      // Handle non-link label clicks
      const labelSpan = target.closest<HTMLElement>(
        `${SELECTORS.group} > summary > span`,
      );
      if (labelSpan) {
        handleLabelClick(e, labelSpan);
        return;
      }

      // Handle summary clicks (for groups with href)
      const summary = target.closest(`${SELECTORS.group} > summary`);
      if (summary) {
        e.preventDefault();
        const details = summary.closest<HTMLDetailsElement>(SELECTORS.group);
        const href = details ? details.dataset.href : "";
        const groupId = details ? details.dataset.groupId : "";
        const isCurrentPage =
          href &&
          normalizePath(href) === normalizePath(window.location.pathname);

        // If there's an href and we're not on this page, navigate
        if (href && !isCurrentPage) {
          if (groupId) saveState(groupId, true);
          navigate(href);
        } else if (details) {
          // Otherwise toggle the group (if on current page or no href)
          toggleGroup(details);
        }
        return;
      }
    });

    // Reveal + restore a sidebar that hasn't been initialized yet. For a
    // persisted sidebar this is a no-op (it is already `.sidebar-ready`); for a
    // freshly rendered one (initial load, hard refresh, or returning from the
    // splash page) it applies stored state and reveals it.
    function ensureSidebarReady() {
      const nav = getSidebarNav();
      if (nav && !nav.classList.contains("sidebar-ready")) {
        restoreGroupStates();
      }
    }

    // ========================================
    // PREFETCH GROUP TARGETS ON HOVER
    // ========================================
    // Leaf links prefetch via `data-astro-prefetch="hover"`, but group rows
    // navigate with navigate() rather than a real <a>, so Astro's prefetch
    // can't see them. Prefetch the group's index page on hover, once per href.
    const prefetched = new Set<string>();
    document.addEventListener("mouseover", function (e) {
      const target = e.target as HTMLElement | null;
      const summary = target?.closest
        ? target.closest(`${SELECTORS.group} > summary`)
        : null;
      if (!summary) return;
      const details = summary.closest<HTMLDetailsElement>(SELECTORS.group);
      const href = details && details.dataset.href;
      if (!href || prefetched.has(href)) return;
      prefetched.add(href);
      try {
        prefetch(href);
      } catch {
        // Best-effort: ignore (e.g. already cached or unsupported).
      }
    });

    // ========================================
    // MOBILE DRAWER FUNCTIONALITY
    // ========================================
    // The sidebar/backdrop are part of the persisted shell, but they get
    // dropped and rebuilt when navigating through a page without a sidebar (the
    // splash homepage). So the drawer resolves these elements fresh on every
    // call instead of capturing them once, and the per-sidebar listeners are
    // (re)attached whenever a new sidebar appears.
    const getSidebar = () => document.getElementById("starlight__sidebar");
    const getBackdrop = () => document.getElementById("sidebar-backdrop");
    const getToggle = () =>
      document.querySelector<HTMLElement>("starlight-menu-button");

    let isOpen = false;
    let touchStartY = 0;
    let touchStartX = 0;
    let currentTranslateY = 0;
    let isDragging = false;
    let canDrag = false;

    function openDrawer() {
      const sidebar = getSidebar();
      const backdrop = getBackdrop();
      if (!sidebar || !backdrop) return;
      isOpen = true;
      sidebar.classList.remove("translate-y-[calc(-100%-3rem)]");
      sidebar.classList.add("translate-y-0");
      backdrop.classList.remove("invisible", "opacity-0");
      backdrop.classList.add("visible", "opacity-100");
      document.body.style.overflow = "hidden";
      getToggle()?.setAttribute("aria-expanded", "true");
    }

    function closeDrawer() {
      const sidebar = getSidebar();
      const backdrop = getBackdrop();
      isOpen = false;
      if (sidebar) {
        sidebar.classList.add("translate-y-[calc(-100%-3rem)]");
        sidebar.classList.remove("translate-y-0");
        sidebar.style.transform = "";
      }
      if (backdrop) {
        backdrop.classList.add("invisible", "opacity-0");
        backdrop.classList.remove("visible", "opacity-100");
      }
      document.body.style.overflow = "";
      getToggle()?.setAttribute("aria-expanded", "false");
    }

    function toggleDrawer() {
      if (isOpen) closeDrawer();
      else openDrawer();
    }

    // Touch event handlers for swipe gestures
    function handleTouchStart(e: TouchEvent) {
      if (window.innerWidth >= 768 || !isOpen) return;
      const sidebar = getSidebar();
      touchStartY = e.touches[0].clientY;
      touchStartX = e.touches[0].clientX;
      currentTranslateY = 0;
      isDragging = false;
      // Only allow drag-to-close when the sidebar is scrolled to the top.
      canDrag = sidebar ? sidebar.scrollTop === 0 : false;
    }

    function handleTouchMove(e: TouchEvent) {
      if (window.innerWidth >= 768 || !isOpen || !canDrag) return;
      const sidebar = getSidebar();
      const backdrop = getBackdrop();
      if (!sidebar || !backdrop) return;

      const diffY = e.touches[0].clientY - touchStartY;
      const diffX = Math.abs(e.touches[0].clientX - touchStartX);

      // Only drag up (to close), and only when mostly vertical.
      if (Math.abs(diffY) > 10 && Math.abs(diffY) > diffX && diffY < 0) {
        isDragging = true;
        currentTranslateY = diffY;
        sidebar.style.transition = "none";
        sidebar.style.transform = `translateY(${diffY}px)`;
        backdrop.style.opacity = Math.max(
          0,
          1 - Math.abs(diffY) / 300,
        ).toString();
      }
    }

    function handleTouchEnd() {
      if (window.innerWidth >= 768) return;
      const sidebar = getSidebar();
      const backdrop = getBackdrop();
      if (!isOpen || !isDragging) {
        if (sidebar) sidebar.style.transition = "";
        isDragging = false;
        canDrag = false;
        return;
      }

      if (sidebar) sidebar.style.transition = "";
      if (backdrop) backdrop.style.opacity = "";

      if (Math.abs(currentTranslateY) > 100) {
        closeDrawer();
      } else if (sidebar) {
        sidebar.style.transform = "";
      }

      isDragging = false;
      canDrag = false;
      currentTranslateY = 0;
    }

    // (Re)attach the listeners that live on the sidebar/backdrop/menu-button.
    // Guarded per element so a persisted sidebar isn't wired twice.
    function wireDrawer() {
      const sidebar = getSidebar();
      if (sidebar && sidebar.dataset.drawerWired !== "true") {
        sidebar.dataset.drawerWired = "true";
        sidebar.addEventListener("touchstart", handleTouchStart, {
          passive: true,
        });
        sidebar.addEventListener("touchmove", handleTouchMove, {
          passive: true,
        });
        sidebar.addEventListener("touchend", handleTouchEnd, { passive: true });
        sidebar.addEventListener("click", function (e) {
          const target = e.target as HTMLElement | null;
          const link = target?.closest("a");
          if (link && window.innerWidth < 768) setTimeout(closeDrawer, 150);
        });
      }

      const backdrop = getBackdrop();
      if (backdrop && backdrop.dataset.drawerWired !== "true") {
        backdrop.dataset.drawerWired = "true";
        backdrop.addEventListener("click", closeDrawer);
      }

      const toggle = getToggle();
      if (toggle && toggle.dataset.drawerWired !== "true") {
        toggle.dataset.drawerWired = "true";
        toggle.addEventListener("click", toggleDrawer);
      }
    }

    // Document/window-level listeners — registered exactly once.
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && isOpen) closeDrawer();
    });

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (window.innerWidth >= 768 && isOpen) closeDrawer();
      }, 150);
    });

    // ========================================
    // PER-PAGE ORCHESTRATION
    // ========================================
    // Runs on the initial load and after every client-side navigation. Each
    // step is idempotent / guarded, so it is safe whether the sidebar was
    // persisted (no-op reveal + already-wired) or freshly rebuilt.
    function onPageLoad() {
      ensureSidebarReady();
      wireDrawer();
      closeDrawer();
      updateActiveState();
    }

    onPageLoad();
    document.addEventListener("astro:page-load", onPageLoad);
  })();
</script>
