---
import Icon from "../shared/Icon.astro";
import { landingStyles as l, ledgerStyles as lg } from "../shared/styles";
import { developersStyles as s } from "./styles";
import type { DevelopersProps } from "./types";

interface Props extends DevelopersProps {}

const { extensions, docsCta } = Astro.props;

const counted = extensions.filter((extension) => extension.entries);
const others = extensions.filter((extension) => !extension.entries);
const otherNames = new Intl.ListFormat("en", { type: "conjunction" }).format(
	others.map((extension) => extension.name),
);

// The same frame has to sit in the page on a desktop and inside the phone
// disclosure, and a slot renders once, so render it to HTML and place it twice.
const codeHtml = await Astro.slots.render("default");
---

<div class={s.grid}>
  <div class={s.column}>
    <div class={s.excerpt}><slot name="excerpt" /></div>
    <details class={s.disclosure}>
      <summary class={s.summary}>
        <span class={s.caret} aria-hidden="true"></span>
        <span class={s.summaryClosed}>Show the whole class</span>
        <span class={s.summaryOpen}>Hide the whole class</span>
      </summary>
      <div class={s.body}><Fragment set:html={codeHtml} /></div>
    </details>
    <div class={s.code}><Fragment set:html={codeHtml} /></div>
  </div>
  <div class={s.copy}>
    <div class:list={[l.body, s.text]}><slot name="text" /></div>
    <div class={s.list}>
      <p class={s.listLabel} id="extensions-label">Ships with</p>
      <dl class={s.rows} aria-labelledby="extensions-label">
        {
          counted.map((extension) => (
            <div class={lg.row}>
              <dt class={lg.key}>{extension.name}</dt>
              <span class={lg.leader} aria-hidden="true" />
              <dd class={lg.value}>{extension.entries} entries</dd>
            </div>
          ))
        }
      </dl>
      {others.length > 0 && <p class={s.more}>Plus integrations for {otherNames}.</p>}
    </div>
    <a class:list={[l.textLink, s.link]} href={docsCta.href}>
      {docsCta.label}
      <Icon name="arrow" class="size-4" />
    </a>
  </div>
</div>
