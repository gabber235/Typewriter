---
import { getSiteVariables } from "@components/variables/site-variables";
import { startStyles as s } from "./styles";
import type { Requirement } from "./types";

// Same source as `:var[]`, so a version bump in variables.yml updates both.
const vars = getSiteVariables();

const requirements: Requirement[] = [
	{
		label: "Server",
		value: `Paper ${vars.paper}`,
		note: "Folia is not supported.",
	},
	{ label: "Runtime", value: `Java ${vars.java}` },
	{
		label: "Dependency",
		value: "PacketEvents",
		note: "Installed as a separate plugin.",
		href: vars.packetevents,
	},
	{
		label: "Client",
		value: "Nothing",
		note: "Vanilla players see everything.",
	},
	{ label: "Price", value: "Free to use" },
	{
		label: "Source",
		value: "On GitHub",
		note: "Typewriter Software License: use it and contribute, but no redistribution or forks outside the project.",
		href: `${vars.github}/blob/develop/LICENSE`,
	},
];
---

<dl class={s.rows}>
  {
    requirements.map((requirement) => (
      <div class={s.item}>
        <dt class={s.key}>{requirement.label}</dt>
        <span class={s.leader} aria-hidden="true" />
        <dd class={s.value}>
          {requirement.href ? (
            <a class={s.link} href={requirement.href}>
              {requirement.value}
            </a>
          ) : (
            requirement.value
          )}
        </dd>
        {requirement.note && <dd class={s.note}>{requirement.note}</dd>}
      </div>
    ))
  }
</dl>
