---
import { getSiteVariables } from "@components/variables/site-variables";
import { startStyles as s } from "./styles";
import type { Requirement } from "./types";

// Same source as `:var[]`, so a version bump in variables.yml updates both.
const vars = getSiteVariables();

const requirements: Requirement[] = [
	{ label: "Server", value: `Paper ${vars.paper}` },
	{ label: "Runtime", value: `Java ${vars.java}` },
	{ label: "Dependency", value: "PacketEvents", href: vars.packetevents },
	{ label: "Players install", value: "Nothing" },
	{ label: "Panel", value: "Hosted" },
	{ label: "Price", value: "Free" },
];
---

<dl class={s.spec}>
  {
    requirements.map((requirement) => (
      <div class={s.specItem}>
        <dt class={s.specLabel}>{requirement.label}</dt>
        <dd class={s.specValue}>
          {requirement.href ? (
            <a class={s.specLink} href={requirement.href}>
              {requirement.value}
            </a>
          ) : (
            requirement.value
          )}
        </dd>
      </div>
    ))
  }
</dl>
