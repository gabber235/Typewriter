---
import { getSiteVariables } from "@components/variables/site-variables";
import Requirements from "./Requirements.astro";
import { startStyles as s } from "./styles";

const vars = getSiteVariables();
---

<Requirements />
<div class={s.below}>
  <div>
    <p class={s.label} id="start-questions">Questions</p>
    <div
      class={s.questions}
      role="group"
      aria-labelledby="start-questions"
      data-questions>
      <slot />
    </div>
  </div>
  <div class={s.help}>
    <p class={s.label}>Anything else</p>
    <p class={s.helpText}>
      Questions get answered on the <a href={vars.discord}>Discord</a>; bugs
      and feature requests go to <a href={vars.issues}>GitHub issues</a>.
    </p>
  </div>
</div>
