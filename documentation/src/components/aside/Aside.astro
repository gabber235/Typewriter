---
import {
	type AsideVariant,
	asideClasses,
	defaultTitles,
	icons,
	variantStyles,
} from "./aside-config";

interface Props {
	type?: AsideVariant;
	title?: string;
}

const { type = "info", title } = Astro.props;

const styles = variantStyles[type];
const displayTitle = title ?? defaultTitles[type];
---

{/* role="note": a callout inside the prose, not a page-level complementary
    landmark (which every unlabeled <aside> would otherwise register as). */}
<aside
  role="note"
  aria-label={displayTitle}
  class:list={[asideClasses.container, styles.border, styles.bg]}>
  <div class={asideClasses.header}>
    <span
      class:list={[asideClasses.icon, styles.text]}
      aria-hidden="true"
      set:html={icons[type]}
    />
    {
      displayTitle && (
        <p class:list={[asideClasses.title, styles.text]}>{displayTitle}</p>
      )
    }
  </div>
  <div class={asideClasses.content}>
    <slot />
  </div>
</aside>
