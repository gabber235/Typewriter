---
import { tabStyles as s } from "./styles";
import type { TabsProps } from "./types";

interface Props extends TabsProps {}

const { defaultTab = 0, syncKey } = Astro.props;

const id = crypto.randomUUID();
---

<div
  class={s.container}
  data-tabs
  data-tabs-id={id}
  data-default-tab={defaultTab}
  data-sync-key={syncKey ?? undefined}>
  <div class:list={["relative", s.bar]} role="tablist">
    <div class={s.pill} data-tab-pill aria-hidden="true"></div>
  </div>

  <div class={s.panels} data-tab-panels>
    <slot />
  </div>
</div>

<script>
  import { setupTabs } from "./tabs";

  // `astro:after-swap` runs after the new DOM is in place but before it is
  // painted, so tabs reached via the view-transitions router are built with no
  // visible flash. `astro:page-load` covers the initial load. The idempotency
  // guard in initTabs keeps the double-fire from rebuilding anything.
  document.addEventListener("astro:after-swap", setupTabs);
  document.addEventListener("astro:page-load", setupTabs);
</script>
