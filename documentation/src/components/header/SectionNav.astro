---
import { SECTIONS, sectionForRoute } from "../../sections";

const current = sectionForRoute(Astro.locals.starlightRoute.id);
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<nav class="flex items-center gap-1" aria-label="Documentation sections" data-section-nav>
  {
    SECTIONS.map((section) => (
      <a
        href={`${base}/${section.id}/`}
        data-astro-prefetch="hover"
        data-section={section.id}
        aria-current={section.id === current.id ? "true" : undefined}
        class="px-3 py-1.5 text-sm rounded-md no-underline whitespace-nowrap text-(--sl-color-text) transition-colors duration-200 hover:bg-(--surface-container) aria-[current=true]:text-(--color-primary) aria-[current=true]:font-medium">
        {section.label}
      </a>
    ))
  }
</nav>

<script>
  import { SECTIONS } from "../../sections";

  // The header is transition:persist'ed, so the server-rendered active state
  // goes stale on client-side navigation — recompute it from the URL.
  function updateActiveSection() {
    const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
    const path = location.pathname.slice(base.length);
    const head = path.split("/").filter(Boolean)[0];
    const active = SECTIONS.find((section) => section.id === head)?.id;
    const links = document.querySelectorAll("[data-section-nav] a");
    for (const link of links) {
      if (link.getAttribute("data-section") === active) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  document.addEventListener("astro:page-load", updateActiveSection);
</script>
