---
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="flex flex-col min-h-screen bg-(--surface)">
  <header
    transition:persist="header"
    class="fixed top-0 left-0 right-0 z-50 h-14 px-4 p-2 bg-(--surface) overflow-hidden">
    <slot name="header" />
  </header>
  {
    hasSidebar && (
      <nav
        transition:persist="sidebar"
        class="print:hidden"
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
        {/* Backdrop overlay for mobile drawer */}
        <div
          id="sidebar-backdrop"
          class="fixed top-14 left-0 right-0 bottom-0 bg-black/50 z-10 opacity-0 invisible transition-opacity duration-200 md:hidden"
          aria-hidden="true"
        />
        <div
          id="starlight__sidebar"
          class="fixed top-14 left-0 right-0 bottom-auto z-60 overflow-y-auto bg-(--surface) max-h-[calc(85vh-3rem)] rounded-b-2xl translate-y-[calc(-100%-3rem)] md:top-14 md:bottom-0 md:left-0 md:right-auto md:w-xs md:max-h-none md:h-auto md:translate-y-0 md:translate-x-0 md:rounded-none transition-transform duration-300 md:visible md:z-30">
          <div class="flex flex-col h-full min-h-max gap-4 pt-1 px-1 pb-1 md:pb-4">
            <slot name="sidebar" />
          </div>
          <div class="flex justify-center py-2 md:hidden sticky bottom-0 bg-(--surface)">
            <div class="w-12 h-1 bg-gray-400 dark:bg-gray-600 rounded-full" />
          </div>
        </div>
      </nav>
    )
  }
  <div
    class="content-pane fixed top-14 right-0 bottom-0 left-0 md:left-80 md:rounded-tl-2xl z-40 bg-(--surface-container-lowest) overflow-y-auto">
    <slot />
  </div>
</div>

<script>
  // The content pane (not the window) is the scroll container, so Astro's
  // built-in scroll restoration doesn't cover it. Save its scroll position per
  // path and restore it on history traversal (Back/Forward) only — fresh link
  // clicks should still land at the top of the new page.
  //
  // We track the displayed path in `currentPath` rather than reading
  // `location.pathname` while leaving: on a Back/Forward navigation the URL has
  // already changed to the destination by the time `astro:before-preparation`
  // fires, so it can't tell us which page we're leaving.
  const scrollPositions = new Map<string, number>();
  let currentPath = location.pathname;
  let restoreOnSwap = false;

  const getPane = () => document.querySelector<HTMLElement>(".content-pane");

  document.addEventListener("astro:before-preparation", (event) => {
    const pane = getPane();
    if (pane) scrollPositions.set(currentPath, pane.scrollTop);
    const navType = (event as unknown as { navigationType?: string })
      .navigationType;
    restoreOnSwap = navType === "traverse";
  });

  document.addEventListener("astro:after-swap", () => {
    const pane = getPane();
    if (pane && restoreOnSwap) {
      const y = scrollPositions.get(location.pathname);
      if (y != null) pane.scrollTop = y;
    }
    restoreOnSwap = false;
    currentPath = location.pathname;
  });
</script>
