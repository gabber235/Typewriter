---
import ProgressRing from "./ProgressRing.astro";
import { tocStyles } from "./styles";
import TocList from "./TocList.astro";

const { toc } = Astro.locals.starlightRoute;
---

{
  toc && (
    <page-toc class={tocStyles.root}>
      <nav aria-labelledby="starlight__on-this-page" class={tocStyles.nav}>
        <div class={tocStyles.header}>
          <h2 id="starlight__on-this-page" class={tocStyles.title}>
            {Astro.locals.t("tableOfContents.onThisPage")}
          </h2>
          <ProgressRing class={tocStyles.ring} size="inline" />
        </div>
        <div data-toc-scroll class={tocStyles.scroller}>
          <div data-toc-rail class={tocStyles.rail}>
            <svg
              data-toc-line
              class={tocStyles.line}
              width="0"
              height="0"
              aria-hidden="true"
              focusable="false">
              <path data-toc-track class={tocStyles.track} />
              <path data-toc-thumb class={tocStyles.thumb} />
            </svg>
            <TocList toc={toc.items} variant="rail" />
          </div>
        </div>
      </nav>
    </page-toc>
  )
}

<style>
  /* Fades the clipped edge of a long list; the attributes are set only while
     there is more to scroll in that direction. */
  .toc-scroller {
    --fade-top: 0px;
    --fade-bottom: 0px;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 var(--fade-top),
      #000 calc(100% - var(--fade-bottom)),
      transparent
    );
  }

  .toc-scroller[data-fade-top] {
    --fade-top: 1.5rem;
  }

  .toc-scroller[data-fade-bottom] {
    --fade-bottom: 1.5rem;
  }
</style>

<script src="./toc-elements.ts"></script>
