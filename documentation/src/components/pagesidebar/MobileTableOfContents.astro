---
import ProgressRing from "./ProgressRing.astro";
import { sheetStyles } from "./styles";
import TocList from "./TocList.astro";

const { toc } = Astro.locals.starlightRoute;
const onThisPage = Astro.locals.t("tableOfContents.onThisPage");
const firstItem = toc?.items[0]?.text ?? "";
---

{
  toc && (
    <page-toc-sheet class={sheetStyles.root}>
      <div class={sheetStyles.dock}>
        {/* The accessible name is "On this page: <section>", which contains
            the visible label as 2.5.3 requires. */}
        <button
          type="button"
          data-toc-pill
          class={sheetStyles.pill}
          aria-haspopup="dialog"
          aria-controls="page-toc-dialog"
          aria-expanded="false">
          <ProgressRing class={sheetStyles.ring} />
          <span class="sr-only">{onThisPage}:</span>
          <span data-toc-label class={sheetStyles.label}>{firstItem}</span>
          <svg
            class={sheetStyles.icon}
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false">
            <path
              fill-rule="evenodd"
              d="M9.47 6.47a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 1 1-1.06 1.06L10 8.06l-3.72 3.72a.75.75 0 0 1-1.06-1.06l4.25-4.25Z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
      <dialog
        id="page-toc-dialog"
        aria-labelledby="starlight__on-this-page--mobile"
        class={sheetStyles.dialog}>
        <div class={sheetStyles.header}>
          <h2 id="starlight__on-this-page--mobile" class={sheetStyles.title}>
            {onThisPage}
          </h2>
          <ProgressRing class={sheetStyles.headerRing} size="inline" />
          <button type="button" data-toc-close class={sheetStyles.close} aria-label="Close">
            <svg
              class={sheetStyles.closeIcon}
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              focusable="false">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
            </svg>
          </button>
        </div>
        <nav aria-labelledby="starlight__on-this-page--mobile" class={sheetStyles.body}>
          <TocList toc={toc.items} variant="sheet" />
        </nav>
      </dialog>
    </page-toc-sheet>
  )
}

<script src="./toc-elements.ts"></script>
