# Terraform state files
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Ignore local variable files with sensitive data
# Keep the template files but ignore actual values
*.auto.tfvars
*.auto.tfvars.json

# Task runner cache
.task/