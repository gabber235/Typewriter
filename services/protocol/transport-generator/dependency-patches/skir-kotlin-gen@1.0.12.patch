+export interface LanguageBindings {
+  readonly language: "kotlin";
+  readonly methods: ReadonlyArray<MethodNames>;
+  readonly records: ReadonlyArray<RecordNames>;
+}
+
+export interface BindingInput {
+  readonly modules: readonly object[];
+  readonly recordMap: ReadonlyMap<string, object>;
+  readonly config: { readonly packagePrefix?: string };
+}
+
+export function exportBindings(
+  publicInput: BindingInput,
+): LanguageBindings {
+  const input = publicInput as CodeGenerator.Input<Config>;
+  const namer = new Namer(input.config.packagePrefix ?? "");
+  const typeSpeller = new TypeSpeller(input.recordMap, namer);
+  return {
+    language: "kotlin",
+    methods: input.modules.flatMap((module) =>
+      module.methods.map((method) => ({
+        module: module.path,
+        name: method.name.text,
+        method: {
+          language: "kotlin" as const,
+          packageName: namer.modulePackage(module.path),
+          symbol: method.name.text,
+        },
+        requestType: typeSpeller.getKotlinType(method.requestType!, "frozen"),
+        responseType: typeSpeller.getKotlinType(method.responseType!, "frozen"),
+      }))),
+    records: [...input.recordMap.values()].map((location) => ({
+      key: location.record.key,
+      type: namer.getClassName(location).qualifiedName,
+      fields:
+        location.record.recordType === "struct"
+          ? location.record.fields.map((field) => ({
+              sourceName: field.name.text,
+              targetName: namer.structFieldToKotlinName(field),
+            }))
+          : [],
+    })),
+  };
+}
