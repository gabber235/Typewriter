+import { convertCase, } from "skir-internal";
 export class Namer {
     skirModule;
     constructor(skirModule) {
@@ -33,6 +34,10 @@ export function getTypeName(record) {
         .map((r) => maybeEscapeUpperCasedName(r.name.text))
         .join("_");
 }
+export function getMethodName(method) {
+    const skirName = typeof method === "string" ? method : method.name.text;
+    return convertCase(skirName, "lower_underscore").concat("_method");
+}
 export function toStructFieldName(input) {
     return RESERVED_KEYWORDS.has(input) || GENERARATED_STRUCT_METHODS.has(input)
