PLAN.md
/panel/doc
plans/
/docs/*
backend/.artifact_keeper_password
AGENTS.local.md

# devenv shell state; devenv.lock is committed
.devenv*
devenv.local.nix

# cargo xtask build output and step logs
/xtask/target/
/.xtask/

# Written by devenv's git-hooks module on shell entry; links into the Nix store per machine.
.pre-commit-config.yaml

# Generated by `cargo xtask generate`, never committed. `.ignore` re-includes them for search.
panel/**/*.g.dart
panel/**/*.freezed.dart
panel/**/*.gr.dart
panel/lib/infrastructure/protocols/skir/skirout/
panel/lib/infrastructure/protocols/operations/skirout/
panel/lib/infrastructure/messaging/generated/skirout/
backend/wasmcloud-utils/src/skirout/
backend/wasmcloud-utils/src/transport_routes/skirout/
services/protocol/src/main/kotlin/skirout/
services/protocol/transport-adapters/kotlin/skirout/
